# Emilius Agency — настройки Apache для Бегета.
# На GitHub Pages этот файл не действует, он нужен только в продакшене.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Редиректы: emilius.agency и www — на https://emilius.agency без www ---
# Только для своего домена: на техническом адресе Бегета сайт проверяют до переключения DNS,
# и редирект увёл бы оттуда на emilius.agency (пока там ещё Tilda).
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.emilius\.agency$ [NC]
  RewriteRule ^ https://emilius.agency%{REQUEST_URI} [L,R=301]

  # Бегет принимает https на своём прокси: HTTPS может быть off при X-Forwarded-Proto: https
  RewriteCond %{HTTP_HOST} ^emilius\.agency$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://emilius.agency%{REQUEST_URI} [L,R=301]

  # --- Старые адреса Tilda (до 10.2026): страницы вида /page36898459.html — на главную ---
  RewriteRule ^page[0-9]+\.html$ / [L,R=301]
  # Поисковики знают карту сайта Tilda по адресу /sitemap.xml
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
</IfModule>

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Кеш ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # Файлы из _astro/ содержат хеш в имени и никогда не меняются
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Технический адрес Бегета не индексируется — в поиске только emilius.agency
  <If "tolower(%{HTTP_HOST}) != 'emilius.agency'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
