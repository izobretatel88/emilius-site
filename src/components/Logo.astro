---
// Логотип: «Эмилиус [знак] Эдженси» в светлой таблетке.
// Знак — молния из PNG владельца (public/brand/logo.png, готовится scripts/logo-from-png.py).
// Не перерисовывать: владелец просил использовать именно его картинку.
const base = import.meta.env.BASE_URL;
const logo = `${base}${base.endsWith('/') ? '' : '/'}brand/logo.png`;
---

<div class="pill">
  <span>Эмилиус</span>
  <img class="mark" src={logo} width="267" height="401" alt="" />
  <span>Эдженси</span>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    font-weight: 600;
    font-size: 19px;
  }
  /* Знак вытянут по вертикали (267×401) */
  .mark {
    display: block;
    width: 25px;
    height: 38px;
    flex: none;
  }
  @media (max-width: 480px) {
    .pill {
      font-size: 17px;
      gap: 10px;
      padding: 8px 18px;
    }
    .mark {
      width: 22px;
      height: 33px;
    }
  }
</style>
