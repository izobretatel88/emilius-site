---
// Логотип: «Эмилиус [знак] Эдженси» в светлой таблетке.
// Знак — скруглённый треугольник со спектральной обводкой и сердцем, генерируется в src/lib/mark.mjs.
import { markSvg } from '../lib/mark.mjs';

// Пастельная заливка — только в светлой теме, на тёмной она превращается в светлое пятно.
const mark = markSvg({ fill: true, idPrefix: 'logo' });
---

<div class="pill">
  <span>Эмилиус</span>
  <span class="mark" aria-hidden="true" set:html={mark} />
  <span>Эдженси</span>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    font-weight: 600;
    font-size: 19px;
  }
  .mark {
    display: block;
    width: 34px;
    height: 33px;
    flex: none;
  }
  .mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .mark :global(.mark-fill) {
      display: none;
    }
  }
  :global(:root[data-theme='dark']) .mark :global(.mark-fill) {
    display: none;
  }
  @media (max-width: 480px) {
    .pill {
      font-size: 17px;
      gap: 10px;
      padding: 8px 18px;
    }
    .mark {
      width: 30px;
      height: 29px;
    }
  }
</style>
