---
// Логотип: «Эмилиус [знак] Эдженси» в светлой таблетке.
// Знак — молния (src/lib/bolt.mjs, исходники в design/logo-bolt/). До 21.10.2026 был треугольник с сердцем (src/lib/mark.mjs).
import { boltSvg } from '../lib/bolt.mjs';

// В таблетке знак ~35 px — версия с толстой линией, тонкая на этом размере бледнеет
const mark = boltSvg({ small: true, idPrefix: 'logo' });
---

<div class="pill">
  <span>Эмилиус</span>
  <span class="mark" aria-hidden="true" set:html={mark} />
  <span>Эдженси</span>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    font-weight: 600;
    font-size: 19px;
  }
  /* Знак вытянут по вертикали (215×326) */
  .mark {
    display: block;
    width: 25px;
    height: 38px;
    flex: none;
  }
  .mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 480px) {
    .pill {
      font-size: 17px;
      gap: 10px;
      padding: 8px 18px;
    }
    .mark {
      width: 22px;
      height: 33px;
    }
  }
</style>
