---
// Знак: два открытых треугольника, соединённые зигзагом, обводка со спектральным градиентом.
---

<div class="pill">
  <span>Эмилиус</span>
  <svg viewBox="0 0 55 84" aria-hidden="true">
    <defs>
      <linearGradient id="markGrad" x1="48" y1="2" x2="18" y2="84" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#309ce4"></stop>
        <stop offset=".18" stop-color="#30c0b4"></stop>
        <stop offset=".34" stop-color="#30d860"></stop>
        <stop offset=".5" stop-color="#b4e43c"></stop>
        <stop offset=".64" stop-color="#e4d830"></stop>
        <stop offset=".78" stop-color="#e44854"></stop>
        <stop offset="1" stop-color="#b47860"></stop>
      </linearGradient>
    </defs>
    <path d="M4 32 L51 32 L37 4 L19 52 L46 52 L22 81 Z" fill="none" stroke="url(#markGrad)" stroke-width="4.5"></path>
  </svg>
  <span>Эдженси</span>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    font-weight: 600;
    font-size: 19px;
  }
  .pill svg {
    width: 24px;
    height: 37px;
    display: block;
  }
  @media (max-width: 480px) {
    .pill {
      font-size: 17px;
      gap: 10px;
      padding: 8px 18px;
    }
  }
</style>
