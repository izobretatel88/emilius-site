---
// Раскладка юридических страниц: логотип, карточка с текстом документа, футер.
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Footer from './Footer.astro';
import { LEGAL_DATE } from '../data/legal';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
}
const { title, description, eyebrow } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${title} — Эмилиус Эдженси`} description={description}>
  <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <main class="card doc">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="date">Редакция от {LEGAL_DATE}</p>
    <slot />
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .doc {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    padding: 32px clamp(18px, 4vw, 40px) 36px;
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.15;
  }
  .date {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .doc :global(h2) {
    margin-top: 28px;
    font-size: 20px;
    line-height: 1.25;
  }
  .doc :global(p),
  .doc :global(ul) {
    margin-top: 10px;
    color: var(--ink);
  }
  .doc :global(ul) {
    padding-left: 20px;
  }
  .doc :global(li + li) {
    margin-top: 6px;
  }
  .doc :global(.note) {
    color: var(--ink-2);
  }
</style>
