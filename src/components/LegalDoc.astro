---
// Раскладка юридических страниц: логотип, карточка с текстом документа, футер.
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Footer from './Footer.astro';
import { LEGAL_DATE } from '../data/legal';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  date?: string; // своя дата редакции (документы приложения Emilius Meetings)
}
const { title, description, eyebrow, date = LEGAL_DATE } = Astro.props;
const base = import.meta.env.BASE_URL;
// Оглавление из заголовков разделов: у длинных документов (от 4 разделов) — ссылки на каждый раздел.
let html = await Astro.slots.render('default');
const toc: { id: string; text: string }[] = [];
html = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
  const id = `s-${toc.length + 1}`;
  toc.push({ id, text: inner.replace(/<[^>]+>/g, '').trim() });
  return /\sid=/.test(attrs) ? `<h2${attrs}>${inner}</h2>` : `<h2 id="${id}"${attrs}>${inner}</h2>`;
});
const showToc = toc.length >= 4;
---

<Base title={`${title} — Эмилиус Эдженси`} description={description}>
  {Astro.url.pathname.includes('/meetings/') && <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>}

  <slot name="nav" />

  <main class="card doc">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="date">Редакция от {date}</p>
    {showToc && (
      <nav class="toc" aria-label="Содержание">
        <p class="toc-title">Содержание</p>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
      </nav>
    )}
    <Fragment set:html={html} />
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .doc {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    padding: 32px clamp(18px, 4vw, 40px) 36px;
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.15;
  }
  .date {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .doc :global(h2) {
    margin-top: 32px;
    font-size: 20px;
    line-height: 1.25;
    scroll-margin-top: 24px;
  }
  /* Документ читают, а не пролистывают: текст крупнее и свободнее, строка не шире ~70 знаков */
  .doc :global(p),
  .doc :global(ul) {
    margin-top: 10px;
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    max-width: 68ch;
  }
  .toc {
    margin-top: 20px;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: var(--well);
  }
  .toc-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .toc ol {
    margin: 0;
    padding-left: 22px;
    columns: 2;
    column-gap: 28px;
    font-size: 15px;
    line-height: 1.5;
  }
  .toc li {
    break-inside: avoid;
    margin: 0 0 4px;
  }
  .toc a {
    color: var(--teal-text);
    text-decoration: none;
  }
  .toc a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 560px) {
    .toc ol {
      columns: 1;
    }
  }
  .doc :global(ul) {
    padding-left: 20px;
  }
  .doc :global(li + li) {
    margin-top: 6px;
  }
  .doc :global(.note) {
    color: var(--ink-2);
  }
</style>
