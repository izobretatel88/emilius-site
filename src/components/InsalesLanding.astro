---
// Лендинг услуги «Магазин на шаблоне InSales». Две версии первого экрана: общая и для селлеров.
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Footer from './Footer.astro';
import { LINKS } from '../data/site';
import {
  HERO, CTA_NOTE, EXTRAS, SITUATIONS, RESULT, PLANS, PLATFORM_NOTE, NOT_INCLUDED,
  ACCEPTANCE, WEEKS, CHOICE, FAQ, TEMPLATE_SHOPS, MORE_SHOPS, INTEGRATIONS, PROOF_LINKS, VIDEO_REVIEW, FRESH_SHOP } from '../data/insales';
import { QUICK_QUESTIONS } from '../../docs/insales-service/calc/quick.js';
import { parseCatalog } from '../../docs/insales-service/calc/estimate.js';
import catalogCsv from '../../docs/insales-service/03-catalog.csv?raw';

interface Props {
  variant: 'shop' | 'seller';
}
const { variant } = Astro.props;
const hero = HERO[variant];
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const action = href('api/lead.php');
const consent = href('consent/');
const privacy = href('privacy/');
const other = variant === 'shop'
  ? { url: href('services/insales-shop/seller/'), text: 'Продаёте на WB или Ozon? Версия для селлеров →' }
  : { url: href('services/insales-shop/'), text: 'Общая версия: соцсети, офлайн, переезд со старого сайта →' };
// Селлеру первым показываем его пакет.
const plans = variant === 'seller' ? [PLANS[2], PLANS[1], PLANS[0]] : PLANS;
// Для расчёта в браузере хватает норм и ролей — тексты каталога не тащим на страницу.
const norms = JSON.stringify([...parseCatalog(catalogCsv).values()].map((c) => [c.id, c.base, c.per, c.role, c.packages]));
// Селлеру сразу отмечены площадки, в общей версии — самый частый клиент: соцсети, товары с нуля.
const preset: Record<string, string> = variant === 'seller' ? { channel: 'mp', where: 'mp' } : { channel: 'social' };
const questions = Object.entries(QUICK_QUESTIONS).map(([name, [label, opts]]) => ({
  name, label, opts: opts as [string, string][], checked: preset[name] ?? (opts as [string, string][])[0][0],
}));
---

<Base title={`${hero.title.split('.')[0]} — Эмилиус Эдженси`} description={hero.lead}>
  <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <main class="page">
    <section class="card hero">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <ul class="ticks">{hero.bullets.map((b) => <li>{b}</li>)}</ul>
      <div class="cta-row">
        <a class="cta" href="#lead" data-goal="calc-click">{hero.cta}</a>
        <p class="note">{CTA_NOTE}</p>
      </div>
      <a class="switch" href={other.url}>{other.text}</a>
    </section>

    <section class="card block" aria-labelledby="t-extras">
      <h2 id="t-extras">Что обычно не пишут в предложениях — у нас входит в цену</h2>
      <div class="grid2">
        {EXTRAS.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </section>

    {variant === 'shop' && (
      <section class="card block" aria-labelledby="t-sit">
        <h2 id="t-sit">Узнаёте себя?</h2>
        <div class="grid2">
          {SITUATIONS.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
      </section>
    )}

    <section class="card block" aria-labelledby="t-result">
      <h2 id="t-result">Что получите</h2>
      <ul class="dots">{RESULT.map((r) => <li>{r}</li>)}</ul>
    </section>

    <!-- Примеры: сначала магазины на шаблоне — ровно про эту услугу, затем остальные работы на InSales -->
    <section class="card block" aria-labelledby="t-examples">
      <h2 id="t-examples">Магазины, которые мы сделали</h2>
      <a class="shop fresh" href={FRESH_SHOP.url} target="_blank" rel="noopener">
        <img src={`${base}${base.endsWith('/') ? '' : '/'}cases/${FRESH_SHOP.id}.webp`} alt={`Первый экран сайта ${FRESH_SHOP.domain}`} width="640" height="400" loading="lazy" decoding="async" />
        <span class="shop-body">
          <span class="fresh-tag">Свежая работа</span>
          <span class="shop-name">{FRESH_SHOP.name}</span>
          <span class="shop-what">{FRESH_SHOP.what}</span>
          <span class="shop-link">{FRESH_SHOP.domain} ↗</span>
        </span>
      </a>
      <p class="sub-lead">На шаблоне InSales — как в этой услуге:</p>
      <ul class="shops">
        {TEMPLATE_SHOPS.map((x) => (
          <li>
            <a class="shop" href={x.url} target="_blank" rel="noopener">
              <img src={`${base}${base.endsWith('/') ? '' : '/'}cases/${x.id}.webp`} alt={`Первый экран сайта ${x.domain}`} width="640" height="400" loading="lazy" decoding="async" />
              <span class="shop-body">
                <span class="shop-name">{x.name}</span>
                <span class="shop-what">{x.what}</span>
                <span class="shop-link">{x.domain} ↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sub-lead">Ещё магазины и интеграции на InSales:</p>
      <ul class="more-shops">
        {MORE_SHOPS.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.domain}</a></li>)}
        {INTEGRATIONS.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.domain}</a> — {x.what}</li>)}
      </ul>
      <p class="proof">{PROOF_LINKS.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} target="_blank" rel="noopener">{l.text} ↗</a></>)}</p>
    </section>

    <!-- Видеоотзыв: как клиент нашёл нас и почему выбрал -->
    <section class="card block review" aria-labelledby="t-review">
      <h2 id="t-review">Отзыв клиента</h2>
      <div class="review-grid">
        <video
          controls
          playsinline
          preload="none"
          width="640"
          height="362"
          poster={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.poster}`}
        >
          <source src={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.src}`} type="video/mp4" />
          <track kind="captions" srclang="ru" label="Русский" src={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.captions}`} default />
        </video>
        <figure class="quote">
          <blockquote>«{VIDEO_REVIEW.quote}»</blockquote>
          <figcaption>
            <b>{VIDEO_REVIEW.who}</b>
            <span>{VIDEO_REVIEW.project} · <a href={VIDEO_REVIEW.url} target="_blank" rel="noopener">wizzu.ru ↗</a></span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="block plain" aria-labelledby="t-plans">
      <h2 id="t-plans">Пакеты и цены</h2>
      <div class="plans">
        {plans.map((p, i) => (
          <article class:list={['card', 'plan', { main: i === 0 && variant === 'seller' }]}>
            <h3>{p.name}</h3>
            <p class="who">{p.who}</p>
            <p class="price num">{p.price}</p>
            <p class="term">{p.term} · тариф {p.tariff}</p>
            <ul class="dots">{p.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="small">{PLATFORM_NOTE}</p>
      <p class="small">{NOT_INCLUDED}</p>
    </section>

    <div class="cols">
      <section class="card block" aria-labelledby="t-accept">
        <h2 id="t-accept">Магазин сдан, когда</h2>
        <ol class="nums">{ACCEPTANCE.map((a) => <li>{a}</li>)}</ol>
        <p class="small">Полный протокол — 12 проверок. Отдаём его вместе с магазином.</p>
      </section>
      <section class="card block" aria-labelledby="t-yours">
        <h2 id="t-yours">Всё оформлено на вас</h2>
        <p>Аккаунт InSales, домен, Яндекс Метрика, договор эквайринга — на ваше имя с первого дня. Тема и данные ваши.</p>
        <h2 class="sub">Честно про трафик</h2>
        <p>Сайт — касса и витрина, а не поток покупателей. До оплаты разберём, откуда придут первые 100 покупателей: подписчики, база клиентов, офлайн-точка, реклама. Если источника нет, скажем и предложим, с чего начать.</p>
      </section>
    </div>

    <section class="card block" aria-labelledby="t-weeks">
      <h2 id="t-weeks">Этапы</h2>
      <ol class="weeks">
        {WEEKS.map(([w, what, you]) => (
          <li>
            <span class="wk num">Неделя {w}</span>
            <span class="what">{what}</span>
            {you !== '—' && <span class="you">Вы видите: {you}</span>}
          </li>
        ))}
      </ol>
      <p class="small">Связь — в Telegram-чате проекта: менеджер отвечает в течение часа, с 11 до 19 по Москве.</p>
    </section>

    <section class="card block" aria-labelledby="t-choice">
      <h2 id="t-choice">InSales, Tilda, Яндекс KIT или самому?</h2>
      <dl class="choice">
        {CHOICE.map(([c, a]) => <div><dt>{c}</dt><dd>{a}</dd></div>)}
      </dl>
    </section>

    <section class="card block" aria-labelledby="t-faq">
      <h2 id="t-faq">Частые вопросы</h2>
      <div class="faq">
        {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="card block lead-form" id="lead" aria-labelledby="t-lead">
      <h2 id="t-lead">Посчитаем ваш магазин</h2>
      <p>Ответьте на 7 вопросов — сразу покажем пакет, цену и срок по тем же нормам, по которым считаем смету.</p>
      <form method="post" action={action} novalidate data-norms={norms} data-variant={variant}>
        <input type="hidden" name="message" value={`Заявка на диагностику InSales (${variant})`} />
        {questions.map((q) => (
          <fieldset>
            <legend>{q.label}</legend>
            <div class="chips">
              {q.opts.map(([v, t]) => (
                <label class="chip"><input type="radio" name={q.name} value={v} checked={v === q.checked} /><span>{t}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="estimate" aria-live="polite" hidden>
          <p class="est-pkg">Пакет <b data-out="pkg"></b></p>
          <p class="est-price num" data-out="price"></p>
          <p class="est-meta"><span data-out="weeks"></span> · тариф InSales <span data-out="tariff"></span> — отдельно, платите InSales напрямую</p>
          <p class="small">Ориентир без SEO, фидов для рекламы и доработок кодом. Точную смету «входит / не входит» фиксируем после диагностики, до оплаты.</p>
        </div>
        <label>Имя<input name="name" type="text" maxlength="100" autocomplete="name" /></label>
        <label>Telegram или телефон<input name="contact" type="text" maxlength="200" required autocomplete="tel" /></label>
        <div class="trap" aria-hidden="true"><input name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        <!-- Согласие по 152-ФЗ отдельной галочкой: без него lead.php заявку не примет -->
        <label class="agree">
          <input type="checkbox" name="consent" value="1" required />
          <span>Согласен на <a href={consent} target="_blank">обработку персональных данных</a> по <a href={privacy} target="_blank">политике конфиденциальности</a></span>
        </label>
        <button class="cta" type="submit">Отправить расчёт и записаться на диагностику</button>
        <p class="small">Расчёт придёт менеджеру вместе с заявкой. Ответим в течение часа в рабочее время.</p>
        <p class="status" role="status" aria-live="polite" hidden></p>
        <p class="status" data-fail role="alert" hidden>
          Не получилось отправить. Напишите нам в Telegram: <a href={LINKS.direct} target="_blank" rel="noopener">{LINKS.direct.replace('https://t.me/', '@')}</a>
        </p>
      </form>
    </section>
  </main>

  <Footer />
</Base>

<script>
  import { QUICK_QUESTIONS, quickEstimate } from '../../docs/insales-service/calc/quick.js';

  // Цели Метрики (список — docs/insales-service/07-landing.md §4). Без счётчика emiGoal нет — вызовы ничего не делают.
  const goal = (name: string, params: Record<string, unknown> = {}) => (window as any).emiGoal?.(name, params);
  // Источник визита: UTM из адреса или сайт, с которого пришли; запоминаем на визит, чтобы не потерять при переходе между версиями. Уходит менеджеру в заявке.
  const source = (() => {
    try {
      const q = new URLSearchParams(location.search);
      const utm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].map((k) => q.get(k)).filter(Boolean).join(' / ');
      const now = utm || (document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).host : '');
      if (now) sessionStorage.setItem('emi-source', now);
      return sessionStorage.getItem('emi-source') || 'прямой заход';
    } catch {
      return 'не определён';
    }
  })();

  document.querySelectorAll<HTMLElement>('[data-goal]').forEach((el) => el.addEventListener('click', () => goal(el.dataset.goal!)));
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://t.me/"]').forEach((a) => a.addEventListener('click', () => goal('tg-click')));

  const form = document.querySelector<HTMLFormElement>('#lead form');
  if (form) {
    const variant = form.dataset.variant;
    let touched = false;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const ok = form.querySelector<HTMLElement>('.status:not([data-fail])')!;
    const fail = form.querySelector<HTMLElement>('[data-fail]')!;
    const contact = form.querySelector<HTMLInputElement>('[name=contact]')!;
    const agree = form.querySelector<HTMLInputElement>('[name=consent]')!;
    const box = form.querySelector<HTMLElement>('.estimate')!;
    const out = (k: string) => box.querySelector<HTMLElement>(`[data-out=${k}]`)!;
    const catalog = new Map(
      (JSON.parse(form.dataset.norms!) as [string, number, number, string, string][])
        .map(([id, base, per, role, packages]) => [id, { id, base, per, role, packages }]),
    );
    const rub = (n: number) => n.toLocaleString('ru-RU') + '\u00a0₽';
    const answers = () => Object.fromEntries(Object.keys(QUICK_QUESTIONS).map((k) => [k, String(new FormData(form).get(k) ?? '')]));
    const label = (k: string, v: string) => (QUICK_QUESTIONS as any)[k][1].find(([x]: string[]) => x === v)?.[1] ?? '—';

    let last: ReturnType<typeof quickEstimate> | null = null;
    const update = () => {
      try {
        last = quickEstimate(answers(), catalog);
      } catch {
        box.hidden = true;
        return;
      }
      out('pkg').textContent = `«${last.packageName}»`;
      out('price').textContent = `${rub(last.from)} – ${rub(last.to)}`;
      out('weeks').textContent = `${last.weeks.join('–')} ${last.weeks[1] <= 4 ? 'недели' : 'недель'}`;
      out('tariff').textContent = `«${last.tariff.name}» ${rub(last.tariff.month)}/мес`;
      box.hidden = false;
    };
    form.addEventListener('change', (e) => {
      update();
      // Первое изменение ответа — человек начал считать.
      if (!touched && (e.target as HTMLInputElement).type === 'radio') {
        touched = true;
        goal('quick-start', { variant });
      }
    });
    update();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.hidden = fail.hidden = true;
      if (!contact.value.trim()) {
        ok.textContent = 'Оставьте Telegram или телефон — без него не ответим.';
        ok.hidden = false;
        contact.focus();
        return;
      }
      if (!agree.checked) {
        ok.textContent = 'Отметьте согласие на обработку данных — без него не можем принять заявку.';
        ok.hidden = false;
        agree.focus();
        return;
      }
      // lead.php принимает message + contact: ответы и ориентир собираем в текст сообщения.
      const fd = new FormData(form);
      const a = answers();
      const msg = form.querySelector<HTMLInputElement>('[name=message]')!.value;
      fd.set('message', [
        msg,
        `Имя: ${fd.get('name') || '—'}`,
        ...Object.entries(a).map(([k, v]) => `${(QUICK_QUESTIONS as any)[k][0]}: ${label(k, v)}`),
        last ? `Ориентир на сайте: «${last.packageName}» ${rub(last.from)}–${rub(last.to)}, ${last.weeks.join('–')} нед., ${last.hours} ч, тариф «${last.tariff.name}»` : 'Ориентир не посчитан',
        `Источник: ${source}`,
        `Ответы: ${JSON.stringify(a)}`,
      ].join('\n'));
      button.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) throw new Error(String(res.status));
        ok.textContent = 'Спасибо! Расчёт у менеджера. Напишем в течение часа в рабочее время.';
        ok.hidden = false;
        goal('lead-sent', { variant, package: last?.packageName, from: last?.from, touched });
      } catch {
        fail.hidden = false;
        goal('lead-fail', { variant });
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .top { display: flex; justify-content: center; }
  .logo-link { color: inherit; text-decoration: none; border-radius: var(--radius-card); }
  .page {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 28px; /* воздух между разделами, как на главной (23.10.2026) */
  }
  .hero { padding: clamp(26px, 4.4vw, 48px); display: flex; flex-direction: column; gap: 16px; }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Иерархия: крупный заголовок первого экрана, разделы заметно выше текста — в системе главной */
  h1 { font-size: clamp(32px, 5.6vw, 54px); font-weight: 700; line-height: 1.06; letter-spacing: -0.02em; text-wrap: balance; }
  .lead { font-size: clamp(17px, 1.9vw, 20px); line-height: 1.5; color: var(--ink-2); max-width: 58ch; }
  h2 { font-size: clamp(24px, 3vw, 30px); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; }
  h2.sub { font-size: clamp(20px, 2.4vw, 24px); margin-top: 12px; }
  h3 { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.25; }
  ul, ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .ticks li, .dots li { position: relative; padding-left: 18px; }
  .ticks li::before, .dots li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
  }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 6px; }
  .cta {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 22px;
    border: 0;
    border-radius: var(--radius-btn);
    background: var(--teal-btn);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--hover), opacity var(--hover);
  }
  .cta:hover { color: var(--on-teal); }
  .cta:disabled { opacity: 0.6; cursor: wait; }
  .note, .small { font-size: 14px; color: var(--ink-3); line-height: 1.45; }
  .switch { font-size: 15px; font-weight: 600; text-decoration: none; }
  .switch:hover { text-decoration: underline; text-underline-offset: 3px; }
  .block { padding: clamp(24px, 3.6vw, 38px); display: flex; flex-direction: column; gap: 18px; }
  .block.plain { padding: 8px 0 0; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 24px; }
  .item { display: flex; flex-direction: column; gap: 6px; }
  .item p { color: var(--ink-2); }
  .sub-lead { font-size: 15px; font-weight: 600; color: var(--ink-2); }
  .shops { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; flex-direction: row; }
  .shop {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--well);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--hover);
  }
  .shop img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .shop-body { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .shop-name { font-size: 18px; font-weight: 700; }
  .shop-what { font-size: 14px; color: var(--ink-2); line-height: 1.4; }
  .shop-link { margin-top: 4px; font-size: 14px; font-weight: 600; color: var(--teal-text); }
  .shop:hover .shop-link { text-decoration: underline; text-underline-offset: 3px; }
  .shop:focus-visible { outline: 2px dashed var(--teal); outline-offset: 3px; }
