---
// Лендинг услуги «Магазин на шаблоне InSales». Две версии первого экрана: общая и для селлеров.
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LinkList from './LinkList.astro';
import { getPosts } from '../lib/blog';
import { LINKS } from '../data/site';
import {
  HERO, CTA_NOTE, EXTRAS, SITUATIONS, RESULT, PLANS, PLATFORM_NOTE, NOT_INCLUDED,
  ACCEPTANCE, WEEKS, CHOICE, FAQ, TEMPLATE_SHOPS, MORE_SHOPS, INTEGRATIONS, PROOF_LINKS, VIDEO_REVIEW, FRESH_SHOP, MOBILE_SHOTS,
  SELLER_WHY, SELLER_MOVE, SELLER_MOVE_NOTE, SELLER_QUICK, SELLER_FAQ } from '../data/insales';
import { QUICK_QUESTIONS } from '../../docs/insales-service/calc/quick.js';
import { parseCatalog } from '../../docs/insales-service/calc/estimate.js';
import catalogCsv from '../../docs/insales-service/03-catalog.csv?raw';

interface Props {
  variant: 'shop' | 'seller';
}
const { variant } = Astro.props;
const hasStockArticle = (await getPosts()).some(p=>p.id==='edinye-ostatki-wb-ozon-insales');
const hero = HERO[variant];
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const action = href('api/lead.php');
const consent = href('consent/');
const privacy = href('privacy/');
const other = variant === 'shop'
  ? { url: href('services/insales-shop/seller/'), text: 'Продаёте на WB или Ozon? Версия для селлеров →' }
  : { url: href('services/insales-shop/'), text: 'Общая версия: соцсети, офлайн, переезд со старого сайта →' };
// Селлеру первым показываем его пакет.
const plans = variant === 'seller' ? [PLANS[2], PLANS[1], PLANS[0]] : PLANS;
// Селлеру первыми — его вопросы: кабинеты, замена площадки, остатки.
const faq = variant === 'seller' ? [...SELLER_FAQ, ...FAQ] : FAQ;
// Заголовок не рвётся на «интернет-|магазин» и «3–|5»: word joiner после дефиса и вокруг тире между цифрами.
const nobreak = (t: string) => t.replace(/(\S)-(\S)/g, '$1-\u2060$2').replace(/(\d)–(\d)/g, '$1\u2060–\u2060$2');
// «Посчитать» под пакетом заполняет калькулятор типичными ответами этого пакета — человек сразу видит его цену.
const PLAN_PRESETS: Record<string, Record<string, string>> = {
  Старт: { channel: 'social', sku: '30', where: 'head', variants: 'no', carriers: '1', crm: 'no' },
  Магазин: { channel: 'offline', sku: '150', where: 'excel', variants: 'yes', carriers: '2', crm: 'no' },
  Селлер: { channel: 'mp', sku: '150', where: 'mp', variants: 'yes', carriers: '2', crm: 'no' },
};
// Разделы для навигации по странице: id заголовка → подпись.
const JUMPS = [['t-examples', 'Примеры'], ['t-plans', 'Цены'], ['t-weeks', 'Этапы'], ['t-faq', 'Вопросы']] as const;
// Телефон на первом экране: общей версии — свежий кейс, селлеру — бренд одежды.
const heroShop = MOBILE_SHOTS.find((x) => x.id === (variant === 'seller' ? 'duman' : 'happyanimal'))!;
// Для расчёта в браузере хватает норм и ролей — тексты каталога не тащим на страницу.
const norms = JSON.stringify([...parseCatalog(catalogCsv).values()].map((c) => [c.id, c.base, c.per, c.role, c.packages]));
// Селлеру сразу отмечены площадки, в общей версии — самый частый клиент: соцсети, товары с нуля.
const preset: Record<string, string> = variant === 'seller' ? { channel: 'mp', where: 'mp' } : { channel: 'social' };
const questions = Object.entries(QUICK_QUESTIONS).map(([name, [label, opts]]) => ({
  name, label, opts: opts as [string, string][], checked: preset[name] ?? (opts as [string, string][])[0][0],
}));
---

<!-- Своя миниатюра для пересылки ссылки (Телеграм, VK): public/og/*.jpg рисует `npm run brand` -->
<Base
  title={`${hero.title.split('.')[0]} — Эмилиус Эдженси`}
  description={hero.lead}
  ogImage={variant === 'seller' ? 'og/insales-seller.jpg' : 'og/insales.jpg'}
  ogImageAlt={variant === 'seller' ? 'Свой магазин рядом с Wildberries и Ozon: телефон с живым магазином на InSales' : 'Свой интернет-магазин на InSales за 3–5 недель: телефон с живым магазином'}
>

  <!-- Навигация по длинной странице: таблетка как у логотипа, появляется, когда первый экран ушёл вверх -->
  <nav class="jump" aria-label="Разделы страницы" data-jump>
    {JUMPS.map(([id, text]) => <a href={`#${id}`} data-jump-to={id}>{text}</a>)}
    <a class="jump-cta" href="#lead" data-goal="calc-click">Посчитать</a>
  </nav>

  <main class="page">
    <Breadcrumbs items={variant==='shop' ? [{title:'Услуги',href:'services/'},{title:'Магазин на InSales'}] : [{title:'Услуги',href:'services/'},{title:'Магазин на InSales',href:'services/insales-shop/'},{title:'Для селлеров'}]} />
    <section class="card hero">
      <div class="hero-main">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{nobreak(hero.title)}</h1>
      <p class="lead">{hero.lead}</p>
      <ul class="ticks">{hero.bullets.map((b) => <li>{b}</li>)}</ul>
      <div class="cta-row">
        <a class="cta" href="#lead" data-goal="calc-click">{hero.cta}</a>
        <p class="note">{CTA_NOTE}</p>
      </div>
      {variant === 'seller' && <p class="quick">Или <a href={LINKS.direct} target="_blank" rel="noopener">{SELLER_QUICK.link}</a> — {SELLER_QUICK.rest}.</p>}
      <a class="switch" href={other.url}>{other.text}</a>
      </div>
      <!-- Справа — живой магазин. На телефоне он под кнопкой и обрезан сверху: витрина видна, «Посчитать» остаётся на первом экране -->
      <figure class="hero-phone">
        <picture>
          <img src={href(`cases/mobile/${heroShop.id}.webp`)} alt={`Мобильная версия ${heroShop.domain}`} width="520" height="1071" fetchpriority="high" decoding="async" />
        </picture>
        <figcaption><a href={heroShop.url} target="_blank" rel="noopener">{heroShop.domain} ↗</a> — {heroShop.what[0].toLowerCase() + heroShop.what.slice(1)}</figcaption>
      </figure>
    </section>

    <section class="card block" aria-labelledby="t-extras">
      <h2 id="t-extras">Что обычно не пишут в предложениях — у нас входит в цену</h2>
      <div class="grid2">
        {EXTRAS.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </section>

    {variant === 'seller' && (
      <section class="card block" aria-labelledby="t-why">
        <h2 id="t-why">Зачем свой магазин, если есть WB и Ozon</h2>
        <div class="grid2">
          {SELLER_WHY.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
      </section>
      <section class="card block" aria-labelledby="t-move">
        <h2 id="t-move">Что переносим с площадок</h2>
        <div class="grid2">
          {SELLER_MOVE.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
        <p class="small">{SELLER_MOVE_NOTE}</p>
      </section>
    )}

    {variant === 'shop' && (
      <section class="card block" aria-labelledby="t-sit">
        <h2 id="t-sit">Узнаёте себя?</h2>
        <div class="grid2">
          {SITUATIONS.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}
        </div>
      </section>
    )}

    <section class="card block" aria-labelledby="t-result">
      <h2 id="t-result">Что получите</h2>
      <ul class="dots got">{RESULT.map((r) => <li>{r}</li>)}</ul>
    </section>

    <!-- Примеры: сначала магазины на шаблоне — ровно про эту услугу, затем остальные работы на InSales -->
    <section class="card block" aria-labelledby="t-examples">
      <h2 id="t-examples">Магазины, которые мы сделали</h2>
      <!-- Свежая работа — кейс «магазин + SEO»: что сделали и позиции по местным запросам -->
      <article class="case" id={`case-${FRESH_SHOP.id}`} aria-labelledby="t-case">
        <div class="case-top">
          <a class="case-shot" href={FRESH_SHOP.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <img src={`${base}${base.endsWith('/') ? '' : '/'}cases/${FRESH_SHOP.id}.webp`} alt="" width="640" height="400" loading="lazy" decoding="async" />
          </a>
          <div class="case-body">
            <span class="fresh-tag">{FRESH_SHOP.tag}</span>
            <h3 class="case-name" id="t-case">{FRESH_SHOP.name}</h3>
            <p class="shop-what">{FRESH_SHOP.what}</p>
            <ul class="dots case-done">{FRESH_SHOP.done.map((d) => <li>{d}</li>)}</ul>
            <a class="shop-link" href={FRESH_SHOP.url} target="_blank" rel="noopener">{FRESH_SHOP.domain} ↗</a>
          </div>
        </div>
        <div class="case-pos">
          <p class="case-pos-title">{FRESH_SHOP.positionsTitle}</p>
          <table>
            <thead><tr><th scope="col">Запрос</th><th scope="col">Яндекс</th><th scope="col">Google</th></tr></thead>
            <tbody>
              {FRESH_SHOP.positions.map(([q, ya, g]) => (
                <tr>
                  <th scope="row">{q}</th>
                  <td><span class:list={['pos', { first: ya === 1 }]}>{ya}</span></td>
                  <td><span class:list={['pos', { first: g === 1, none: g === null }]}>{g ?? '—'}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="small">{FRESH_SHOP.positionsNote}</p>
        </div>
      </article>
      <p class="sub-lead">На шаблоне InSales — как в этой услуге:</p>
      <ul class="shops">
        {TEMPLATE_SHOPS.map((x) => (
          <li>
            <a class="shop" href={x.url} target="_blank" rel="noopener">
              <img src={`${base}${base.endsWith('/') ? '' : '/'}cases/${x.id}.webp`} alt={`Первый экран сайта ${x.domain}`} width="640" height="400" loading="lazy" decoding="async" />
              <span class="shop-body">
                <span class="shop-name">{x.name}</span>
                <span class="shop-what">{x.what}</span>
                <span class="shop-link">{x.domain} ↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sub-lead">Ещё магазины и интеграции на InSales:</p>
      <ul class="more-shops">
        {MORE_SHOPS.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.domain}</a></li>)}
        {INTEGRATIONS.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.domain}</a> — {x.what}</li>)}
      </ul>
      <p class="proof">{PROOF_LINKS.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} target="_blank" rel="noopener">{l.text} ↗</a></>)}</p>
    </section>

    <!-- Мобильные версии: лента телефонов во всю ширину карточки, на десктопе — стрелки, на телефоне — свайп -->
    <section class="card block mobile" aria-labelledby="t-mobile">
      <div class="mobile-head">
        <div class="mobile-text">
          <h2 id="t-mobile">Как эти магазины выглядят в телефоне</h2>
          <p class="mobile-lead">С телефона покупают чаще всего. Поэтому первый пункт приёмки — заказ с телефона от каталога до чека.</p>
        </div>
        <div class="arrows">
          <button type="button" class="arrow" data-dir="-1" aria-label="Листать назад" disabled>←</button>
          <button type="button" class="arrow" data-dir="1" aria-label="Листать вперёд">→</button>
        </div>
      </div>
      <ul class="phones">
        {MOBILE_SHOTS.map((x) => (
          <li>
            <a class="phone-card" href={x.url} target="_blank" rel="noopener">
              <span class="phone"><img src={href(`cases/mobile/${x.id}.webp`)} alt={`Мобильная версия ${x.domain}`} width="520" height="1071" loading="lazy" decoding="async" /></span>
              <span class="phone-name">{x.name} <span aria-hidden="true">↗</span></span>
              <span class="phone-what">{x.what}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Видеоотзыв: как клиент нашёл нас и почему выбрал -->
    <section class="card block review" aria-labelledby="t-review">
      <h2 id="t-review">Отзыв клиента</h2>
      <div class="review-grid">
        <video
          controls
          playsinline
          preload="none"
          width="640"
          height="362"
          poster={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.poster}`}
        >
          <source src={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.src}`} type="video/mp4" />
          <track kind="captions" srclang="ru" label="Русский" src={`${base}${base.endsWith('/') ? '' : '/'}${VIDEO_REVIEW.captions}`} default />
        </video>
        <figure class="quote">
          <blockquote>«{VIDEO_REVIEW.quote}»</blockquote>
          <figcaption>
            <b>{VIDEO_REVIEW.who}</b>
            <span>{VIDEO_REVIEW.project} · <a href={VIDEO_REVIEW.url} target="_blank" rel="noopener">wizzu.ru ↗</a></span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="block plain" aria-labelledby="t-plans">
      <h2 id="t-plans">Пакеты и цены</h2>
      <div class="plans">
        {plans.map((p) => (
          <article class:list={['card', 'plan', { main: p.name === (variant === 'seller' ? 'Селлер' : 'Магазин') }]}>
            <h3>{p.name}</h3>
            <p class="who">{p.who}</p>
            <p class="price num">{p.price}</p>
            <p class="term">{p.term} · тариф {p.tariff}</p>
            <ul class="dots">{p.items.map((it) => <li>{it}</li>)}</ul>
            <a class="plan-cta" href="#lead" data-goal="calc-click" data-preset={JSON.stringify(PLAN_PRESETS[p.name] ?? {})}>Посчитать «{p.name}»</a>
          </article>
        ))}
      </div>
      <p class="small">{PLATFORM_NOTE}</p>
      <p class="small">{NOT_INCLUDED}</p>
    </section>

    <div class="cols">
      <section class="card block" aria-labelledby="t-accept">
        <h2 id="t-accept">Магазин сдан, когда</h2>
        <ol class="nums">{ACCEPTANCE.map((a) => <li>{a}</li>)}</ol>
        <p class="small">Полный протокол — 12 проверок. Отдаём его вместе с магазином.</p>
      </section>
      <section class="card block" aria-labelledby="t-yours">
        <h2 id="t-yours">Всё оформлено на вас</h2>
        <p>Аккаунт InSales, домен, Яндекс Метрика, договор эквайринга — на ваше имя с первого дня. Тема и данные ваши.</p>
        <h2 class="sub">Честно про трафик</h2>
        <p>Сайт — касса и витрина, а не поток покупателей. До оплаты разберём, откуда придут первые 100 покупателей: подписчики, база клиентов, офлайн-точка, реклама. Если источника нет, скажем и предложим, с чего начать.</p>
        <p>Есть офлайн-точка — начнём с местного SEO, как <a href={`#case-${FRESH_SHOP.id}`}>у {FRESH_SHOP.name}</a>. Это отдельная работа, в пакеты не входит.</p>
      </section>
    </div>

    <section class="card block" aria-labelledby="t-weeks">
      <h2 id="t-weeks">Этапы</h2>
      <ol class="weeks">
        {WEEKS.map(([w, what, you]) => (
          <li>
            <span class="wk num">Неделя {w}</span>
            <span class="what">{what}</span>
            {you !== '—' && <span class="you">Вы видите: {you}</span>}
          </li>
        ))}
      </ol>
      <p class="small">Связь — в Telegram-чате проекта: менеджер отвечает в течение часа, с 11 до 19 по Москве.</p>
    </section>

    <section class="card block" aria-labelledby="t-choice">
      <h2 id="t-choice">InSales, Tilda, Яндекс KIT или самому?</h2>
      <LinkList items={[
        {title:'Сравнить восемь платформ',description:'Сценарии, затраты и ограничения.',href:'compare/ecommerce-platforms/'},
        {title:'InSales и Яндекс KIT подробно',description:'348 функций со статусами, оговорками и источниками.',href:'compare/insales-vs-yandex-kit/'},
        {title:'Рассчитать состав проекта',description:'Предварительный бюджет и срок по семи ответам.',href:'tools/insales-calculator/'},
        ...(variant==='seller' && hasStockArticle ? [{title:'Как устроены единые остатки',description:'Сайт, маркетплейсы и учётная система.',href:'blog/edinye-ostatki-wb-ozon-insales/'}] : []),
      ]} />
      <dl class="choice">
        {CHOICE.map(([c, a]) => <div class:list={[{ fit: a === 'InSales' }]}><dt>{c}</dt><dd>{a}</dd></div>)}
      </dl>
    </section>

    <section class="card block" aria-labelledby="t-faq">
      <h2 id="t-faq">Частые вопросы</h2>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="card block lead-form" id="lead" aria-labelledby="t-lead">
      <h2 id="t-lead">Посчитаем ваш магазин</h2>
      <p>Ответьте на 7 вопросов — сразу покажем пакет, цену и срок по тем же нормам, по которым считаем смету.</p>
      <form method="post" action={action} novalidate data-norms={norms} data-variant={variant}>
        <input type="hidden" name="message" value={`Заявка на диагностику InSales (${variant})`} />
        <!-- Компьютер: вопросы слева, справа цена и контакты — закреплены, цена видна при каждом ответе -->
        <div class="quiz">
        {questions.map((q) => (
          <fieldset>
            <legend>{q.label}</legend>
            <div class="chips">
              {q.opts.map(([v, t]) => (
                <label class="chip"><input type="radio" name={q.name} value={v} checked={v === q.checked} /><span>{t}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        </div>
        <div class="side">
        <div class="estimate" aria-live="polite" hidden>
          <p class="est-pkg">Пакет <b data-out="pkg"></b></p>
          <p class="est-price num" data-out="price"></p>
          <p class="est-meta"><span data-out="weeks"></span> · тариф InSales <span data-out="tariff"></span> — отдельно, платите InSales напрямую</p>
          <p class="small">Ориентир без SEO, фидов для рекламы и доработок кодом. Точную смету «входит / не входит» фиксируем после диагностики, до оплаты.</p>
        </div>
        <label>Имя<input name="name" type="text" maxlength="100" autocomplete="name" /></label>
        <label>Telegram или телефон<input name="contact" type="text" maxlength="200" required autocomplete="tel" /></label>
        <div class="trap" aria-hidden="true"><input name="website" type="text" tabindex="-1" autocomplete="off" /></div>
        <!-- Согласие по 152-ФЗ отдельной галочкой: без него lead.php заявку не примет -->
        <label class="agree">
          <input type="checkbox" name="consent" value="1" required />
          <span>Согласен на <a href={consent} target="_blank">обработку персональных данных</a> по <a href={privacy} target="_blank">политике конфиденциальности</a></span>
        </label>
        <button class="cta" type="submit">Отправить расчёт и записаться на диагностику</button>
        <p class="small">Расчёт придёт менеджеру вместе с заявкой. Ответим в течение часа в рабочее время.</p>
        <p class="status" role="status" aria-live="polite" hidden></p>
        <p class="status" data-fail role="alert" hidden>
          Не получилось отправить. Напишите нам в Telegram: <a href={LINKS.direct} target="_blank" rel="noopener">{LINKS.direct.replace('https://t.me/', '@')}</a>
        </p>
        </div>
      </form>
    </section>
    <section class="card block"><h2>Если задача шире запуска магазина</h2><LinkList items={[
      {title:'Индивидуальный интерфейс',description:'Спроектировать свои сценарии и дизайн.',href:'services/design/'},
      {title:'Разработка и интеграции',description:'Обсудить нестандартную логику и связку систем.',href:'services/dev/'},
      {title:'Продвижение после запуска',description:'SEO, аналитика и развитие продукта.',href:'services/marketing/'},
    ]} /></section>
  </main>

  <Footer />
</Base>

<script>
  import { QUICK_QUESTIONS, quickEstimate } from '../../docs/insales-service/calc/quick.js';

  // Навигация по странице: видна, когда первый экран ушёл вверх; подсвечен раздел, который сейчас на экране.
  const jump = document.querySelector<HTMLElement>('[data-jump]');
  const heroCard = document.querySelector('.hero');
  if (jump && heroCard) {
    new IntersectionObserver(([e]) => jump.classList.toggle('is-on', !e.isIntersecting)).observe(heroCard);
    const links = new Map([...jump.querySelectorAll<HTMLAnchorElement>('[data-jump-to]')].map((a) => [a.dataset.jumpTo!, a]));
    const sections = [...links.keys()].map((id) => document.getElementById(id)?.closest('section')).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        const id = e.target.querySelector('h2')?.id;
        if (id && e.isIntersecting) links.forEach((a, k) => a.classList.toggle('is-here', k === id));
      }),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }

  // Цели Метрики (список — docs/insales-service/07-landing.md §4). Без счётчика emiGoal нет — вызовы ничего не делают.
  const goal = (name: string, params: Record<string, unknown> = {}) => (window as any).emiGoal?.(name, params);
  // Источник визита: UTM из адреса или сайт, с которого пришли; запоминаем на визит, чтобы не потерять при переходе между версиями. Уходит менеджеру в заявке.
  const source = (() => {
    try {
      const q = new URLSearchParams(location.search);
      const utm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].map((k) => q.get(k)).filter(Boolean).join(' / ');
      const now = utm || (document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).host : '');
      if (now) sessionStorage.setItem('emi-source', now);
      return sessionStorage.getItem('emi-source') || 'прямой заход';
    } catch {
      return 'не определён';
    }
  })();

  // Лента мобильных версий: стрелка листает на ширину видимой части, на краях гаснет.
  const phones = document.querySelector<HTMLElement>('.phones');
  const arrows = document.querySelectorAll<HTMLButtonElement>('.arrow');
  if (phones) {
    const sync = () => {
      arrows[0].disabled = phones.scrollLeft <= 2;
      arrows[1].disabled = phones.scrollLeft + phones.clientWidth >= phones.scrollWidth - 2;
    };
    arrows.forEach((b) => b.addEventListener('click', () => phones.scrollBy({ left: Number(b.dataset.dir) * phones.clientWidth * 0.8 })));
    phones.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }

  document.querySelectorAll<HTMLElement>('[data-goal]').forEach((el) => el.addEventListener('click', () => goal(el.dataset.goal!)));
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://t.me/"]').forEach((a) => a.addEventListener('click', () => goal('tg-click')));

  const form = document.querySelector<HTMLFormElement>('#lead form');
  if (form) {
    const variant = form.dataset.variant;
    let touched = false;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const ok = form.querySelector<HTMLElement>('.status:not([data-fail])')!;
    const fail = form.querySelector<HTMLElement>('[data-fail]')!;
    const contact = form.querySelector<HTMLInputElement>('[name=contact]')!;
    const agree = form.querySelector<HTMLInputElement>('[name=consent]')!;
    const box = form.querySelector<HTMLElement>('.estimate')!;
    const out = (k: string) => box.querySelector<HTMLElement>(`[data-out=${k}]`)!;
    const catalog = new Map(
      (JSON.parse(form.dataset.norms!) as [string, number, number, string, string][])
        .map(([id, base, per, role, packages]) => [id, { id, base, per, role, packages }]),
    );
    const rub = (n: number) => n.toLocaleString('ru-RU') + '\u00a0₽';
    const answers = () => Object.fromEntries(Object.keys(QUICK_QUESTIONS).map((k) => [k, String(new FormData(form).get(k) ?? '')]));
    const label = (k: string, v: string) => (QUICK_QUESTIONS as any)[k][1].find(([x]: string[]) => x === v)?.[1] ?? '—';

    let last: ReturnType<typeof quickEstimate> | null = null;
    // Переносим только допустимые ответы публичного калькулятора; контактные поля не заполняем.
    const calcParams = new URLSearchParams(location.search);
    for (const name of Object.keys(QUICK_QUESTIONS)) {
      const value = calcParams.get(`calc_${name}`);
      const input = [...form.querySelectorAll<HTMLInputElement>('input[type=radio]')].find(i=>i.name===name && i.value===value);
      if (input) input.checked = true;
    }
    const update = () => {
      try {
        last = quickEstimate(answers(), catalog);
      } catch {
        box.hidden = true;
        return;
      }
      out('pkg').textContent = `«${last.packageName}»`;
      out('price').textContent = `${rub(last.from)} – ${rub(last.to)}`;
      out('weeks').textContent = `${last.weeks.join('–')} ${last.weeks[1] <= 4 ? 'недели' : 'недель'}`;
      out('tariff').textContent = `«${last.tariff.name}» ${rub(last.tariff.month)}/мес`;
      box.hidden = false;
    };
    // Кнопка под пакетом: отмечаем его типичные ответы, якорь #lead прокрутит к расчёту.
    document.querySelectorAll<HTMLAnchorElement>('[data-preset]').forEach((a) =>
      a.addEventListener('click', () => {
        Object.entries(JSON.parse(a.dataset.preset!) as Record<string, string>).forEach(([k, v]) => {
          const r = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${v}"]`);
          if (r) r.checked = true;
        });
        update();
      }),
    );
    form.addEventListener('change', (e) => {
      update();
      // Первое изменение ответа — человек начал считать.
      if (!touched && (e.target as HTMLInputElement).type === 'radio') {
        touched = true;
        goal('quick-start', { variant });
      }
    });
    update();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ok.hidden = fail.hidden = true;
      if (!contact.value.trim()) {
        ok.textContent = 'Оставьте Telegram или телефон — без него не ответим.';
        ok.hidden = false;
        contact.focus();
        return;
      }
      if (!agree.checked) {
        ok.textContent = 'Отметьте согласие на обработку данных — без него не можем принять заявку.';
        ok.hidden = false;
        agree.focus();
        return;
      }
      // lead.php принимает message + contact: ответы и ориентир собираем в текст сообщения.
      const fd = new FormData(form);
      const a = answers();
      const msg = form.querySelector<HTMLInputElement>('[name=message]')!.value;
      fd.set('message', [
        msg,
        `Имя: ${fd.get('name') || '—'}`,
        ...Object.entries(a).map(([k, v]) => `${(QUICK_QUESTIONS as any)[k][0]}: ${label(k, v)}`),
        last ? `Ориентир на сайте: «${last.packageName}» ${rub(last.from)}–${rub(last.to)}, ${last.weeks.join('–')} нед., ${last.hours} ч, тариф «${last.tariff.name}»` : 'Ориентир не посчитан',
        `Источник: ${source}`,
        `Ответы: ${JSON.stringify(a)}`,
      ].join('\n'));
      button.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) throw new Error(String(res.status));
        ok.textContent = 'Спасибо! Расчёт у менеджера. Напишем в течение часа в рабочее время.';
        ok.hidden = false;
        goal('lead-sent', { variant, package: last?.packageName, from: last?.from, touched });
      } catch {
        fail.hidden = false;
        goal('lead-fail', { variant });
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

