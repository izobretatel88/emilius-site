---
// Знак-молния, который при загрузке рисуется одной линией со сварочной точкой.
// Прототип и история итераций — design/logo-bolt/draw-v4.html и DRAW-NOTES.md.
// Знак — вектор из Figma (bolt-master.svg), геометрия и цвета не меняются.
// Порядок хода — как в v2. Скорость: fast — 1,3 с без искр (везде на сайте, решение владельца 22.11.2026);
// long — 5,2 с сварки с искрами (осталась в прототипе и как режим компонента).
// Запуск (trigger): hover — знак стоит целиком и рисуется заново при наведении мыши (шапка);
// manual — спрятан до события logo-draw:start, по замыканию шва шлёт logo-draw:end (заставка).
import master from '../../design/logo-bolt/bolt-master.svg?raw';

interface Props { class?: string; mode?: 'fast' | 'long'; trigger?: 'hover' | 'manual' }
const { class: className, mode = 'fast', trigger = 'hover' } = Astro.props;

// id внутри знака уникальны на странице: знак может стоять не один раз
const uid = 'ld' + Math.random().toString(36).slice(2, 8);
const inner = master
  .replace(/^<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/id="(bolt|ish)"/g, `id="${uid}-$1"`)
  .replace(/url\(#(bolt|ish)\)/g, `url(#${uid}-$1)`);

// Центр линии знака (как в bolt-line.svg), 215×326. Порядок — как в наброске владельца:
// середина верхней диагонали → ступенька → короткая перекладина → остриё → левый угол → длинная перекладина → вершина → старт.
const PTS: [number, number][] = [
  [129.7, 57.3], [76.3, 171], [150, 171], [76.5, 316.5], [6.5, 131], [208, 131], [152.6, 8.6], [129.7, 57.3],
];
const d = 'M' + PTS.map(p => p.join(' ')).join(' L');
const len = PTS.slice(1).reduce((s, p, i) => s + Math.hypot(p[0] - PTS[i][0], p[1] - PTS[i][1]), 0);
---

<svg class:list={['logo-draw', className]} viewBox="0 0 215 326" aria-hidden="true" data-logo-draw data-len={len.toFixed(2)} data-mode={mode} data-trigger={trigger}>
  <defs>
    <mask id={`${uid}-r`} maskUnits="userSpaceOnUse" x="-20" y="-20" width="255" height="366">
      <path data-ld="mask" d={d} fill="none" stroke="#fff" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
      <!-- длинная перекладина закрыта, пока до неё не дошёл шов; диагональ на перекрестии открывается узкой линией -->
      <path data-ld="bar" d="M14.5 131 L200 131" fill="none" stroke="#000" stroke-width="14" style="display:none" />
      <path data-ld="diag" d="M129.7 57.3 L76.3 171" fill="none" stroke="#fff" stroke-width="11" />
    </mask>
    <filter id={`${uid}-g`} x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur data-ld="blur" stdDeviation="22" /></filter>
    <filter id={`${uid}-h`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2" /></filter>
    <radialGradient id={`${uid}-f`}>
      <stop offset="0" class="ld-core" />
      <stop offset=".35" class="ld-glow" />
      <stop offset="1" class="ld-warm" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g mask={`url(#${uid}-r)`} set:html={inner} />
  <path data-ld="hot" class="ld-hot" d={d} fill="none" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" filter={`url(#${uid}-h)`} opacity="0" />
  <g data-ld="sparks" />
  <g data-ld="torch" opacity="0">
    <circle data-ld="halo" r="60" fill={`url(#${uid}-f)`} filter={`url(#${uid}-g)`} />
    <circle data-ld="core" r="20" class="ld-core-dot" />
  </g>
</svg>
<script is:inline>
  // Спрятать знак до первой отрисовки, чтобы он не мелькнул целиком перед анимацией.
  // Если основной скрипт не запустится за 1,5 с — показать знак как есть.
  (function () {
    var s = document.currentScript && document.currentScript.previousElementSibling;
    if (!s || s.dataset.trigger !== 'manual' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var m = s.querySelector('[data-ld="mask"]'), L = s.getAttribute('data-len');
    m.style.strokeDasharray = L + ' ' + L; m.style.strokeDashoffset = L;
    s.querySelector('[data-ld="diag"]').style.strokeDasharray = '0 ' + L;
    setTimeout(function () { if (!s.dataset.started) { m.style.strokeDashoffset = 0; s.querySelector('[data-ld="diag"]').style.strokeDasharray = ''; } }, 1500);
  })();
</script>

<script>
  const BAR_LEN = 200 - 14.5;
  // fast — плавный разгон и торможение; long — ритм v2: ровный ход, мягко только по краям
  const easeFast = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
  const easeLong = (t: number) => {
    const a = 0.08;
    if (t < a) return (t * t) / (2 * a * (1 - a));
    if (t > 1 - a) { const u = 1 - t; return 1 - (u * u) / (2 * a * (1 - a)); }
    return (t - a / 2) / (1 - a);
  };
  const css = getComputedStyle(document.documentElement);
  const sec = (name: string, fallback: number) => (parseFloat(css.getPropertyValue(name)) || fallback) * 1000;
  const MODES = {
    fast: { dur: sec('--mark-draw', 1.3), ease: easeFast, sparks: false, tail: 32 },
    long: { dur: sec('--mark-draw-long', 5.2), ease: easeLong, sparks: true, tail: 56 },
  };
  const sparkColors = [css.getPropertyValue('--spark-core').trim(), css.getPropertyValue('--spark-warm').trim()];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Parts = ReturnType<typeof parts>;
  function parts(svg: SVGSVGElement) {
    const q = (k: string) => svg.querySelector<SVGGraphicsElement>(`[data-ld="${k}"]`)!;
    const mask = q('mask') as SVGPathElement;
    const L = mask.getTotalLength();
    const barAt = [[129.7, 57.3], [76.3, 171], [150, 171], [76.5, 316.5], [6.5, 131]]
      .reduce((s, p, i, a) => (i ? s + Math.hypot(p[0] - a[i - 1][0], p[1] - a[i - 1][1]) : 0), 0);
    const diagLen = Math.hypot(129.7 - 76.3, 171 - 57.3);
    const bar = q('bar'), diag = q('diag');
    const set = (len: number) => {
      mask.style.strokeDasharray = `${L} ${L}`;
      mask.style.strokeDashoffset = String(L - len);
      const done = Math.max(0, Math.min(BAR_LEN, len - barAt - 8));
      bar.style.display = done >= BAR_LEN ? 'none' : '';
      bar.style.strokeDasharray = `0 ${done} ${BAR_LEN + 1} 0`;
      diag.style.strokeDasharray = `${Math.min(len, diagLen)} ${L}`;
    };
    return { mask, L, set, hot: q('hot'), torch: q('torch'), halo: q('halo'), core: q('core'), blur: q('blur'), sparksG: q('sparks') };
  }

  function run(svg: SVGSVGElement, p: Parts = parts(svg)) {
    svg.dataset.started = '1';
    const cfg = MODES[svg.dataset.mode === 'long' ? 'long' : 'fast'];
    const done = () => svg.dispatchEvent(new CustomEvent('logo-draw:end'));
    if (reduce) { p.set(p.L); done(); return; }

    // Точка и искры — в пикселях экрана: в шапке знак 27 px, в заставке — 170 px
    const k = 326 / (svg.getBoundingClientRect().height || 27); // единиц знака на пиксель
    p.core.setAttribute('r', Math.max(4.5, 1.6 * k).toFixed(1));
    const haloR = Math.max(15, 4.6 * k);
    p.blur.setAttribute('stdDeviation', Math.max(5, 1.8 * k).toFixed(1));
    const px = k * Math.max(1, 326 / k / 60);               // крупный знак — искры летят дальше
    type Spark = { el: SVGLineElement; x: number; y: number; vx: number; vy: number; born: number; life: number };
    let sparks: Spark[] = [], last = 0, ended = false;
    const t0 = performance.now(); let prev = t0;
    const fade = 450;

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
      const t = Math.min(1, (now - t0) / cfg.dur);
      const len = p.L * cfg.ease(t);
      p.set(len);
      const pt = p.mask.getPointAtLength(Math.min(len, p.L - 0.001));
      p.torch.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
      const tail = Math.min(cfg.tail, len);
      p.hot.style.strokeDasharray = `0 ${len - tail} ${tail} ${p.L}`;

      if (t < 1) {
        const tt = now - t0;
        const f = cfg.sparks ? 0.88 + 0.12 * (Math.sin(tt * 0.031) * 0.5 + Math.sin(tt * 0.077 + 1) * 0.3 + Math.sin(tt * 0.013 + 2) * 0.2) : 1;
        p.torch.setAttribute('opacity', f.toFixed(3));
        p.hot.setAttribute('opacity', '0.85');
        p.halo.setAttribute('r', (haloR * (0.92 + 0.32 * (f - 0.76) / 0.24)).toFixed(1));
        if (cfg.sparks && now - last > 30) {
          last = now;
          const n = 1 + Math.floor(Math.random() * 2);
          for (let i = 0; i < n; i++) {
            const ang = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.6;
            const sp = (12 + Math.random() * 26) * px;
            const el = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            el.setAttribute('stroke', sparkColors[Math.random() < 0.5 ? 0 : 1]);
            el.setAttribute('stroke-width', '1.2');
            el.setAttribute('vector-effect', 'non-scaling-stroke');
            el.setAttribute('stroke-linecap', 'round');
            p.sparksG.appendChild(el);
            sparks.push({ el, x: pt.x, y: pt.y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, born: now, life: 240 + Math.random() * 320 });
          }
        }
      } else {
        if (!ended) { ended = true; done(); }
        const f = Math.max(0, 1 - (now - t0 - cfg.dur) / fade);
        p.torch.setAttribute('opacity', f.toFixed(3));
        p.hot.setAttribute('opacity', (0.85 * f).toFixed(3));
      }

      sparks = sparks.filter(s => {
        const age = now - s.born;
        if (age > s.life) { s.el.remove(); return false; }
        s.vy += 90 * px * dt; s.x += s.vx * dt; s.y += s.vy * dt;
        s.el.setAttribute('x1', s.x.toFixed(1)); s.el.setAttribute('y1', s.y.toFixed(1));
        s.el.setAttribute('x2', (s.x - s.vx * 0.045).toFixed(1)); s.el.setAttribute('y2', (s.y - s.vy * 0.045).toFixed(1));
        s.el.setAttribute('opacity', (1 - age / s.life).toFixed(2));
        return true;
      });

      if (t < 1 || now - t0 - cfg.dur < fade || sparks.length) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  const marks = [...document.querySelectorAll<SVGSVGElement>('svg[data-logo-draw]')];
  // Заставка: спрятан и ждёт команды
  marks.filter(s => s.dataset.trigger === 'manual').forEach(svg => {
    svg.dataset.started = '1';             // не дать запасному таймеру показать знак раньше времени
    svg.addEventListener('logo-draw:start', () => run(svg), { once: true });
  });
  // Шапка: знак стоит целиком, рисуется заново только при наведении мыши (на телефоне — никогда)
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  marks.filter(s => s.dataset.trigger === 'hover').forEach(svg => {
    if (!canHover || reduce) return;
    const target = svg.closest('a') ?? svg.parentElement ?? svg;
    let busy = false;
    svg.addEventListener('logo-draw:end', () => { busy = false; });
    target.addEventListener('pointerenter', () => {
      if (busy) return;
      busy = true;
      run(svg);
    });
  });
</script>

<style>
  .logo-draw { display: block; overflow: visible; }
  .ld-core { stop-color: var(--spark-core); }
  .ld-glow { stop-color: var(--spark-glow); }
  .ld-warm { stop-color: var(--spark-warm); }
  .ld-core-dot { fill: var(--spark-core); }
  .ld-hot { stroke: var(--spark-hot); }
</style>
