---
import { LINKS, EMI_WIDGET_SRC } from '../data/site';
---

<div class="stack">
  <section class="card col-card" aria-labelledby="t-contact">
    <h2 class="card-title" id="t-contact">Связь</h2>
    <a class="btn btn-primary" href={LINKS.channel} target="_blank" rel="noopener">
      В канал
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.4 3.2 2.9 10.4c-1 .4-1 1.6 0 1.9l4.7 1.5 1.8 5.6c.3.8 1.3 1 1.9.4l2.6-2.5 4.9 3.6c.7.5 1.7.1 1.9-.7L23 4.5c.2-1-.7-1.7-1.6-1.3ZM9.6 14.3l8.7-7.7-6.9 9.3-.3 3-1.5-4.6Z"></path></svg>
    </a>
    <a class="btn btn-secondary" href={LINKS.direct} target="_blank" rel="noopener">
      Написать
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.4 3.2 2.9 10.4c-1 .4-1 1.6 0 1.9l4.7 1.5 1.8 5.6c.3.8 1.3 1 1.9.4l2.6-2.5 4.9 3.6c.7.5 1.7.1 1.9-.7L23 4.5c.2-1-.7-1.7-1.6-1.3ZM9.6 14.3l8.7-7.7-6.9 9.3-.3 3-1.5-4.6Z"></path></svg>
    </a>
  </section>

  <section class="card col-card" aria-labelledby="t-emi">
    <h2 class="card-title" id="t-emi">Спросить 🤖 Эми</h2>
    <iframe src={EMI_WIDGET_SRC} title="Голосовой ассистент Эми" width="170" height="144" allow="microphone" loading="lazy" scrolling="no" frameborder="0"></iframe>
    <p class="micro">Если не отвечает — смените интернет-соединение</p>
  </section>
</div>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .col-card {
    padding: 14px 14px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .btn {
    width: 100%;
    height: 54px;
    border-radius: var(--radius-btn);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 16px 14px;
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover);
  }
  .btn svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: #000;
  }
  .btn-primary {
    background: var(--teal);
    color: #fff;
    border: 0;
  }
  .btn-primary:hover {
    color: var(--on-teal);
  }
  .btn-secondary {
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--teal);
  }
  .btn-secondary svg {
    fill: var(--ink);
  }
  .btn-secondary:hover {
    background: var(--teal);
    color: #fff;
  }
  .btn-secondary:hover svg {
    fill: #000;
  }
  iframe {
    width: 170px;
    height: 144px;
    border: 0;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--well);
  }
  .micro {
    font-size: 12px;
    line-height: 1.3;
    text-align: center;
    color: var(--ink-2);
  }
</style>
