---
// Колесо продукта: итерация из 52 дней, 4 этапа по 13 дней (52 деления на ободе).
// Геометрия считается на сборке. В браузере: вращение-демонстрация (один оборот — итерация из 52 дней,
// не привязан к сегодняшней дате), шкала пройденной части итерации у стрелки,
// подсветка этапов и доводка выбранного этапа под стрелку.
import { SECTORS } from '../data/site';

const base = import.meta.env.BASE_URL;
const servicesHref = (id: string) => `${base}${base.endsWith('/') ? '' : '/'}services/${id}/`;

const STEP = 360 / 52;
const rad = (d: number) => (d * Math.PI) / 180;
const P = (r: number, d: number) => [+(r * Math.cos(rad(d))).toFixed(2), +(r * Math.sin(rad(d))).toFixed(2)];
// День k стоит под стрелкой (9 часов) при повороте (k - 0.5) * STEP.
const weekAngle = (k: number) => 180 - (k - 0.5) * STEP;

const SPEC = ['#e44854', '#c06c60', '#e4d830', '#b4e43c', '#30c048', '#30d890', '#30c0b4', '#30c0cc', '#309ce4', '#e44854'];
const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.substr(i, 2), 16));
function specAt(t: number) {
  t = ((t % 1) + 1) % 1;
  const f = t * (SPEC.length - 1);
  const i = Math.floor(f);
  const r = f - i;
  const a = hex(SPEC[i]);
  const b = hex(SPEC[i + 1]);
  return `rgb(${a.map((v, j) => Math.round(v + (b[j] - v) * r)).join(',')})`;
}

const discSectors = SECTORS.map((s, i) => {
  const [x0, y0] = P(170, weekAngle(s.to + 0.5));
  const [x1, y1] = P(170, weekAngle(s.from - 0.5));
  return { i, d: `M0 0 L${x0} ${y0} A170 170 0 0 1 ${x1} ${y1} Z`, fill: `var(--sec-${s.id})` };
});

const crossLines = [0.5, 13.5, 26.5, 39.5].map((k, i) => {
  const a = weekAngle(k);
  const [x1, y1] = P(54, a);
  const [x2, y2] = P(168, a);
  return { id: `cg${i}`, x1, y1, x2, y2, c1: specAt(i / 4), c2: specAt(i / 4 + 0.18) };
});

// Риски между днями; на границах этапов (после 13, 26, 39, 52) — длинные.
const weeks = Array.from({ length: 52 }, (_, i) => {
  const k = i + 1;
  const edge = weekAngle(k + 0.5);
  const quarter = k % 13 === 0;
  const [tx1, ty1] = P(quarter ? 171 : 178, edge);
  const [tx2, ty2] = P(quarter ? 199 : 194, edge);
  const a = weekAngle(k);
  const [x, y] = P(186, a);
  return { k, label: String(k).padStart(2, '0'), quarter, tx1, ty1, tx2, ty2, x, y, rot: +(a + 90).toFixed(2), color: specAt(i / 52) };
});

const labels = SECTORS.map((s, i) => {
  const mid = weekAngle((s.from + s.to) / 2);
  const [x1, y1] = P(125, mid - 30);
  const [x2, y2] = P(125, mid + 30);
  return { id: `lg${i}`, offset: +((((mid % 360) + 360) % 360) / 3.6).toFixed(2), x1, y1, x2, y2, ...s };
});

const rim = Array.from({ length: 72 }, (_, i) => {
  const [x0, y0] = P(50, i * 5);
  const [x1, y1] = P(50, i * 5 + 5.4);
  return { d: `M${x0} ${y0} A50 50 0 0 1 ${x1} ${y1}`, color: specAt(i / 72) };
});

const hits = SECTORS.map((s, i) => {
  const a0 = weekAngle(s.to + 0.5);
  const a1 = weekAngle(s.from - 0.5);
  const [x0, y0] = P(212, a0);
  const [x1, y1] = P(212, a1);
  const [x2, y2] = P(52, a1);
  const [x3, y3] = P(52, a0);
  return { i, href: servicesHref(s.id), d: `M${x3} ${y3} L${x0} ${y0} A212 212 0 0 1 ${x1} ${y1} L${x2} ${y2} A52 52 0 0 0 ${x3} ${y3} Z`, ...s };
});

// Для скрипта: этапы со ссылками и текстами
const sectorData = SECTORS.map((s) => ({ ...s, href: servicesHref(s.id) }));
---

<!-- Строка над колесом: какой день и этап сейчас под стрелкой; при выборе — описание этапа -->
<div class="wheel-info" id="wheelInfo"></div>

<div class="wheel-box" id="wheelBox" role="group" aria-label="Колесо продукта: итерация из 52 дней и четырёх этапов — касдев, дизайн, разработка, маркетинг">
  <!-- Вращается весь этот SVG целиком через CSS-transform: браузер растрирует его один раз
       и поворачивает на видеокарте, без перерисовки 200 элементов каждый кадр. -->
  <svg class="wheel-rotor" id="wheelRotor" viewBox="-220 -220 440 440">
    <defs>
      <path id="arc" d="M125 0 A125 125 0 1 1 -125 0 A125 125 0 1 1 125 0" fill="none"></path>
      {crossLines.map((l) => (
        <linearGradient id={l.id} gradientUnits="userSpaceOnUse" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}>
          <stop offset="0" stop-color={l.c1}></stop>
          <stop offset="1" stop-color={l.c2}></stop>
        </linearGradient>
      ))}
      {labels.map((l) => (
        <linearGradient id={l.id} gradientUnits="userSpaceOnUse" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}>
          <stop offset="0" stop-color={l.c1}></stop>
          <stop offset="1" stop-color={l.c2}></stop>
        </linearGradient>
      ))}
    </defs>

    <g id="rotor">
      {discSectors.map((s) => <path class="sector-fill" data-sector={s.i} d={s.d} style={`fill:${s.fill}`}></path>)}
      <circle r="170" fill="none" style="stroke:var(--disc-stroke)" stroke-width="2.5"></circle>

      <g style="opacity:var(--cross-op)">
        {crossLines.map((l) => (
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={`url(#${l.id})`} stroke-width="2" stroke-dasharray="5 4"></line>
        ))}
      </g>

      <g class="ticks">
        {weeks.map((w) => (
          <line
            class:list={['tick', { quarter: w.quarter }]}
            x1={w.tx1} y1={w.ty1} x2={w.tx2} y2={w.ty2}
            stroke={w.color} stroke-width={w.quarter ? 2.8 : 2.2} stroke-linecap="round"
          ></line>
        ))}
      </g>
      <g font-size="8.5" font-weight="600" class="num">
        {weeks.map((w) => (
          <text class="week" data-week={w.k} x={w.x} y={w.y} text-anchor="middle" dominant-baseline="central" transform={`rotate(${w.rot} ${w.x} ${w.y})`}>{w.label}</text>
        ))}
      </g>

      <g id="labels">
        {labels.map((l, i) => (
          <text class="sector-label" font-size="25" font-weight="700" fill={`url(#${l.id})`} data-sector={i}>
            <textPath href="#arc" startOffset={`${l.offset}%`} text-anchor="middle">{l.name}</textPath>
          </text>
        ))}
      </g>

      <circle r="50" style="fill:var(--center-fill)"></circle>
      {rim.map((a) => <path d={a.d} fill="none" stroke={a.color} stroke-width="1.1"></path>)}

      {hits.map((h) => (
        <a href={h.href} class="sector-link" data-sector={h.i} aria-label={`${h.name}: дни ${h.from}–${h.to}. ${h.text}`}>
          <path class="sector-hit" d={h.d}></path>
        </a>
      ))}
    </g>
  </svg>

  <svg class="wheel-overlay" viewBox="-220 -220 440 440" aria-hidden="true">
    <defs>
      {SECTORS.map((s, i) => (
        <linearGradient id={`cw${i}`} x1="-40" y1="0" x2="40" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color={s.c1}></stop>
          <stop offset="1" stop-color={s.c2}></stop>
        </linearGradient>
      ))}
    </defs>
    <!-- Шкала, как у спидометра: от стрелки по часовой растёт пройденная часть итерации -->
    <path id="wheelProgress" class="year-progress" d=""></path>
    <g id="pointer">
      <line x1="-216" y1="0" x2="-51" y2="0" style="stroke:var(--teal)" stroke-width="2.4"></line>
      <path d="M-216 -7 L-203 0 L-216 7 Z" style="fill:var(--teal)"></path>
      <!-- Подпись под стрелкой от внешнего конца делений; по завершении круга — «итерация выполнена» -->
      <text class="iter-tag" id="iterText" x="-199" y="19" font-size="12" font-weight="700">итерация</text>
    </g>
    <text class="center-word center-default" x="0" y="5.5" text-anchor="middle" font-size="15" font-weight="600" style="fill:var(--ink-2)">внимание</text>
    {SECTORS.map((s, i) => (
      <text class="center-word center-sector" data-sector={i} x="0" y="6" text-anchor="middle" font-size={s.name.length > 8 ? 13 : 15} font-weight="800" fill={`url(#cw${i})`}>{s.name}</text>
    ))}
  </svg>
</div>


<script is:inline define:vars={{ sectorData }}>
  window.__wheelSectors = sectorData;
</script>

<script>
  type Sector = { id: string; name: string; from: number; to: number; text: string; href: string };

  const box = document.getElementById('wheelBox');
  const rotorSvg = document.getElementById('wheelRotor');
  const info = document.getElementById('wheelInfo');
  const progressArc = document.getElementById('wheelProgress');
  const iterText = document.getElementById('iterText') as SVGTextElement | null;
  const SECTORS = (window as unknown as { __wheelSectors: Sector[] }).__wheelSectors;

  if (box && rotorSvg && info && progressArc && iterText && SECTORS) {
    const STEP = 360 / 52;
    const PERIOD = 156000; // один оборот — итерация из 52 дней, ~3 с на день
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = matchMedia('(hover: hover)').matches;

    const links = [...box.querySelectorAll<SVGAElement>('.sector-link')];
    const fills = [...box.querySelectorAll<SVGPathElement>('.sector-fill')];
    const labels = [...box.querySelectorAll<SVGTextElement>('.sector-label')];
    const centers = [...box.querySelectorAll<SVGTextElement>('.center-sector')];

    // ---------- Итерация-демонстрация ----------
    // День k стоит под стрелкой при повороте (k - 0.5) * STEP; угол 0 — начало итерации у стрелки.
    const weekAt = (turn: number) => Math.min(52, Math.floor(turn / STEP) + 1);
    const sectorOf = (week: number) => SECTORS.findIndex((s) => week >= s.from && week <= s.to);
    const weekEls = [...box.querySelectorAll<SVGTextElement>('.week')];
    let simWeek = 1;
    let simSector = 0;

    // Дуга шкалы: от стрелки (180°) по часовой на пройденную часть оборота
    const R = 207;
    const pt = (d: number) => {
      const a = (d * Math.PI) / 180;
      return `${(R * Math.cos(a)).toFixed(2)} ${(R * Math.sin(a)).toFixed(2)}`;
    };
    const drawProgress = (turn: number) => {
      progressArc.setAttribute('d', turn < 0.5 ? '' : `M${pt(180)} A${R} ${R} 0 ${turn > 180 ? 1 : 0} 1 ${pt(180 + turn)}`);
    };

    const setTag = (text: string) => {
      iterText.textContent = text;
    };
    let doneUntil = 0; // пока показываем «итерация выполнена»

    // ---------- Вращение ----------
    const sectorAngle = (i: number) => ((SECTORS[i].from + SECTORS[i].to) / 2 - 0.5) * STEP;
    let ambient: Animation | null = null;

    const setAngle = (a: number) => (rotorSvg.style.transform = `rotate(${a}deg)`);
    const currentAngle = () => {
      const m = new DOMMatrixReadOnly(getComputedStyle(rotorSvg).transform);
      return (Math.atan2(m.b, m.a) * 180) / Math.PI;
    };
    const startAmbient = (from: number) => {
      ambient?.cancel();
      setAngle(from);
      if (reduce) return;
      ambient = rotorSvg.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${from + 360}deg)` }], {
        duration: PERIOD,
        iterations: Infinity,
      });
    };
    // Спокойная доводка по кратчайшему пути, без пружин
    const turnTo = (target: number, duration: number, done?: (a: number) => void) => {
      const from = currentAngle();
      ambient?.cancel();
      ambient = null;
      const delta = ((((target - from) % 360) + 540) % 360) - 180;
      const to = from + delta;
      setAngle(to);
      if (reduce || duration === 0) return done?.(to);
      const a = rotorSvg.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${to}deg)` }], {
        duration,
        easing: 'cubic-bezier(.45,0,.2,1)',
      });
      a.onfinish = () => done?.(to);
    };

    // ---------- Состояние ----------
    let hovered: number | null = null; // мышь — только подсветка
    let selected: number | null = null; // касание и клавиатура — подсветка + доводка под стрелку
    // Выбор с клавиатуры или касанием главнее наведения мыши
    const active = () => selected ?? hovered;
    const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

    function render() {
      const i = active();
      box.classList.toggle('has-active', i !== null);
      fills.forEach((el, j) => el.classList.toggle('is-active', i === j));
      labels.forEach((el, j) => el.classList.toggle('is-active', i === j));
      centers.forEach((el, j) => el.classList.toggle('is-active', i === j));

      // Бегущий день экранный диктор не зачитывает — только выбор этапа
      info.setAttribute('aria-live', i === null ? 'off' : 'polite');
      if (i === null) {
        const line = performance.now() < doneUntil
          ? `<b>Итерация выполнена</b> · начинаем новую`
          : `<b>День&nbsp;${simWeek}</b> из 52 · идёт <b>${SECTORS[simSector].name}</b>`;
        info.innerHTML =
          `<p class="info-line">${line}</p>` +
          `<p class="info-sub">Так проходит итерация: 52 дня, четыре этапа по 13 дней, затем новая. ${canHover ? 'Наведите на этап' : 'Нажмите на этап'}, чтобы узнать больше.</p>`;
        return;
      }
      const s = SECTORS[i];
      info.innerHTML =
        `<p class="info-line"><b>${cap(s.name)}</b> · дни ${s.from}–${s.to}</p>` +
        `<p class="info-sub">${s.text}</p>` +
        `<a class="info-more" href="${s.href}">Подробнее об этапе →</a>`;
    }

    function select(i: number) {
      selected = i;
      hovered = null;
      render();
      turnTo(sectorAngle(i), 800);
    }
    function clear() {
      if (selected === null && hovered === null) return;
      const wasSelected = selected !== null;
      selected = null;
      hovered = null;
      render();
      if (wasSelected) startAmbient(currentAngle());
      else ambient?.play();
    }

    // ---------- События ----------
    let lastPointer = 'mouse';
    // Чем человек пользуется сейчас: фокус от клавиатуры доворачивает этап, фокус от клика — нет
    let keyboard = false;
    document.addEventListener('keydown', () => (keyboard = true), true);
    document.addEventListener('pointerdown', () => (keyboard = false), true);
    // Колесо может провернуться под неподвижным курсором — считаем наведением только реальное движение мыши
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' && (e.movementX || e.movementY)) keyboard = false;
    }, true);
    links.forEach((link) => {
      const i = Number(link.dataset.sector);
      link.addEventListener('pointerdown', (e) => (lastPointer = e.pointerType));
      link.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || keyboard) return;
        hovered = i;
        ambient?.pause();
        render();
      });
      // Касание: первое выбирает этап, второе открывает страницу
      link.addEventListener('click', (e) => {
        if (lastPointer === 'touch' && selected !== i) {
          e.preventDefault();
          select(i);
        }
      });
      link.addEventListener('focus', () => {
        if (keyboard || link.matches(':focus-visible')) select(i);
      });
    });

    box.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || hovered === null) return;
      hovered = null;
      render();
      if (selected === null) ambient?.play();
    });

    box.addEventListener('keydown', (e) => {
      const idx = links.findIndex((l) => l === document.activeElement);
      if (e.key === 'Escape') {
        (document.activeElement as HTMLElement | null)?.blur();
        clear();
        return;
      }
      if (idx < 0) return;
      // По часовой — следующий этап цикла
      const next = ({ ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 } as Record<string, number>)[e.key];
      if (next) {
        e.preventDefault();
        const j = (idx + next + links.length) % links.length;
        links[j].focus();
        select(j);
      }
    });
    box.addEventListener('focusout', (e) => {
      if (!box.contains(e.relatedTarget as Node)) clear();
    });
    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' && !box.contains(e.target as Node) && !info.contains(e.target as Node)) clear();
    });

    // ---------- Ход итерации: что под стрелкой, шкала, завершение круга ----------
    let prevTurn = 0;
    function tick() {
      const turn = ((currentAngle() % 360) + 360) % 360;
      // Круг замкнулся: шли вперёд и перевалили через начало итерации
      if (ambient?.playState === 'running' && prevTurn > 300 && turn < 60) {
        doneUntil = performance.now() + 4000;
        setTag('итерация выполнена');
        window.setTimeout(() => {
          setTag('итерация');
          render();
        }, 4000);
      }
      prevTurn = turn;
      drawProgress(turn);

      const week = weekAt(turn);
      if (week !== simWeek) {
        weekEls[simWeek - 1]?.classList.remove('is-today');
        weekEls[week - 1]?.classList.add('is-today');
        simWeek = week;
        const sec = sectorOf(week);
        if (sec !== simSector) {
          fills[simSector]?.classList.remove('is-now');
          fills[sec]?.classList.add('is-now');
          simSector = sec;
        }
        if (active() === null) render();
      }
    }

    // ---------- Вход: итерация начинается с первого дня ----------
    weekEls[0]?.classList.add('is-today');
    fills[0]?.classList.add('is-now');
    setTag('итерация');
    render();
    startAmbient(0);
    tick();
    // 10 раз в секунду хватает: шкала сдвигается на ~0,2° за шаг, глазом не видно
    if (!reduce) window.setInterval(tick, 100);
  }
</script>

<style>
  .wheel-box {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    /* Повёрнутый квадрат ротора по диагонали шире коробки — без обрезки на узком экране
       страница прокручивается вбок. Круг колеса вписан в квадрат, поэтому ничего не теряется. */
    overflow: clip;
  }
  .wheel-box svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .wheel-rotor {
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .wheel-overlay {
    pointer-events: none;
  }

  /* Сектора: текущий этап чуть насыщеннее; при выборе — выбранный ярче, остальные гаснут */
  .sector-fill {
    opacity: var(--disc-op);
    transition: opacity 0.3s ease;
  }
  .sector-fill.is-now {
    opacity: min(1, calc(var(--disc-op) + 0.3));
  }
  .has-active .sector-fill {
    opacity: calc(var(--disc-op) * 0.45);
  }
  .has-active .sector-fill.is-active {
    opacity: 1;
  }
  .sector-label {
    opacity: var(--label-op);
    transition: opacity 0.3s ease;
  }
  .has-active .sector-label {
    opacity: 0.2;
  }
  .has-active .sector-label.is-active {
    opacity: 1;
  }

  .ticks {
    opacity: var(--tick-op);
  }
  .num {
    fill: var(--teal-num);
  }
  .week.is-today {
    fill: var(--teal-text);
    font-weight: 800;
    font-size: 10.5px;
  }
  .year-progress {
    fill: none;
    stroke: var(--teal);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.5;
  }
  /* Подпись поверх делений: обводка цветом карточки отделяет её от рисок, тень — от фона */
  .iter-tag {
    fill: var(--teal-text);
    stroke: var(--card);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
    filter: drop-shadow(0 1px 1.5px rgba(0, 0, 0, 0.28));
  }

  .sector-hit {
    fill: transparent;
    cursor: pointer;
  }
  .sector-link:focus-visible {
    outline: none;
  }
  .sector-link:focus-visible .sector-hit {
    stroke: var(--teal);
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }

  /* Центр: «внимание» уступает место названию выбранного этапа */
  .center-word {
    transition: opacity 0.25s ease;
  }
  .has-active .center-default {
    opacity: 0;
  }
  .center-sector {
    opacity: 0;
  }
  .center-sector.is-active {
    opacity: 1;
  }

  .wheel-info {
    min-height: 4.6em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    padding-inline: 8px;
  }
  .wheel-info :global(.info-line) {
    font-size: 15px;
    color: var(--ink);
  }
  .wheel-info :global(.info-line b) {
    font-weight: 700;
