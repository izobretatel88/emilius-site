---
// Колесо продукта: итерация из 52 дней, 4 этапа по 13 дней (52 деления на ободе).
// Геометрия считается на сборке. В браузере: вращение-демонстрация (один оборот — итерация из 52 дней,
// не привязан к сегодняшней дате), шкала пройденной части итерации у стрелки,
// подсветка этапов и доводка выбранного этапа под стрелку.
import { SECTORS, STAGE_QUESTIONS } from '../data/site';

const base = import.meta.env.BASE_URL;
const servicesHref = (id: string) => `${base}${base.endsWith('/') ? '' : '/'}services/${id}/`;

const STEP = 360 / 52;
// Центральный круг «внимание»: в нём вопросы текущего этапа
const C = 75;
const rad = (d: number) => (d * Math.PI) / 180;
const P = (r: number, d: number) => [+(r * Math.cos(rad(d))).toFixed(2), +(r * Math.sin(rad(d))).toFixed(2)];
// День k стоит под стрелкой (9 часов) при повороте (k - 0.5) * STEP.
const weekAngle = (k: number) => 180 - (k - 0.5) * STEP;

const SPEC = ['#e44854', '#c06c60', '#e4d830', '#b4e43c', '#30c048', '#30d890', '#30c0b4', '#30c0cc', '#309ce4', '#e44854'];
const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.substr(i, 2), 16));
function specAt(t: number) {
  t = ((t % 1) + 1) % 1;
  const f = t * (SPEC.length - 1);
  const i = Math.floor(f);
  const r = f - i;
  const a = hex(SPEC[i]);
  const b = hex(SPEC[i + 1]);
  return `rgb(${a.map((v, j) => Math.round(v + (b[j] - v) * r)).join(',')})`;
}

// Секторы этапов доходят до внешнего края — туда, где номера дней
const R_OUT = 205;
const discSectors = SECTORS.map((s, i) => {
  const [x0, y0] = P(R_OUT, weekAngle(s.to + 0.5));
  const [x1, y1] = P(R_OUT, weekAngle(s.from - 0.5));
  return { i, d: `M0 0 L${x0} ${y0} A${R_OUT} ${R_OUT} 0 0 1 ${x1} ${y1} Z`, fill: `--f:var(--sec-${s.id});--f-now:var(--sec-${s.id}-now)` };
});

// Клин каждого дня: пройденные дни закрашиваются цветом своего этапа — круг заполняется
const dayCells = Array.from({ length: 52 }, (_, i) => {
  const k = i + 1;
  const s = SECTORS.find((x) => k >= x.from && k <= x.to)!;
  const [x0, y0] = P(R_OUT, weekAngle(k + 0.5));
  const [x1, y1] = P(R_OUT, weekAngle(k - 0.5));
  return { k, d: `M0 0 L${x0} ${y0} A${R_OUT} ${R_OUT} 0 0 1 ${x1} ${y1} Z`, fill: `var(--sec-${s.id}-done)` };
});

// Разделители этапов — тонкие нейтральные линии от центра до края
const crossLines = [0.5, 13.5, 26.5, 39.5].map((k) => {
  const a = weekAngle(k);
  const [x1, y1] = P(C, a);
  const [x2, y2] = P(R_OUT, a);
  return { x1, y1, x2, y2 };
});

// Риски между днями; на границах этапов (после 13, 26, 39, 52) — длинные.
const weeks = Array.from({ length: 52 }, (_, i) => {
  const k = i + 1;
  const edge = weekAngle(k + 0.5);
  const quarter = k % 13 === 0;
  const [tx1, ty1] = P(quarter ? 171 : 178, edge);
  const [tx2, ty2] = P(quarter ? 199 : 194, edge);
  const a = weekAngle(k);
  const [x, y] = P(186, a);
  return { k, label: String(k).padStart(2, '0'), quarter, tx1, ty1, tx2, ty2, x, y, rot: +(a + 90).toFixed(2) };
});

// Названия этапов — сплошным цветом (середина между c1 и c2). Градиент на тексте по дуге
// Safari на iPhone обрезает по неповёрнутым рамкам букв — края букв «съедались».
const mix = (a: string, b: string) => {
  const [x, y] = [hex(a), hex(b)];
  return `#${x.map((v, j) => Math.round((v + y[j]) / 2).toString(16).padStart(2, '0')).join('')}`;
};
const labels = SECTORS.map((s) => {
  const mid = weekAngle((s.from + s.to) / 2);
  return { offset: +((((mid % 360) + 360) % 360) / 3.6).toFixed(2), color: mix(s.c1, s.c2), ...s };
});

const rim = Array.from({ length: 72 }, (_, i) => {
  const [x0, y0] = P(C, i * 5);
  const [x1, y1] = P(C, i * 5 + 5.4);
  return { d: `M${x0} ${y0} A${C} ${C} 0 0 1 ${x1} ${y1}`, color: specAt(i / 72) };
});

// Плашка-превью: 52 риски обода цветом своего этапа, вращаются и откликаются на курсор
const launchTicks = weeks.map((w) => {
  const s = SECTORS.find((x) => w.k >= x.from && w.k <= x.to)!;
  const a = weekAngle(w.k);
  const [x1, y1] = P(w.quarter ? 176 : 182, a);
  const [x2, y2] = P(196, a);
  return { x1, y1, x2, y2, a: +a.toFixed(2), r1: w.quarter ? 176 : 182, quarter: w.quarter, color: w.quarter ? 'var(--teal)' : mix(s.c1, s.c2) };
});

const hits = SECTORS.map((s, i) => {
  const a0 = weekAngle(s.to + 0.5);
  const a1 = weekAngle(s.from - 0.5);
  const [x0, y0] = P(212, a0);
  const [x1, y1] = P(212, a1);
  const [x2, y2] = P(C + 2, a1);
  const [x3, y3] = P(C + 2, a0);
  return { i, href: servicesHref(s.id), d: `M${x3} ${y3} L${x0} ${y0} A212 212 0 0 1 ${x1} ${y1} L${x2} ${y2} A${C + 2} ${C + 2} 0 0 0 ${x3} ${y3} Z`, ...s };
});

// Для скрипта: этапы со ссылками и текстами
const sectorData = SECTORS.map((s) => ({ ...s, href: servicesHref(s.id), questions: STAGE_QUESTIONS[s.id] }));
---

<!-- Строка над колесом: какой день и этап сейчас под стрелкой; при выборе — описание этапа -->
<div class="wheel-info" id="wheelInfo"></div>

<!-- Сцена во всю ширину карточки: круг по центру (не шире 460px — прежний размер), а полоса со стрелкой
     тянется от края карточки до круга — на широком экране она длиннее, круг не раздувается. -->
<div class="wheel-stage is-idle" id="wheelStage">
<div class="pointer-rail" aria-hidden="true"></div>
<div class="wheel-box" id="wheelBox" role="group" aria-label="Колесо продукта: итерация из 52 дней и четырёх этапов — касдев, дизайн, разработка, маркетинг">
  <!-- Вращается весь этот SVG целиком через CSS-transform: браузер растрирует его один раз
       и поворачивает на видеокарте, без перерисовки 200 элементов каждый кадр. -->
  <svg class="wheel-rotor" id="wheelRotor" viewBox="-217 -217 434 434" inert>
    <defs>
      <path id="arc" d="M125 0 A125 125 0 1 1 -125 0 A125 125 0 1 1 125 0" fill="none"></path>
    </defs>

    <g id="rotor">
      {discSectors.map((s) => <path class="sector-fill" data-sector={s.i} d={s.d} style={s.fill}></path>)}
      <g class="days">
        {dayCells.map((c) => <path class="day-cell" data-day={c.k} d={c.d} style={`fill:${c.fill};stroke:${c.fill}`}></path>)}
      </g>

      <g class="dividers">
        {crossLines.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}></line>)}
      </g>

      <g class="ticks">
        {weeks.map((w) => (
          <line
            class:list={['tick', { quarter: w.quarter }]}
            x1={w.tx1} y1={w.ty1} x2={w.tx2} y2={w.ty2}
            stroke-width={w.quarter ? 2.4 : 1.6} stroke-linecap="round"
          ></line>
        ))}
      </g>
      <g font-size="8.5" font-weight="600" class="num">
        {weeks.map((w) => (
          <text class="week" data-week={w.k} x={w.x} y={w.y} text-anchor="middle" dominant-baseline="central" transform={`rotate(${w.rot} ${w.x} ${w.y})`}>{w.label}</text>
        ))}
      </g>

      <g id="labels">
        {labels.map((l, i) => (
          <text class="sector-label" font-size="18" font-weight="600" fill={l.color} data-sector={i}>
            <textPath href="#arc" startOffset={`${l.offset}%`} text-anchor="middle">{l.name}</textPath>
          </text>
        ))}
      </g>

      <circle r={C} style="fill:var(--center-fill)"></circle>
      {rim.map((a) => <path d={a.d} fill="none" stroke={a.color} stroke-width="1.1"></path>)}

      {hits.map((h) => (
        <a href={h.href} class="sector-link" data-sector={h.i} aria-label={`${h.name}: дни ${h.from}–${h.to}. ${h.text}`}>
          <path class="sector-hit" d={h.d}></path>
        </a>
      ))}
    </g>
  </svg>

  <!-- Поле видимости обрезано по наконечнику стрелки (x = −216): без пустых полей колесо крупнее -->
  <svg class="wheel-overlay" viewBox="-217 -217 434 434" aria-hidden="true">
    <g id="pointer">
      <!-- Наконечник и начало полосы — .pointer-rail у края карточки; здесь продолжение до центра -->
      <line x1="-218" y1="0" x2={-C - 1} y2="0" style="stroke:var(--teal)" stroke-width="2.4"></line>
      <!-- Подпись над стрелкой от внешнего конца делений; по завершении круга — «цикл окончен», затем «итерация 2» и т. д. -->
      <text class="iter-tag" id="iterText" x="-199" y="-7" font-size="12" font-weight="700">итерация 1</text>
    </g>
    <!-- Центр — методология: «внимание» всегда дугой по верхнему краю (как названия этапов на ободе),
         сразу под ним такой же дугой «→ этап» — меняется только она; ровно в центре,
         как в магическом шаре, всплывают вопросы этапа.
         Вопрос — обычный HTML поверх центра (не foreignObject: Safari на iPhone рисует его
         со сдвигом, когда внутри идёт анимация). -->
    <defs>
      <path id="attnArc" d={`M${-(C - 12)} 0 A${C - 12} ${C - 12} 0 0 1 ${C - 12} 0`} fill="none"></path>
      <path id="attnArc2" d={`M${-(C - 26)} 0 A${C - 26} ${C - 26} 0 0 1 ${C - 26} 0`} fill="none"></path>
    </defs>
    <!-- Вступление: сначала крупно и жирно «внимание» в центре, затем оно уходит в дугу сверху -->
    <text class="attn" id="attn" x="0" y="7" text-anchor="middle" font-size="20" font-weight="800">внимание</text>
    <text class="attn-arc" id="attnArcText" font-size="12" font-weight="700">
      <textPath href="#attnArc" startOffset="50%" text-anchor="middle">внимание</textPath>
    </text>
    <text class="attn-to" id="attnToText" font-size="12.5" font-weight="700">
      <textPath href="#attnArc2" startOffset="50%" text-anchor="middle" id="attnTo"></textPath>
    </text>
  </svg>
  <div class="center-q" id="centerQ" aria-hidden="true"><span class="cq-text" id="cqText"></span></div>
  <!-- Превью (22.10.2026, вариант «обод из 52 дней»): плашка закрывает колесо, всё начинается по нажатию.
       Обод вращается, риски у курсора подсвечиваются; обод можно покрутить, как колесо. -->
  <button type="button" class="wheel-launch" id="wheelLaunch">
    <svg class="launch-ring" id="launchRing" viewBox="-205 -205 410 410" aria-hidden="true">
      {launchTicks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} data-a={t.a} data-r={t.r1} data-w={t.quarter ? 2.4 : 2} stroke={t.color} stroke-width={t.quarter ? 2.4 : 2} stroke-linecap="round"></line>
      ))}
    </svg>
    <span class="launch-core">
      <span class="launch-sub">52 дня · 4 этапа</span>
      <span class="launch-text">Запустить <span class="nb">колесо продукта&nbsp;<span class="launch-arrow" aria-hidden="true">→</span></span></span>
    </span>
  </button>
</div>
</div>


<script is:inline define:vars={{ sectorData }}>
  window.__wheelSectors = sectorData;
</script>

<script>
  type Sector = { id: string; name: string; from: number; to: number; text: string; href: string; c1: string; c2: string; questions: string[] };

  const box = document.getElementById('wheelBox');
  const rotorSvg = document.getElementById('wheelRotor');
  const info = document.getElementById('wheelInfo');
  const iterText = document.getElementById('iterText') as SVGTextElement | null;
  const SECTORS = (window as unknown as { __wheelSectors: Sector[] }).__wheelSectors;

  if (box && rotorSvg && info && iterText && SECTORS) {
    const STEP = 360 / 52;
    const PERIOD = 156000; // один оборот — итерация из 52 дней, ~3 с на день
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = matchMedia('(hover: hover)').matches;

    const links = [...box.querySelectorAll<SVGAElement>('.sector-link')];
    const fills = [...box.querySelectorAll<SVGPathElement>('.sector-fill')];
    const labels = [...box.querySelectorAll<SVGTextElement>('.sector-label')];
    const attnTo = document.getElementById('attnTo')!;
    const attn = document.getElementById('attn')!;
    const attnArcText = document.getElementById('attnArcText')!;
    const attnToText = document.getElementById('attnToText')!;
    const cqText = document.getElementById('cqText')!;

    // ---------- Итерация-демонстрация ----------
    // День k стоит под стрелкой при повороте (k - 0.5) * STEP; угол 0 — начало итерации у стрелки.
    const weekAt = (turn: number) => Math.min(52, Math.floor(turn / STEP) + 1);
    const sectorOf = (week: number) => SECTORS.findIndex((s) => week >= s.from && week <= s.to);
    const weekEls = [...box.querySelectorAll<SVGTextElement>('.week')];
    let simWeek = 1;
    let simSector = 0;

    // Закрашенные дни: от первого до текущего включительно
    const dayEls = [...box.querySelectorAll<SVGPathElement>('.day-cell')];
    const paintDays = (upTo: number) => dayEls.forEach((el, i) => el.classList.toggle('is-done', i < upTo));


    const setTag = (text: string) => {
      iterText.textContent = text;
    };
    // ---------- Центр: вопрос этапа ----------
    // По ходу итерации вопрос привязан ко дню: 13 дней этапа делятся на 4 вопроса (~9 с каждый).
    // При наведении или выборе — вопросы этого этапа по очереди, раз в 3 с.
    let shown = '';
    let shownStage = -1;
    let hoverQ = 0;
    let centerReady = false; // пока идёт вступление «внимание», этап и вопросы не показываем
    const questionFor = (i: number) => {
      const q = SECTORS[i].questions;
      if (active() !== null) return q[hoverQ % q.length];
      const dayInStage = simWeek - SECTORS[i].from; // 0..12
      return q[Math.min(q.length - 1, Math.floor((dayInStage * q.length) / 13))];
    };
    // Перезапуск CSS-анимации: снять класс, дать браузеру заметить, вернуть
    const replay = (el: Element, cls: string) => {
      el.classList.remove(cls);
      void (el as HTMLElement).getBoundingClientRect();
      el.classList.add(cls);
    };
    function showCenter() {
      if (!centerReady) return;
      const i = active() ?? simSector;
      const s = SECTORS[i];
      if (i !== shownStage) {
        shownStage = i;
        attnTo.textContent = `→ ${s.name}`;
        attnToText.style.fill = s.c1;
        if (!reduce) replay(attnToText, 'is-in');
      }
      const text = questionFor(i);
      const key = `${i}|${text}`;
      if (key === shown) return;
      const first = shown === '';
      shown = key;
      const apply = () => {
        cqText.textContent = text;
        cqText.classList.remove('is-out');
        if (!reduce) replay(cqText, 'is-rise');
      };
      if (first || reduce) return apply();
      // Старый вопрос тает и уходит вверх, новый всплывает снизу
      cqText.classList.add('is-out');
      window.setTimeout(apply, 350);
    }

    // Вступление: крупное «внимание» ~2 с → уходит вверх в дугу → «→ этап» и первый вопрос
    let centerStarted = false;
    // onGo — момент, когда «внимание» уходит вверх: с него колесо начинает вращаться
    function startCenter(onGo?: () => void) {
      if (centerStarted) return;
      centerStarted = true;
      const finish = () => {
        onGo?.();
        attn.classList.add('is-up');
        attnArcText.classList.add('is-in');
        centerReady = true;
        showCenter();
      };
      if (reduce) return finish();
      attn.classList.add('is-show');
      window.setTimeout(() => {
        attn.classList.add('is-up');
        onGo?.();
        window.setTimeout(() => attnArcText.classList.add('is-in'), 300);
        window.setTimeout(() => {
          centerReady = true;
          showCenter();
        }, 800);
      }, 2000);
    }

    window.setInterval(() => {
      if (active() === null) return;
      hoverQ += 1;
      showCenter();
    }, 3000);

    let doneUntil = 0; // пока показываем «цикл окончен»
    let iteration = 1; // считаем круги, пока страница открыта; после обновления — снова с 1

    // ---------- Вращение ----------
    const sectorAngle = (i: number) => ((SECTORS[i].from + SECTORS[i].to) / 2 - 0.5) * STEP;
    let ambient: Animation | null = null;

    const setAngle = (a: number) => (rotorSvg.style.transform = `rotate(${a}deg)`);
    const currentAngle = () => {
      const m = new DOMMatrixReadOnly(getComputedStyle(rotorSvg).transform);
      return (Math.atan2(m.b, m.a) * 180) / Math.PI;
    };
    const startAmbient = (from: number) => {
      ambient?.cancel();
      setAngle(from);
      if (reduce) return;
      ambient = rotorSvg.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${from + 360}deg)` }], {
        duration: PERIOD,
        iterations: Infinity,
      });
    };
    // Продолжить вращение после наведения; до конца паузы на «внимании» колесо не трогаем
    let rolling = false;
    const resume = () => {
      if (ambient) ambient.play();
      else if (rolling) startAmbient(currentAngle());
    };
    // Спокойная доводка по кратчайшему пути, без пружин
    const turnTo = (target: number, duration: number, done?: (a: number) => void) => {
      const from = currentAngle();
      ambient?.cancel();
      ambient = null;
      const delta = ((((target - from) % 360) + 540) % 360) - 180;
      const to = from + delta;
      setAngle(to);
      if (reduce || duration === 0) return done?.(to);
      const a = rotorSvg.animate([{ transform: `rotate(${from}deg)` }, { transform: `rotate(${to}deg)` }], {
        duration,
        easing: 'cubic-bezier(.45,0,.2,1)',
      });
      a.onfinish = () => done?.(to);
    };

    // ---------- Состояние ----------
    let hovered: number | null = null; // мышь — только подсветка
    let selected: number | null = null; // касание и клавиатура — подсветка + доводка под стрелку
    // Выбор с клавиатуры или касанием главнее наведения мыши
    const active = () => selected ?? hovered;
    const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

    let lastActive: number | null = null;
    function render() {
      const i = active();
      if (i !== lastActive) {
        hoverQ = 0;
        lastActive = i;
      }
      box.classList.toggle('has-active', i !== null);
      fills.forEach((el, j) => el.classList.toggle('is-active', i === j));
      labels.forEach((el, j) => el.classList.toggle('is-active', i === j));
      showCenter();

      // Бегущий день экранный диктор не зачитывает — только выбор этапа
      info.setAttribute('aria-live', i === null ? 'off' : 'polite');
      if (i === null) {
        const line = performance.now() < doneUntil
          ? `<b>Цикл окончен</b> · начинаем итерацию&nbsp;${iteration}`
          : `<b>День&nbsp;${simWeek}</b> из 52 · идёт <b>${SECTORS[simSector].name}</b>`;
        info.innerHTML = `<p class="info-line">${line}</p>`;
        return;
      }
      const s = SECTORS[i];
      // Одна строка, как и без выбора: высота не меняется — колесо не прыгает под курсором
      info.innerHTML =
        `<p class="info-line"><b>${cap(s.name)}</b> · дни ${s.from}–${s.to} · ` +
        `<a class="info-more" href="${s.href}" aria-label="Подробнее об этапе «${s.name}»">Подробнее&nbsp;→</a></p>`;
    }

    function select(i: number) {
      selected = i;
      hovered = null;
      render();
      turnTo(sectorAngle(i), 800);
    }
    function clear() {
      if (selected === null && hovered === null) return;
      const wasSelected = selected !== null;
      selected = null;
      hovered = null;
      render();
      if (wasSelected) startAmbient(currentAngle());
      else resume();
    }

    // ---------- События ----------
    let lastPointer = 'mouse';
    // Чем человек пользуется сейчас: фокус от клавиатуры доворачивает этап, фокус от клика — нет
    let keyboard = false;
    document.addEventListener('keydown', () => (keyboard = true), true);
    document.addEventListener('pointerdown', () => (keyboard = false), true);
    // Колесо может провернуться под неподвижным курсором — считаем наведением только реальное движение мыши
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' && (e.movementX || e.movementY)) keyboard = false;
    }, true);
    links.forEach((link) => {
      const i = Number(link.dataset.sector);
      link.addEventListener('pointerdown', (e) => (lastPointer = e.pointerType));
      link.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || keyboard) return;
        hovered = i;
        ambient?.pause();
        render();
      });
      // Касание: первое выбирает этап, второе открывает страницу
      link.addEventListener('click', (e) => {
        if (lastPointer === 'touch' && selected !== i) {
          e.preventDefault();
          select(i);
        }
      });
      link.addEventListener('focus', () => {
        if (keyboard || link.matches(':focus-visible')) select(i);
      });
    });

    box.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || hovered === null) return;
      hovered = null;
      render();
      if (selected === null) resume();
    });

    box.addEventListener('keydown', (e) => {
      const idx = links.findIndex((l) => l === document.activeElement);
      if (e.key === 'Escape') {
        (document.activeElement as HTMLElement | null)?.blur();
        clear();
        return;
      }
      if (idx < 0) return;
      // По часовой — следующий этап цикла
      const next = ({ ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 } as Record<string, number>)[e.key];
      if (next) {
        e.preventDefault();
        const j = (idx + next + links.length) % links.length;
        links[j].focus();
        select(j);
      }
    });
    box.addEventListener('focusout', (e) => {
      if (!box.contains(e.relatedTarget as Node)) clear();
    });
    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' && !box.contains(e.target as Node) && !info.contains(e.target as Node)) clear();
    });

    // ---------- Ход итерации: что под стрелкой, шкала, завершение круга ----------
    let prevTurn = 0;
    function tick() {
      const turn = ((currentAngle() % 360) + 360) % 360;
      // Круг замкнулся: шли вперёд и перевалили через начало итерации
      if (ambient?.playState === 'running' && prevTurn > 300 && turn < 60) {
        doneUntil = performance.now() + 4000;
        iteration += 1;
        setTag('цикл окончен');
        window.setTimeout(() => {
          setTag(`итерация ${iteration}`);
          render();
        }, 4000);
      }
      prevTurn = turn;

      const week = weekAt(turn);
      if (week !== simWeek) {
        weekEls[simWeek - 1]?.classList.remove('is-today');
        weekEls[week - 1]?.classList.add('is-today');
        simWeek = week;
        paintDays(week);
        const sec = sectorOf(week);
        if (sec !== simSector) {
          labels[simSector]?.classList.remove('is-now');
          labels[sec]?.classList.add('is-now');
          simSector = sec;
        }
        if (active() === null) render();
      }
    }

    // ---------- Вход: итерация начинается с первого дня ----------
    weekEls[0]?.classList.add('is-today');
    labels[0]?.classList.add('is-now');
    paintDays(1);
    setTag(`итерация ${iteration}`);
    render();
    setAngle(0);

    // ---------- Превью: колесо скрыто под плашкой, запуск по нажатию ----------
    const stage = document.getElementById('wheelStage')!;
    const launch = document.getElementById('wheelLaunch') as HTMLButtonElement;
    let idle = true;

    // Обод плашки: вращается сам (оборот 156 с, как колесо), при наведении плавно ускоряется,
    // риски у курсора подсвечиваются; обод можно потянуть пальцем/мышью — после отпускания он
    // докатывается и возвращается к спокойной скорости. Короткое нажатие — запуск.
    const ring = document.getElementById('launchRing')!;
    const ticks = [...ring.querySelectorAll<SVGLineElement>('line')].map((el) => ({
      el,
      a: Number(el.dataset.a),
      r: Number(el.dataset.r),
      w: Number(el.dataset.w),
      cos: Math.cos((Number(el.dataset.a) * Math.PI) / 180),
      sin: Math.sin((Number(el.dataset.a) * Math.PI) / 180),
    }));
    const BASE = 360 / PERIOD; // градусов в миллисекунду
    let ringAngle = 0;
    let speed = reduce ? 0 : BASE;
    let boost = false; // наведение или фокус
    let light = 0; // сила подсветки у курсора, 0..1
    let pointerAt: number | null = null; // угол указателя на экране
    let ringDrag: { id: number; last: number; t: number; moved: boolean } | null = null;
    let lastT = performance.now();
    const pointerAngle = (e: PointerEvent) => {
      const r = launch.getBoundingClientRect();
      return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
    };
    const wrap = (d: number) => ((d % 360) + 540) % 360 - 180;
    function ringFrame(t: number) {
      if (!idle) return;
      const dt = Math.min(64, t - lastT);
      lastT = t;
      if (!ringDrag && !reduce) {
        // к целевой скорости — плавно, без рывков (~0,6 с)
        const target = boost ? BASE * 8 : BASE;
        speed += (target - speed) * Math.min(1, dt / 300);
        ringAngle += speed * dt;
      }
      light += ((pointerAt !== null ? 1 : 0) - light) * Math.min(1, dt / 200);
      ring.style.transform = `rotate(${ringAngle}deg)`;
      for (const k of ticks) {
        let f = 0;
        if (pointerAt !== null || light > 0.01) {
          const d = Math.abs(wrap((pointerAt ?? 0) - (k.a + ringAngle)));
          f = Math.max(0, 1 - d / 40) ** 2 * light;
        }
        // у курсора риска ярче, толще и длиннее внутрь
        const r1 = k.r - 16 * f;
        k.el.style.opacity = String(0.45 + 0.55 * f);
        k.el.setAttribute('stroke-width', String(+(k.w * (1 + f)).toFixed(2)));
        k.el.setAttribute('x1', (r1 * k.cos).toFixed(2));
        k.el.setAttribute('y1', (r1 * k.sin).toFixed(2));
      }
      requestAnimationFrame(ringFrame);
    }
    requestAnimationFrame(ringFrame);

    launch.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') boost = true;
    });
    launch.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') boost = false;
      if (!ringDrag) pointerAt = null;
    });
    launch.addEventListener('focus', () => {
      if (launch.matches(':focus-visible')) boost = true;
    });
    launch.addEventListener('blur', () => (boost = false));
    launch.addEventListener('pointerdown', (e) => {
      pointerAt = pointerAngle(e);
      ringDrag = { id: e.pointerId, last: pointerAt, t: performance.now(), moved: false };
    });
    launch.addEventListener('pointermove', (e) => {
      const p = pointerAngle(e);
      pointerAt = p;
      if (!ringDrag || e.pointerId !== ringDrag.id) return;
      const d = wrap(p - ringDrag.last);
      if (!ringDrag.moved && Math.abs(d) < 4) return;
      if (!ringDrag.moved) {
        ringDrag.moved = true;
        try {
          launch.setPointerCapture(e.pointerId);
        } catch {
          /* без захвата тоже работает */
        }
      }
      const now = performance.now();
      ringAngle += d;
      // скорость пальца — чтобы после отпускания обод докатился
      speed = d / Math.max(16, now - ringDrag.t);
      ringDrag.last = p;
      ringDrag.t = now;
      e.preventDefault();
    });
    const ringRelease = (e: PointerEvent) => {
      if (!ringDrag || e.pointerId !== ringDrag.id) return;
      const moved = ringDrag.moved;
      ringDrag = null;
      if (e.pointerType !== 'mouse') pointerAt = null;
      // после перетаскивания не запускать
      if (moved) launch.addEventListener('click', (ev) => ev.stopImmediatePropagation(), { capture: true, once: true });
    };
    launch.addEventListener('pointerup', ringRelease);
    launch.addEventListener('pointercancel', ringRelease);

    launch.addEventListener('click', () => {
      if (!idle) return;
      idle = false;
      stage.classList.remove('is-idle');
      rotorSvg.removeAttribute('inert');
      launch.classList.add('is-gone');
      launch.addEventListener('transitionend', () => launch.remove(), { once: true });
      if (reduce) launch.remove();
      // фокус остаётся на колесе, а не теряется вместе с кнопкой; дальше Tab — по этапам
      box.tabIndex = -1;
      box.focus({ preventScroll: true });
      tick();
      // 10 раз в секунду хватает: шкала сдвигается на ~0,2° за шаг, глазом не видно
      if (!reduce) window.setInterval(tick, 100);
      // Пауза на «внимании» 2 с: колесо стоит, вращение — когда слово уходит вверх.
      // Если колесо уже успели покрутить или выбрали этап — не перебиваем.
      startCenter(() => {
        rolling = true;
        if (!ambient && selected === null && hovered === null) startAmbient(currentAngle());
      });
    });

    // «Покрути колесо» (выбрано владельцем 21.10.2026): тянешь — колесо поворачивается за пальцем/мышью,
    // отпустил — спокойное вращение продолжается с этого места. Короткое касание остаётся кликом.
    if (!reduce) {
      box.classList.add('can-spin');
      let drag: { id: number; start: number; from: number; moved: boolean } | null = null;
      const angleAt = (e: PointerEvent) => {
        const r = box.getBoundingClientRect();
        return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
      };
      box.addEventListener('pointerdown', (e) => {
        if (idle) return;
        drag = { id: e.pointerId, start: angleAt(e), from: currentAngle(), moved: false };
      });
      box.addEventListener('pointermove', (e) => {
        if (!drag || e.pointerId !== drag.id) return;
        let d = angleAt(e) - drag.start;
        d = ((d + 540) % 360) - 180;
        if (!drag.moved && Math.abs(d) < 4) return;
        if (!drag.moved) {
          drag.moved = true;
          try {
            box.setPointerCapture(e.pointerId);
          } catch {
            /* без захвата тоже работает, пока указатель над колесом */
          }
          ambient?.cancel();
          ambient = null;
          selected = hovered = null;
          render();
        }
        setAngle(drag.from + d);
        e.preventDefault();
      });
      const release = (e: PointerEvent) => {
        if (!drag || e.pointerId !== drag.id) return;
        const moved = drag.moved;
        drag = null;
        if (moved) {
          startAmbient(currentAngle());
          // после перетаскивания не открывать этап, на котором отпустили
          box.addEventListener('click', (ev) => ev.preventDefault(), { capture: true, once: true });
        }
      };
      box.addEventListener('pointerup', release);
      box.addEventListener('pointercancel', release);
    }

  }
</script>

<style>
  /* Сцена во всю ширину карточки: 14px — горизонтальный отступ .wheel-card в index.astro.
     --wb — ширина круга: на телефоне вся ширина, на компьютере не больше 460px (прежний размер). */
  .wheel-stage {
    --wb: min(100%, 460px);
    position: relative;
    width: calc(100% + 28px);
    margin-inline: -14px;
  }
  /* Полоса от края карточки до круга с наконечником у края */
  .pointer-rail {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 1;
    width: calc((100% - var(--wb)) / 2 + 2px);
    height: 2.5px;
    transform: translateY(-50%);
    background: var(--teal);
    pointer-events: none;
  }
  .pointer-rail::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    border-style: solid;
    border-width: 7px 0 7px 13px;
    border-color: transparent transparent transparent var(--teal);
  }
  @media (max-width: 520px) {
    .pointer-rail {
      height: 2px;
    }
    .pointer-rail::before {
      border-width: 5.6px 0 5.6px 10.5px;
    }
  }
  .wheel-box {
    position: relative;
    /* Единицы cqw — доли ширины колеса: текст в центре масштабируется вместе с SVG (434 единицы) */
    container-type: inline-size;
    width: var(--wb);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    /* Повёрнутый квадрат ротора по диагонали шире коробки — без обрезки на узком экране
       страница прокручивается вбок. Круг колеса вписан в квадрат, поэтому ничего не теряется. */
    overflow: clip;
  }
  .wheel-box svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .wheel-rotor {
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .wheel-overlay {
    pointer-events: none;
  }

  /* Сектора — едва заметная заливка этапа до края круга; при выборе выбранный чуть плотнее */
  .sector-fill {
    fill: var(--f);
    opacity: var(--disc-op);
    transition: opacity 0.4s ease, fill 0.4s ease;
  }
  .has-active .sector-fill.is-active {
    fill: var(--f-now);
  }
  /* Пройденные дни закрашиваются цветом этапа: круг заполняется по ходу итерации */
  /* обводка в цвет заливки закрывает светлые швы между соседними клиньями */
  .day-cell {
    stroke-width: 0.8;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .day-cell.is-done {
    opacity: 1;
  }
  /* «Покрути колесо»: тянуть вбок/по кругу — крутит колесо; вертикальный свайп на телефоне
     по-прежнему листает страницу (колесо почти во всю ширину экрана) */
  .can-spin {
    touch-action: pan-y;
    cursor: grab;
  }
  .can-spin:active {
    cursor: grabbing;
  }
  .has-active .day-cell.is-done {
    opacity: 0.55;
  }
  /* Разделители этапов и риски дней — тонко и нейтрально */
  .dividers line {
    stroke: var(--wheel-line);
    stroke-width: 1;
  }
  .tick {
    stroke: var(--wheel-line);
  }
  .tick.quarter {
    stroke: var(--teal);
    opacity: 0.6;
  }
  .sector-label {
    opacity: var(--label-op);
    transition: opacity 0.3s ease;
  }
  /* Текущий этап чуть заметнее остальных, но тише вопросов в центре */
  .sector-label.is-now {
    opacity: 0.75;
  }
  .has-active .sector-label {
    opacity: 0.2;
  }
  .has-active .sector-label.is-active {
    opacity: 1;
  }

  .ticks {
    opacity: var(--tick-op);
  }
  .num {
    fill: var(--teal-num);
  }
  .week.is-today {
    fill: var(--teal-text);
    font-weight: 800;
    font-size: 10.5px;
  }
  /* Подпись «итерация»: без обводки, только лёгкая тень */
  .iter-tag {
    fill: var(--teal-text);
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.18));
  }

  .sector-hit {
    fill: transparent;
    cursor: pointer;
  }
  /* Прямоугольную рамку фокуса браузера не показываем ни после клика, ни с клавиатуры:
     для клавиатуры сектор обводится пунктиром по своей форме (ниже). */
  .sector-link {
    -webkit-tap-highlight-color: transparent;
  }
  .sector-link:focus,
  .sector-link:focus-visible {
    outline: none;
  }
  .sector-link:focus-visible .sector-hit {
    stroke: var(--teal);
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }

  /* Центр. «Внимание» — главное слово методологии: всегда на месте, дугой сверху.
     Меняется только строка «→ этап»; вопросы всплывают за 0,7 с, без пружин. */
  /* Крупное жирное «внимание»: проявляется, держится ~2 с, уходит вверх и гаснет —
     на его месте проявляется дуга «внимание». Без пружин. */
  .attn {
    fill: var(--ink);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.6s ease,
      transform 0.8s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .attn.is-show {
    opacity: 1;
  }
  .attn.is-up {
    opacity: 0;
    transform: translateY(-46px) scale(0.6);
  }
  .attn-arc {
    fill: var(--ink-2);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .attn-arc.is-in {
    opacity: 1;
  }
  .attn-to.is-in {
    animation: attn-to-in 0.5s ease;
  }
  @keyframes attn-to-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  /* Блок вопроса 126×68 единиц SVG по центру круга */
  .center-q {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(126 / 434 * 100cqw);
    height: calc(68 / 434 * 100cqw);
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font);
    pointer-events: none;
  }
  .cq-text {
    display: block;
    /* Уже круга: вопрос переносится на 2 ровные строки и не липнет к краю */
    max-width: calc(108 / 434 * 100cqw);
    font-size: calc(13 / 434 * 100cqw);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      filter 0.35s ease;
  }
  .cq-text.is-out {
    opacity: 0;
    transform: translateY(-6px);
    filter: blur(2px);
  }
  /* Магический шар: вопрос поднимается из глубины и проясняется */
  .cq-text.is-rise {
    animation: cq-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes cq-rise {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.94);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  /* На телефоне колесо ~0,7 от своего размера — шрифт центра крупнее (~12 px на экране 375) */
  @media (max-width: 520px) {
    .attn {
      font-size: 25px;
    }
    .attn-arc {
      font-size: 13px;
    }
    .attn-to {
      font-size: 13.5px;
    }
    .cq-text {
      max-width: calc(116 / 434 * 100cqw);
      font-size: calc(15.5 / 434 * 100cqw);
      line-height: 1.1;
    }
  }

  /* Одна строка (на узком экране — до двух); высота постоянная, чтобы колесо не сдвигалось */
  .wheel-info {
    min-height: 2.9em;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    padding-inline: 8px;
  }
  .wheel-info {
    transition: opacity 0.6s ease;
  }
  .wheel-info:has(+ .is-idle) {
    opacity: 0;
  }
  .wheel-info :global(.info-line) {
    font-size: 15px;
    color: var(--ink);
  }
  .wheel-info :global(.info-line b) {
    font-weight: 700;
  }
  .wheel-info :global(.info-more) {
    font-weight: 600;
    color: var(--teal-text);
    text-underline-offset: 3px;
  }

  /* Превью: колесо скрыто, видна только круглая плашка «Запустить колесо продукта» */
  .wheel-rotor,
  .wheel-overlay,
  .center-q,
  .pointer-rail {
    transition:
      opacity 0.6s ease,
      filter 0.6s ease;
  }
  .wheel-stage.is-idle .wheel-rotor,
  .wheel-stage.is-idle .wheel-overlay,
  .wheel-stage.is-idle .center-q,
  .wheel-stage.is-idle .pointer-rail {
    opacity: 0;
  }
  .wheel-box:focus {
    outline: none;
  }
  /* Плашка: обод из 52 дней цветом этапов (риски — в скрипте), в центре призыв */
  .wheel-launch {
    position: absolute;
    /* круг колеса — 410 единиц из 434 */
    inset: calc(12 / 434 * 100%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 18%;
    border: 1.1px solid var(--hair);
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-card);
    font-family: var(--font);
    color: var(--ink);
    text-align: center;
    cursor: pointer;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 0.3s ease,
      border-color 0.2s ease;
  }
  .wheel-launch:hover {
    border-color: var(--teal);
  }
  .wheel-launch:focus-visible {
    outline: 2px dashed var(--teal);
    outline-offset: 4px;
  }
  .wheel-launch.is-gone {
    opacity: 0;
    pointer-events: none;
  }
  .wheel-box .launch-ring {
    pointer-events: none;
  }
  .launch-core {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .launch-sub {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
