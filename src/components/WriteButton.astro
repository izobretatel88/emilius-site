---
import { LINKS } from '../data/site';
---

<!-- Плавающая «Написать» на всех страницах: решился — сразу в личку в Telegram.
     Вид — как вторичная кнопка «Написать» в карточке «Связь», плюс тень плавающих элементов. -->
<!-- Отдельная область страницы: кнопка вне main и footer, программы чтения экрана находят её в списке областей -->
<aside aria-label="Быстрая связь">
  <!-- «Наверх» (замечание владельца 20.11.2026): на длинных страницах — над «Написать», появляется после двух экранов -->
  <button type="button" class="top-fab is-hidden" aria-label="Наверх страницы" tabindex="-1">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"></path></svg>
  </button>
  <a class="write-fab" href={LINKS.direct} target="_blank" rel="noopener" aria-label="Написать в Telegram, откроется в новой вкладке">
    Написать
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.4 3.2 2.9 10.4c-1 .4-1 1.6 0 1.9l4.7 1.5 1.8 5.6c.3.8 1.3 1 1.9.4l2.6-2.5 4.9 3.6c.7.5 1.7.1 1.9-.7L23 4.5c.2-1-.7-1.7-1.6-1.3ZM9.6 14.3l8.7-7.7-6.9 9.3-.3 3-1.5-4.6Z"></path></svg>
  </a>
</aside>

<script>
  const toTop = document.querySelector<HTMLButtonElement>('.top-fab');
  if (toTop) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let shown = false;
    const sync = () => {
      // на телефоне плашка cookie занимает низ экрана — кнопка ждёт «Понятно», как и «Написать»
      const cookie = matchMedia('(max-width: 600px)').matches && document.documentElement.classList.contains('cookie-open');
      const show = scrollY > innerHeight * 2 && !cookie && !document.querySelector('.nav-menu[open]');
      if (show === shown) return;
      shown = show;
      toTop.classList.toggle('is-hidden', !show);
      toTop.tabIndex = show ? 0 : -1;
    };
    addEventListener('scroll', sync, { passive: true });
    document.addEventListener('emi:menu', sync);
    document.addEventListener('emi:cookie', sync);
    sync();
    toTop.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
      // фокус — на начало страницы, чтобы Tab продолжался сверху, а не от исчезнувшей кнопки
      const start = document.querySelector<HTMLElement>('.site-nav .wordmark, main');
      start?.focus({ preventScroll: true });
    });
  }
  const fab = document.querySelector<HTMLAnchorElement>('.write-fab');
  if (fab) {
    // Пока на экране ссылка страницы в тот же чат («Написать» в «Связи», на 404, «Обсудить в Telegram» на этапах,
    // «пришлите ссылку на кабинет» на лендинге) — плавающая не дублирует её.
    // Кнопка отправки формы на экране — тоже прячемся: на телефоне плавающая закрывала «Отправить».
    const twins = [...document.querySelectorAll<HTMLElement>(`main a[href="${fab.getAttribute('href')}"], main form button[type="submit"]`)];
    const protectedSections = [...document.querySelectorAll('[data-hide-write-button]')];
    const compact = matchMedia('(max-width: 480px)');
    // Пока открыта плашка о cookie, на телефоне она занимает низ экрана — кнопка ждёт «Понятно»
    const phone = matchMedia('(max-width: 600px)');
    const cookieOpen = () => phone.matches && document.documentElement.classList.contains('cookie-open');
    const seen = new Set<Element>();
    let typing = false;
    // Таблицы сравнения (think-different, итерация 129): на экранах до ~1440 px кнопка стояла поверх последней колонки
    // и закрывала статусы и «Источник ↗» KIT и OpenCart. Пока низ экрана над таблицей: помещается круглая иконка
    // рядом с таблицей — сжимаемся до неё, не помещается — прячемся до конца таблицы. На 1920 px всё как было.
    // С итерации 130 — все таблицы страницы: в статьях на телефоне и планшете кнопка закрывала суммы
    // («11 880 ₽», «67 320 ₽» — они прижаты вправо), на лендинге при 768 и 1280 px — ячейку «Google».
    const tables = [...document.querySelectorAll<HTMLElement>('main table')];
    let overTable: 'none' | 'compact' | 'hide' = 'none';
    const measureTables = () => {
      if (!tables.length) return;
      const vw = document.documentElement.clientWidth, vh = innerHeight, gap = 8;
      const right = vw - 16, band = [vh - 16 - 48, vh - 16];
      const wide = fab.classList.contains('is-compact') ? fullWidth : fab.offsetWidth;
      let next: typeof overTable = 'none';
      for (const t of tables) {
        // Видимая часть таблицы: на узких экранах она листается внутри своей рамки
        const r = t.getBoundingClientRect(), box = (t.closest('.scroll, .table-wrap') ?? t).getBoundingClientRect();
        const top = Math.max(r.top, box.top), bottom = Math.min(r.bottom, box.bottom);
        if (bottom <= band[0] || top >= band[1] || t.hidden || t.closest('[hidden]')) continue;
        const edge = Math.min(r.right, box.right, vw);
        next = edge + gap <= right - wide ? 'none' : edge + gap <= right - 48 ? 'compact' : 'hide';
        if (next !== 'none') break;
      }
      if (next !== overTable) { overTable = next; update(); }
    };
    const fullWidth = fab.offsetWidth;
    const update = () => {
      const sectionVisible = compact.matches && protectedSections.some(section => seen.has(section));
      const contactVisible = twins.some(twin => seen.has(twin));
      fab.classList.toggle('is-compact', overTable === 'compact');
      fab.classList.toggle('is-hidden', overTable === 'hide' || sectionVisible || contactVisible || typing || cookieOpen() || !!document.querySelector('.mobile-menu[open]'));
    };
    if (tables.length) {
      let queued = false;
      const queue = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; measureTables(); }); } };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      // Таблица на телефоне листается внутри своей рамки — её прокрутка тоже двигает строки под кнопкой
      document.querySelectorAll('.platform-comparison .scroll, main .table-wrap').forEach((el) => el.addEventListener('scroll', queue, { passive: true }));
      measureTables();
    }
    document.addEventListener('emi:menu', update);
    document.addEventListener('emi:cookie', update);
    phone.addEventListener('change', update);
    update();
    if (protectedSections.length) compact.addEventListener('change', update);
    const observed = [...twins, ...protectedSections];
    if (observed.length) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => (entry.isIntersecting ? seen.add(entry.target) : seen.delete(entry.target)));
        update();
      });
      observed.forEach(element => io.observe(element));
    }
    // На телефоне, пока человек заполняет форму, кнопка не лезет поверх поля и клавиатуры.
    if (matchMedia('(pointer: coarse)').matches) {
      const isField = (el: EventTarget | null) => el instanceof HTMLElement && el.matches('input, textarea, select');
      addEventListener('focusin', (e) => { typing = isField(e.target); update(); });
      addEventListener('focusout', () => { typing = false; update(); });
    }
  }
</script>

<style>
  .write-fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40; /* под заставкой и меткой dev */
    height: 48px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: 18px 14px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-btn);
    background: var(--card);
    box-shadow: var(--shadow-pop);
    color: var(--ink);
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover), opacity var(--hover), visibility var(--hover), transform var(--press);
  }
  .write-fab:active { transform: scale(var(--press-scale)); }
  /* Круглая кнопка «Наверх» над «Написать»: та же поверхность и тень, рамка тише — главное действие остаётся «Написать» */
  .top-fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: calc(max(16px, env(safe-area-inset-bottom)) + 60px);
    z-index: 40;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--hair);
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-pop);
    color: var(--ink);
    cursor: pointer;
    transition: color var(--hover), border-color var(--hover), opacity var(--hover), visibility var(--hover), transform var(--press);
  }
  .top-fab svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .top-fab:active { transform: scale(var(--press-scale)); }
  @media (hover: hover) and (pointer: fine) { .top-fab:hover { color: var(--teal-text); border-color: var(--teal); } }
  .top-fab:focus-visible { outline: var(--focus-ring); outline-offset: 3px; }
  .top-fab.is-hidden { opacity: 0; visibility: hidden; }
  .write-fab svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: var(--ink);
    transition: fill var(--hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .write-fab:hover {
      background: var(--teal-btn-hover);
      border-color: var(--teal-btn-hover);
      color: var(--on-teal);
    }
    .write-fab:hover svg {
      fill: var(--on-teal);
    }
  }
  .write-fab:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  /* Над таблицей сравнения — только иконка, как на телефоне (итерация 129) */
  .write-fab.is-compact { width: 48px; justify-content: center; padding: 0; font-size: 0; gap: 0; }
  .write-fab.is-hidden {
    opacity: 0;
    visibility: hidden;
  }
  /* Плашка cookie на телефоне: кнопка не показывается вовсе, пока плашка открыта (think-different, итерация 97).
     Класс ставит встроенный скрипт плашки сразу при разборе страницы. Раньше кнопку прятал модульный скрипт
     через 0,4–0,5 с: она появлялась, плашка наплывала на неё, и только потом кнопка гасла. */
  @media (max-width: 600px) {
    :global(html.cookie-open) .write-fab {
      opacity: 0;
      visibility: hidden;
    }
  }
  /* Низ страницы (футер) не уходит под кнопку */
  :global(body) {
    padding-bottom: 88px;
  }
  /* Элемент, к которому перешли с клавиатуры, встаёт выше кнопки, а не под неё */
  :global(html) {
    scroll-padding-bottom: 80px;
  }
  @media(max-width:480px){.write-fab{width:48px;justify-content:center;padding:0;font-size:0;gap:0}.write-fab svg{width:22px;height:22px}}
</style>
