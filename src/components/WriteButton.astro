---
import { LINKS } from '../data/site';
---

<!-- Плавающая «Написать» на всех страницах: решился — сразу в личку в Telegram.
     Вид — как вторичная кнопка «Написать» в карточке «Связь», плюс тень плавающих элементов. -->
<!-- Отдельная область страницы: кнопка вне main и footer, программы чтения экрана находят её в списке областей -->
<aside aria-label="Быстрая связь">
  <a class="write-fab" href={LINKS.direct} target="_blank" rel="noopener" aria-label="Написать в Telegram, откроется в новой вкладке">
    Написать
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.4 3.2 2.9 10.4c-1 .4-1 1.6 0 1.9l4.7 1.5 1.8 5.6c.3.8 1.3 1 1.9.4l2.6-2.5 4.9 3.6c.7.5 1.7.1 1.9-.7L23 4.5c.2-1-.7-1.7-1.6-1.3ZM9.6 14.3l8.7-7.7-6.9 9.3-.3 3-1.5-4.6Z"></path></svg>
  </a>
</aside>

<script>
  import { stageInquiry, topicInquiry, startInquiry, projectInquiry } from '../lib/project-inquiry';
  const fab = document.querySelector<HTMLAnchorElement>('.write-fab');
  if (fab) {
    // Пока на экране ссылка страницы в тот же чат («Написать» в «Связи», на 404, «Обсудить в Telegram» на этапах,
    // «пришлите ссылку на кабинет» на лендинге) — плавающая не дублирует её. Ссылки с черновиком (?text=) — тоже двойники.
    // Кнопка отправки формы на экране — тоже прячемся: на телефоне плавающая закрывала «Отправить».
    const twins = [...document.querySelectorAll<HTMLElement>(`main a[href="${fab.getAttribute('href')}"], main a[href^="${fab.getAttribute('href')}?text="], main form button[type="submit"]`)];
    const protectedSections = [...document.querySelectorAll('[data-hide-write-button]')];
    // Черновик сообщения по теме страницы (think-different, итерация 7): Telegram открывает чат с набранным текстом.
    // Двойники выше найдены по исходному адресу — замена адреса их не ломает.
    const base = fab.href;
    // Ссылки страницы в тот же чат без текста («Написать» в «Связи», запасная ссылка у Эми) несут тот же черновик,
    // что и плавающая: какой кнопкой человек ни напишет, тема уже набрана (think-different, итерация 21)
    const plain = twins.filter((el): el is HTMLAnchorElement => el instanceof HTMLAnchorElement && el.getAttribute('href') === fab.getAttribute('href'));
    const setDraft = (text: string | null) => {
      const target = text ? `${base}?text=${encodeURIComponent(text)}` : base;
      fab.href = target;
      plain.forEach((a) => { a.href = target; });
    };
    const path = location.pathname;
    const h1 = document.querySelector('h1')?.textContent?.trim().replace(/\s+/g, ' ');
    const stage = path.match(/\/services\/(custdev|design|dev|marketing)\/$/);
    if (stage) setDraft(stageInquiry(stage[1])?.message ?? null);
    else if (/\/services\/insales-shop\/seller\/$/.test(path)) setDraft('Хочу свой сайт рядом с WB и Ozon.');
    else if (/\/services\/insales-shop\/$/.test(path)) setDraft('Хочу обсудить магазин на inSales.');
    else if (/\/compare\/insales-vs-yandex-kit\/$/.test(path)) setDraft(topicInquiry('insales-kit')?.message ?? null);
    else if (/\/compare\/ecommerce-platforms\/$/.test(path)) {
      // В черновик — что человек отметил в сравнении: режим расчёта и важное бизнесу (think-different, итерация 25)
      const topic = topicInquiry('platform')?.message ?? '';
      const compareDraft = () => {
        const mode = document.querySelector('[data-mode][aria-pressed="true"]')?.textContent?.trim();
        const needs = [...document.querySelectorAll('#chips [aria-pressed="true"]')].map((b) => b.textContent?.trim()).filter(Boolean);
        return [topic, mode && `Стоимость для: ${mode}.`, needs.length && `Важно: ${needs.join(', ')}.`].filter(Boolean).join(' ');
      };
      setDraft(topic);
      ['pointerdown', 'focus', 'click'].forEach((type) => fab.addEventListener(type, () => setDraft(compareDraft()), true));
    }
    else if (/\/blog\/[^/]+\/$/.test(path) && h1) setDraft(`Вопрос по статье «${h1}».`);
    // Калькулятор: в черновик — расчёт с экрана, чтобы не пересказывать его в чате (think-different, итерация 22).
    // Собираем в момент нажатия: человек мог поменять ответы.
    else if (/\/tools\/insales-calculator\/$/.test(path)) {
      const calcDraft = () => {
        const text = (sel: string) => document.querySelector(sel)?.textContent?.trim().replace(/\s+/g, ' ') ?? '';
        const params = [...document.querySelectorAll('.calc-summary dl > div')]
          .map((row) => `${row.querySelector('dt')?.textContent?.trim()}: ${row.querySelector('dd')?.textContent?.trim()}`)
          .join('; ');
        return `Расчёт из калькулятора: пакет ${text('#calc-package')}, ${text('#calc-price')}, ${text('#calc-weeks').replace(/^О/, 'о').replace(/\.$/, '')}. ${params}. Хочу обсудить.`;
      };
      ['pointerdown', 'focus', 'click'].forEach((type) => fab.addEventListener(type, () => setDraft(calcDraft()), true));
    }
    // Лендинги inSales: если человек менял ответы расчёта, «Написать» добавляет его ориентир (think-different, итерация 42).
    // Пока ответы не трогали, ориентир по умолчанию не выдаём за расчёт человека.
    const leadPkg = document.querySelector('[data-out="pkg"]');
    const leadForm = document.querySelector('#lead form');
    if (leadPkg && leadForm) {
      let touched = false;
      leadForm.addEventListener('change', () => { touched = true; });
      const pageDraft = new URL(fab.href).searchParams.get('text') ?? '';
      const read = (key: string) => document.querySelector(`[data-out="${key}"]`)?.textContent?.trim().replace(/\s+/g, ' ') ?? '';
      ['pointerdown', 'focus', 'click'].forEach((type) => fab.addEventListener(type, () => {
        if (touched) setDraft(`${pageDraft} Ориентир с сайта: пакет ${read('pkg')}, ${read('price')}, ${read('weeks')}.`.trim());
      }, true));
    }
    // Галерея: после просмотра проекта в окне «Написать» несёт «Хочу похожий магазин, как …» (think-different, итерация 41).
    // Окно само ставит проект в адрес своей кнопки «Хочу похожий» — следим за ним.
    const viewerInquiry = document.querySelector<HTMLAnchorElement>('.viewer-inquiry');
    if (viewerInquiry) new MutationObserver(() => {
      const id = new URL(viewerInquiry.href).searchParams.get('project');
      const item = projectInquiry(id);
      if (item) setDraft(item.message);
    }).observe(viewerInquiry, { attributes: true, attributeFilter: ['href'] });
    // На главной кнопка следует за выбором в «С чего начнём?» — только после выбора самим человеком
    document.querySelectorAll<HTMLInputElement>('[data-entry] input[name="entry"]').forEach((input) =>
      input.addEventListener('change', () => setDraft(startInquiry(input.value)?.message ?? null)));
    const compact = matchMedia('(max-width: 480px)');
    // Пока открыта плашка о cookie, на телефоне она занимает низ экрана — кнопка ждёт «Понятно»
    const phone = matchMedia('(max-width: 600px)');
    const cookieOpen = () => phone.matches && document.documentElement.classList.contains('cookie-open');
    const seen = new Set<Element>();
    let typing = false;
    const update = () => {
      const sectionVisible = compact.matches && protectedSections.some(section => seen.has(section));
      const contactVisible = twins.some(twin => seen.has(twin));
      fab.classList.toggle('is-hidden', sectionVisible || contactVisible || typing || cookieOpen() || !!document.querySelector('.mobile-menu[open]'));
    };
    document.addEventListener('emi:menu', update);
    document.addEventListener('emi:cookie', update);
    phone.addEventListener('change', update);
    update();
    if (protectedSections.length) compact.addEventListener('change', update);
    const observed = [...twins, ...protectedSections];
    if (observed.length) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => (entry.isIntersecting ? seen.add(entry.target) : seen.delete(entry.target)));
        update();
      });
      observed.forEach(element => io.observe(element));
    }
    // На телефоне, пока человек заполняет форму, кнопка не лезет поверх поля и клавиатуры.
    if (matchMedia('(pointer: coarse)').matches) {
      const isField = (el: EventTarget | null) => el instanceof HTMLElement && el.matches('input, textarea, select');
      addEventListener('focusin', (e) => { typing = isField(e.target); update(); });
      addEventListener('focusout', () => { typing = false; update(); });
    }
  }
</script>

<style>
  .write-fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40; /* под заставкой и меткой dev */
    height: 48px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: 18px 14px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-btn);
    background: var(--card);
    box-shadow: var(--shadow-pop);
    color: var(--ink);
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover), opacity var(--hover), visibility var(--hover), transform var(--press);
  }
  .write-fab:active { transform: scale(var(--press-scale)); }
  .write-fab svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: var(--ink);
    transition: fill var(--hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .write-fab:hover {
      background: var(--teal-btn-hover);
      border-color: var(--teal-btn-hover);
      color: var(--on-teal);
    }
    .write-fab:hover svg {
      fill: var(--on-teal);
    }
  }
  .write-fab:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  .write-fab.is-hidden {
    opacity: 0;
    visibility: hidden;
  }
  /* Низ страницы (футер) не уходит под кнопку */
  :global(body) {
    padding-bottom: 88px;
  }
  /* Элемент, к которому перешли с клавиатуры, встаёт выше кнопки, а не под неё */
  :global(html) {
    scroll-padding-bottom: 80px;
  }
  @media(max-width:480px){.write-fab{width:48px;justify-content:center;padding:0;font-size:0;gap:0}.write-fab svg{width:22px;height:22px}}
</style>
