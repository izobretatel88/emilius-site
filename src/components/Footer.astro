---
import { ITERATION, LINKS } from '../data/site';
import { OPERATOR } from '../data/legal';
import { getPosts } from '../lib/blog';
import { DIRECTIONS } from '../data/navigation';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const year = new Date().getFullYear();
// Ссылка на блог появляется, когда в нём есть публикуемые статьи
const hasBlog = (await getPosts()).length > 0;
---

<footer>
  <nav class="footer-links" aria-label="Разделы сайта">
    {DIRECTIONS.map(item => <a href={href(item.href)}>{item.title}</a>)}
    <a href={href('services/insales-shop/')}>Магазин на InSales</a>
    <a href={href('projects/')}>Проекты</a><a href={href('resources/')}>Полезное</a>
    <a href={href('compare/')}>Сравнения</a><a href={href('tools/insales-calculator/')}>Калькулятор</a>
    {hasBlog && <a href={href('blog/')}>Блог</a>}
    <a href={href('#t-contact')}>Контакты</a>
  </nav>
  <p>© {year} | Emilius Agency</p>
  <p class="legal">{OPERATOR.short} · ИНН {OPERATOR.inn} · <a href={href('privacy/')}>Конфиденциальность</a> · <a href={href('consent/')}>Согласие</a> · <a href={href('meetings/')}>Emilius Meetings</a></p>
  <p>Итерация {ITERATION.current} из {ITERATION.total} до великолепного состояния</p>
  <!-- Ассоциация ARDA — в самом низу и мельче (решение владельца 23.10.2026) -->
  <a href={LINKS.arda} target="_blank" rel="noopener" class="arda">
    <img src={href('brand/arda.png')} alt="ARDA — Ассоциация Развития Digital Агентств" width="104" height="49" loading="lazy" />
  </a>
</footer>

<style>
  .footer-links{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 20px;max-width:960px;margin:18px auto 22px;font-size:14px}.footer-links a{text-decoration:none;padding:5px 0}.footer-links a:hover{text-decoration:underline}
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--ink-2);
    text-align: center;
    padding-top: 8px;
  }
  .legal {
    font-size: 13px;
  }
  .arda {
    display: block;
    margin-top: 10px;
  }
  /* Логотип ARDA — чёрный контур на белом. В светлой теме белый фон растворяется,
     в тёмной картинка инвертируется и фон уходит в чёрный. */
  .arda img {
    display: block;
    width: 104px; /* на 15% меньше прежних 122 px */
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arda img {
      filter: invert(1);
      mix-blend-mode: screen;
    }
  }
  :global(:root[data-theme='dark']) .arda img {
    filter: invert(1);
    mix-blend-mode: screen;
  }
</style>
