---
import { ITERATION, LINKS } from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const year = new Date().getFullYear();
---

<footer>
  <a href={LINKS.arda} target="_blank" rel="noopener" class="arda">
    <img src={href('brand/arda.png')} alt="ARDA — Ассоциация Развития Digital Агентств" width="122" height="58" loading="lazy" />
  </a>
  <p>© {year} | Emilius Agency</p>
  <p>Итерация {ITERATION.current} из {ITERATION.total} до великолепного состояния</p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--ink-2);
    text-align: center;
    padding-top: 8px;
  }
  .arda {
    display: block;
    margin-bottom: 6px;
  }
  .arda img {
    display: block;
    width: 122px;
    height: auto;
    mix-blend-mode: multiply;
  }
  :global(:root[data-theme='dark']) .arda img,
  :global(html) .arda img {
    mix-blend-mode: normal;
  }
</style>
