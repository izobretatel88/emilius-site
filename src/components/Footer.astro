---
import { ITERATION, LINKS } from '../data/site';
import { OPERATOR } from '../data/legal';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const year = new Date().getFullYear();
---

<footer>
  <a href={LINKS.arda} target="_blank" rel="noopener" class="arda">
    <img src={href('brand/arda.png')} alt="ARDA — Ассоциация Развития Digital Агентств" width="122" height="58" loading="lazy" />
  </a>
  <p>© {year} | Emilius Agency</p>
  <p class="legal">{OPERATOR.short} · ИНН {OPERATOR.inn} · <a href={href('privacy/')}>Политика конфиденциальности</a></p>
  <p>Итерация {ITERATION.current} из {ITERATION.total} до великолепного состояния</p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--ink-2);
    text-align: center;
    padding-top: 8px;
  }
  .legal {
    font-size: 13px;
  }
  .arda {
    display: block;
    margin-bottom: 6px;
  }
  /* Логотип ARDA — чёрный контур на белом. В светлой теме белый фон растворяется,
     в тёмной картинка инвертируется и фон уходит в чёрный. */
  .arda img {
    display: block;
    width: 122px;
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arda img {
      filter: invert(1);
      mix-blend-mode: screen;
    }
  }
  :global(:root[data-theme='dark']) .arda img {
    filter: invert(1);
    mix-blend-mode: screen;
  }
</style>
