---
import { href } from '../lib/urls';
import { glue } from '../lib/typograph.mjs';
// stage — этап итерации (касдев, дизайн, разработка, маркетинг): точка цветом этапа у подписи, заголовок при наведении — цветом этапа
interface Props { items: {title:string;description:string;href:string;label?:string;stage?:string}[]; }
const {items} = Astro.props;
---
<ul class="link-list">{items.map(item => <li data-stage={item.stage}><a href={href(item.href)}><span>{item.label && <small>{item.stage && <i class="ui-stage-dot" aria-hidden="true"></i>}{item.label}</small>}<strong>{glue(item.title)}</strong><span class="description">{glue(item.description)}</span></span><span class="arrow" aria-hidden="true">→</span></a></li>)}</ul>
<style>
  .link-list{list-style:none;margin:0;padding:0}
  .link-list li+li{border-top:1px solid var(--hair)}
  /* Подсветка строки — подложка-псевдоэлемент (замечание владельца 20.11.2026: «как в Полезном»).
     Контейнер задаёт --list-inset — расстояние от текста до края белой поверхности, тогда подложка
     ровной полосой доходит до края карточки. Если список касается верха/низа карточки,
     --list-edge-radius повторяет её радиус у первой и последней строки. Без переменных — скруглённая плашка. */
  a{position:relative;isolation:isolate;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:23px 10px;margin-inline:-10px;text-decoration:none;color:var(--ink)}
  a::before{content:'';position:absolute;inset:0 calc(10px - var(--list-inset, 10px));z-index:-1;background:transparent;border-radius:var(--list-radius, var(--radius-sm));transition:background-color var(--hover)}
  li:first-child a::before{border-start-start-radius:var(--list-edge-radius, var(--list-radius, var(--radius-sm)));border-start-end-radius:var(--list-edge-radius, var(--list-radius, var(--radius-sm)))}
  li:last-child a::before{border-end-start-radius:var(--list-edge-radius, var(--list-radius, var(--radius-sm)));border-end-end-radius:var(--list-edge-radius, var(--list-radius, var(--radius-sm)))}
  a:focus-visible::before {background:var(--input-bg)}
  @media (hover: hover) and (pointer: fine) { a:hover::before {background:var(--input-bg)} }
  a:active::before{background:var(--page)}
  /* Белые списки-карточки в разделах (Полезное, Услуги, Сравнения): полоса до края, радиус карточки */
  :global(.directory) > .link-list, :global(.directory > section:not(.directory-callout)) > .link-list{--list-inset:26px;--list-radius:0px;--list-edge-radius:var(--radius-card)}
  a>span:first-child{min-width:0;overflow-wrap:anywhere}
  a:focus-visible strong {color:var(--stage-ink, var(--teal-text))}
  @media (hover: hover) and (pointer: fine) { a:hover strong {color:var(--stage-ink, var(--teal-text))} }
  strong{display:block;font-size:22px;font-weight:600;line-height:1.25;transition:color var(--hover)}
  .description{display:block;color:var(--ink-2);margin-top:7px;max-width:72ch;font-size:15px;line-height:1.5}
  small{display:flex;align-items:center;gap:8px;color:var(--ink-3);font-size:var(--fs-small);margin-bottom:7px}
  .arrow{color:var(--teal-text);font-size:24px;flex-shrink:0;transition:transform var(--hover)}
  /* Стрелка чуть сдвигается вперёд: строка — переход, а не просто подсветка. На телефоне — при касании */
  a:focus-visible .arrow,a:active .arrow{transform:translateX(3px)}
  @media (hover: hover) and (pointer: fine) { a:hover .arrow{transform:translateX(3px)} }
  @media (prefers-reduced-motion: reduce){.arrow{transition:none}a:focus-visible .arrow,a:active .arrow{transform:none}a:hover .arrow{transform:none}}
  @media(max-width:600px){strong{font-size:20px}a{padding-block:20px;gap:16px}.description{font-size:14px}:global(.directory) > .link-list, :global(.directory > section:not(.directory-callout)) > .link-list{--list-inset:18px}}
</style>
