---
// Список статей блога: карточка с обложкой, заголовком, описанием, датой и временем чтения.
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Footer from './Footer.astro';
import { ruDate, type Post } from '../lib/blog';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const cover = (p: string) => href(p.replace(/^\//, ''));
---

<Base
  title="Блог — Эмилиус Эдженси"
  description="Как запускать и вести интернет-магазины на InSales: тарифы, маркетплейсы, остатки, доставка, оплата — на примерах из работы агентства."
>
  <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <main class="list">
    <h1>Блог</h1>
    <p class="lead">Как запускать и вести интернет-магазины на InSales. Без воды: цены с датой проверки, примеры, что ломается и как проверить.</p>
    <ul class="posts">
      {posts.map((p) => (
        <li class="card post">
          <a href={href(`blog/${p.id}/`)} class="cover-link" tabindex="-1" aria-hidden="true">
            <img src={cover(p.data.cover)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
          </a>
          <div class="text">
            <h2><a href={href(`blog/${p.id}/`)}>{p.data.h1}</a></h2>
            <p>{p.data.description}</p>
            <p class="meta">
              {p.data.draft && <span class="draft">черновик</span>}
              <span>{ruDate(p.data.date)}</span>
              <span>{p.data.readingMinutes} мин чтения</span>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .list {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }
  h1 {
    font-size: clamp(30px, 5vw, 42px);
    line-height: 1.1;
  }
  .lead {
    margin-top: 10px;
    max-width: 56ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .posts {
    display: grid;
    gap: 20px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }
  .post {
    overflow: hidden;
  }
  .cover-link {
    display: block;
  }
  .post img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--well);
  }
  .text {
    padding: 18px clamp(18px, 4vw, 28px) 24px;
  }
  h2 {
    font-size: 22px;
    line-height: 1.22;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--teal-text);
  }
  .text p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
  }
  .text .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .draft {
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--well);
    font-weight: 700;
  }
</style>
