---
// Список статей блога: карточка с обложкой, заголовком, описанием, датой и временем чтения.
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { ruDate, type Post } from '../lib/blog';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const cover = (p: string) => href(p.replace(/^\//, ''));
---

<Base
  title="Блог — Эмилиус Эдженси"
  description="Как запускать и вести интернет-магазины на InSales: тарифы, маркетплейсы, остатки, доставка, оплата — на примерах из работы агентства."
>

  <main class="list ui-shell">
    <header class="ui-opening list-head">
    <h1 class="ui-h1">Блог</h1>
    <p class="ui-lead">Исследования, дизайн, разработка и маркетинг продуктов. Начинаем с практических материалов о запуске интернет-магазинов и работе с маркетплейсами.</p>
    </header>
    <ul class="posts">
      {posts.map((p) => (
        <li class="post ui-surface">
          <a href={href(`blog/${p.id}/`)} class="cover-link" tabindex="-1" aria-hidden="true">
            <img src={cover(p.data.cover)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
          </a>
          <div class="text">
            <h2><a href={href(`blog/${p.id}/`)}>{p.data.h1}</a></h2>
            <p>{p.data.description}</p>
            <p class="meta">
              {p.data.draft && <span class="draft">черновик</span>}
              <span>{ruDate(p.data.date)}</span>
              <span>{p.data.readingMinutes} мин чтения</span>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  /* Блог на общем каркасе: заголовок слева, статьи сеткой в две колонки, на телефоне — в одну */
  .list-head { padding-top: 16px; border-bottom: 1px solid var(--hair); }
  .posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin: var(--section-pad) 0 0;
    padding: 0;
    list-style: none;
  }
  .post {
    overflow: hidden;
  }
  @media (max-width: 760px) {
    .posts { grid-template-columns: 1fr; gap: 20px; margin-top: var(--section-pad-sm); }
  }
  .cover-link {
    display: block;
  }
  .post img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--well);
  }
  .text {
    padding: 18px clamp(18px, 4vw, 28px) 24px;
  }
  h2 {
    font-size: var(--fs-h3);
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--teal-text);
  }
  .text p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
  }
  .text .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .draft {
    padding: 0 8px;
    border-radius: var(--radius-sm);
    background: var(--well);
    font-weight: 700;
  }
</style>
