---
import { DIRECTIONS } from '../data/navigation';
import { getPosts } from '../lib/blog';
import { href } from '../lib/urls';
import Logo from './Logo.astro';
const hasBlog = (await getPosts()).length > 0;
const preview = /\/dev\/?$/.test(import.meta.env.BASE_URL);
const primary = [{title:'Услуги',href:'services/',sections:['services/']},{title:'Проекты',href:'projects/',sections:['projects/']},{title:'Полезное',href:'resources/',sections:['resources/','compare/','tools/','blog/']},{title:'Контакты',href:'#t-contact',sections:[]}];
const normalize=(path:string)=>path.replace(/\/$/,'');
const current=normalize(Astro.url.pathname);
const state=(item:typeof primary[number])=> current===normalize(href(item.href)) ? 'page' : item.sections.some(path=>current.startsWith(normalize(href(path))+'/') || current===normalize(href(path))) ? 'location' : undefined;
---
<!-- Existing Emilius visual system; native disclosure on mobile, no new identity. -->
<nav class="site-nav" aria-label="Основная навигация">
  <a class="home" href={href()} aria-label="Emilius Agency — главная"><Logo />{preview && <span class="environment">Черновик · dev</span>}</a>
  <div class="desktop">{primary.map(item => <a href={href(item.href)} aria-current={state(item)}>{item.title}</a>)}</div>
  <a class="discuss" href={href('#feedback')}>Обсудить проект</a>
  <details class="mobile-menu"><summary>Меню</summary><div class="mobile-links">
    <a class="mobile-discuss" href={href('#feedback')}>Обсудить проект →</a>
    {primary.map(item => <a href={href(item.href)} aria-current={state(item)}>{item.title}</a>)}
    <span>Направления</span>{DIRECTIONS.map(item => <a href={href(item.href)}>{item.title}</a>)}
    <span>Готовое решение</span><a href={href('services/insales-shop/')}>Магазин на InSales</a>
    <span>Полезное</span><a href={href('compare/')}>Сравнения платформ</a><a href={href('tools/insales-calculator/')}>Калькулятор магазина</a>{hasBlog && <a href={href('blog/')}>Блог</a>}
  </div></details>
</nav>
<script>
  const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if(menu){
    const summary=menu.querySelector('summary')!;
    const close=()=>{menu.open=false;};
    menu.addEventListener('toggle',()=>document.dispatchEvent(new CustomEvent('emi:menu')));
    menu.addEventListener('keydown',event=>{if(event.key==='Escape' && menu.open){event.preventDefault();close();summary.focus();}});
    document.addEventListener('pointerdown',event=>{if(menu.open && event.target instanceof Node && !menu.contains(event.target))close();});
    document.addEventListener('focusin',event=>{if(menu.open && event.target instanceof Node && !menu.closest('nav')!.contains(event.target))close();});
    menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));
    matchMedia('(min-width:961px)').addEventListener('change',event=>{if(event.matches)close();});
  }
</script>
<style>
  .site-nav{width:100%;max-width:var(--site-width);margin-inline:auto;display:flex;align-items:center;gap:24px;font-size:14px;position:relative;z-index:10}
  a{color:var(--ink-2);text-decoration:none;padding-block:8px}a:hover,a[aria-current]{color:var(--teal-text)}.home{color:var(--ink);margin-right:auto;display:grid;gap:5px;padding:0;flex-shrink:0}.environment{font-size:11px;color:var(--ink-3);padding-left:18px}.desktop{display:flex;gap:24px}.discuss{background:var(--teal-btn);color:var(--on-teal);border-radius:var(--radius-btn);padding:12px 15px;font-weight:600;white-space:nowrap}.discuss:hover{background:var(--teal-btn-hover);color:var(--on-teal)}.mobile-menu{display:none}
  @media(max-width:960px){.site-nav{gap:12px}.desktop,.discuss{display:none}.mobile-menu{display:block}.mobile-menu summary{cursor:pointer;font-size:15px;min-height:44px;display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--card);border-radius:var(--radius-btn);color:var(--teal-text);list-style:none}.mobile-menu summary::after{content:'+';font-size:20px}.mobile-menu[open] summary::after{content:'−'}.mobile-links{position:absolute;top:calc(100% + 12px);left:0;right:0;max-height:70svh;overflow:auto;display:grid;background:var(--card);padding:14px 20px;border-radius:var(--radius-card);box-shadow:var(--shadow-pop)}.mobile-links a{padding:11px 0;border-bottom:1px solid var(--hair)}.mobile-links span{font-size:12px;color:var(--ink-3);margin-top:16px}.mobile-links .mobile-discuss{color:var(--teal-text);font-weight:700}}
</style>
