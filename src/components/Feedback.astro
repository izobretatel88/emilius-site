---
import { LINKS } from '../data/site';
const base = import.meta.env.BASE_URL;
const action = `${base}${base.endsWith('/') ? '' : '/'}api/lead.php`;
const direct = LINKS.direct.replace('https://t.me/', '@');
const consent = `${base}${base.endsWith('/') ? '' : '/'}consent/`;
const privacy = `${base}${base.endsWith('/') ? '' : '/'}privacy/`;
---

<section class="card feedback" id="feedback" tabindex="-1" aria-labelledby="t-feedback">
  <h2 id="t-feedback">Обсудить проект</h2>
  <form method="post" action={action} novalidate>
    <div class="project-context" hidden>
      <p>Ориентир — <strong data-project-context></strong></p>
      <button type="button" data-clear-project aria-label="Убрать выбранный проект">Убрать <span aria-hidden="true">×</span></button>
    </div>
    <div class="field">
    <label class="field-label" for="fb-message">Ваш проект или вопрос</label>
    <textarea
      id="fb-message"
      name="message"
      required
      maxlength="3000"
      aria-describedby="fb-message-hint fb-message-error"
      placeholder="Что хотите сделать и какая помощь нужна?"></textarea>
    <p class="field-hint" id="fb-message-hint">До 3 000 символов. Можно начать с нескольких предложений. <span id="fb-length">Осталось 3 000.</span></p>
    <p class="field-error" id="fb-message-error" role="alert" hidden></p>
    </div>
    <div class="field">
    <label class="field-label" for="fb-contact">Как с вами связаться</label>
    <input
      id="fb-contact"
      name="contact"
      type="text"
      maxlength="200"
      aria-describedby="fb-contact-hint"
      placeholder="Telegram, телефон или почта"
    />
    <p class="field-hint" id="fb-contact-hint">Необязательно. Оставьте контакт, если хотите получить ответ.</p>
    </div>
    <!-- Ловушка для ботов: человек это поле не видит -->
    <div class="trap" aria-hidden="true">
      <input name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <!-- Согласие по 152-ФЗ — отдельной галочкой, по умолчанию не отмечена -->
    <label class="agree">
      <input type="checkbox" name="consent" value="1" required aria-describedby="fb-consent-error" />
      <span>Согласен на <a href={consent} target="_blank">обработку персональных данных</a> по <a href={privacy} target="_blank">политике конфиденциальности</a></span>
    </label>
    <p class="field-error" id="fb-consent-error" role="alert" hidden></p>
    <button class="btn-send" type="submit">
      <span class="label">Отправить</span>
      <!-- Облачко сообщения: значок Telegram — только у кнопок, которые ведут в Telegram -->
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M5 3.5h14A2.5 2.5 0 0 1 21.5 6v9a2.5 2.5 0 0 1-2.5 2.5h-7.2l-4.6 3.6c-.7.5-1.7 0-1.7-.9v-2.7H5A2.5 2.5 0 0 1 2.5 15V6A2.5 2.5 0 0 1 5 3.5Zm2.5 5a1 1 0 0 0 0 2h9a1 1 0 1 0 0-2h-9Zm0 4a1 1 0 1 0 0 2h5.5a1 1 0 1 0 0-2H7.5Z"></path></svg>
    </button>
    <p class="status" role="status" aria-live="polite" hidden></p>
    <p class="status status-error" role="alert" hidden>
      Не получилось отправить. Напишите нам в Telegram: <a href={LINKS.direct} target="_blank" rel="noopener">{direct}</a>
    </p>
  </form>
</section>

<script>
  import {projectInquiry, inquiryMessage} from '../lib/project-inquiry';
  const form = document.querySelector<HTMLFormElement>('#feedback form');
  if (form) {
    const message = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const agree = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector('.label')!;
    const ok = form.querySelector<HTMLElement>('.status:not(.status-error)')!;
    const fail = form.querySelector<HTMLElement>('.status-error')!;
    const messageError=form.querySelector<HTMLElement>('#fb-message-error')!;
    const consentError=form.querySelector<HTMLElement>('#fb-consent-error')!;
    const length=form.querySelector<HTMLElement>('#fb-length')!;
    const updateLength=()=>{length.textContent=`Осталось ${(message.maxLength-message.value.length).toLocaleString('ru-RU')}.`;};
    message.addEventListener('input',updateLength);
    form.addEventListener('reset',()=>requestAnimationFrame(updateLength));
    updateLength();
    const context=form.querySelector<HTMLElement>('.project-context')!;
    const selectedId=new URLSearchParams(location.search).get('project');
    const selectedProject=projectInquiry(selectedId);
    if(selectedProject){
      message.value=inquiryMessage(message.value,selectedId);
      context.querySelector('[data-project-context]')!.textContent=selectedProject.name;
      context.hidden=false;
      updateLength();
      const clearProject=()=>{
        const prefix=`${selectedProject.message}\n\n`;
        if(message.value.startsWith(prefix))message.value=message.value.slice(prefix.length);
        context.hidden=true;
        updateLength();
      };
      context.querySelector('[data-clear-project]')!.addEventListener('click',()=>{
        clearProject();
        message.focus({preventScroll:true});
      });
      form.addEventListener('reset',()=>{context.hidden=true;});
    }
    const fieldError=(field:HTMLInputElement|HTMLTextAreaElement,el:HTMLElement,text='')=>{
      field.setAttribute('aria-invalid',String(Boolean(text)));
      el.textContent=text;
      el.hidden=!text;
    };
    message.addEventListener('input',()=>{if(message.value.trim())fieldError(message,messageError);});
    agree.addEventListener('change',()=>{if(agree.checked)fieldError(agree,consentError);});

    const show = (el: HTMLElement | null, text?: string) => {
      ok.hidden = fail.hidden = true;
      if (!el) return;
      if (text) el.textContent = text;
      el.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if(button.disabled)return;
      show(null);
      fieldError(message,messageError);
      fieldError(agree,consentError);
      if (!message.value.trim()) {
        fieldError(message,messageError,'Напишите, с какой задачей нужна помощь.');
        message.focus();
        return;
      }
      if (!agree.checked) {
        fieldError(agree,consentError,'Чтобы отправить сообщение, отметьте согласие на обработку данных.');
        agree.focus();
        return;
      }
      const contextualMessage=selectedProject && !context.hidden && !message.value.includes(selectedProject.message)
        ? `${selectedProject.message}\n\n${message.value}` : message.value;
      if(contextualMessage.length>message.maxLength){
        fieldError(message,messageError,'Сократите сообщение: вместе с названием проекта — не больше 3 000 символов.');
        message.focus();
        return;
      }
      button.disabled = true;
      label.textContent = 'Отправляем…';
      show(null);
      form.setAttribute('aria-busy','true');
      const controller=new AbortController();
      const timeout=window.setTimeout(()=>controller.abort(),15000);
      try {
        const payload=new FormData(form);
        payload.set('message',contextualMessage);
        const res = await fetch(form.action, {
          method: 'POST',
          body: payload,
          headers: { Accept: 'application/json' },
          signal:controller.signal,
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
        form.reset();
        show(ok, 'Спасибо! Сообщение у нас.');
      } catch {
        // Текст не стираем — его можно скопировать и отправить в Telegram.
        show(fail);
      } finally {
        clearTimeout(timeout);
        form.removeAttribute('aria-busy');
        button.disabled = false;
        label.textContent = 'Отправить';
      }
    });
  }
</script>

<style>
  .feedback {
    grid-column: 1 / -1; /* во всю ширину сетки первого экрана */
    width: 100%;
    max-width: var(--col-center);
    margin-inline: auto;
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 24px;
  }
  h2 {
    font-size: 28px;
    line-height: 1.15;
    text-align: center;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .field{display:grid;gap:7px;min-width:0}
  .project-context{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;background:var(--well);border-radius:var(--radius-sm);font-size:14px}
  .project-context[hidden]{display:none}
  .project-context button{display:inline-flex;align-items:center;gap:8px;min-height:44px;border:0;background:none;color:var(--teal-text);font:inherit;cursor:pointer;flex-shrink:0}
  .field-label{font-size:15px;font-weight:600}
  .field-hint{font-size:13px;line-height:1.45;color:var(--ink-2)}
  .field-error{font-size:14px;font-weight:600;color:var(--ink);line-height:1.45}
  [aria-invalid='true']{outline:2px solid var(--ink);outline-offset:2px}
  textarea,
  input[type='text'] {
    width: 100%;
    font: inherit;
    font-size: 16px; /* меньше 16 — iOS приближает страницу при фокусе */
    color: var(--ink);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    transition: border-color var(--hover);
  }
  textarea {
    height: 136px;
    resize: vertical;
    min-height: 96px;
  }
  input[type='text'] {
    height: 50px;
  }
  textarea::placeholder,
  input[type='text']::placeholder {
    color: var(--ink-3);
  }
  textarea:hover,
  input[type='text']:hover,
  textarea:focus,
  input[type='text']:focus {
    border-color: var(--teal);
  }
  /* Фокус — рамка в 2 px: серый и бирюзовый одной яркости (1,04:1), смена цвета тонкой рамки почти не видна */
  textarea:focus-visible,
  input[type='text']:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: -1px;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .agree {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
    cursor: pointer;
  }
  .agree input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--teal-btn);
    cursor: pointer;
  }
  /* Вторичная кнопка, как «Написать»: залитая на странице одна — «В канал» */
  .btn-send {
    align-self: center;
    width: min(100%, 240px);
    height: 54px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-btn);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 16px 14px;
    cursor: pointer;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover), opacity var(--hover);
  }
  .btn-send svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: var(--ink);
    transition: fill var(--hover);
  }
  .btn-send:hover {
    background: var(--teal-btn);
    border-color: var(--teal-btn);
    color: #fff;
  }
  .btn-send:hover svg {
    fill: #000;
  }
  .btn-send:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .status {
    font-size: 15px;
    text-align: center;
    color: var(--ink-2);
  }
</style>
