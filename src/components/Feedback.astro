---
import { LINKS } from '../data/site';
import { ENTRY_POINTS } from '../data/entry-points';
const base = import.meta.env.BASE_URL;
const action = `${base}${base.endsWith('/') ? '' : '/'}api/lead.php`;
const direct = LINKS.direct.replace('https://t.me/', '@');
const consent = `${base}${base.endsWith('/') ? '' : '/'}consent/`;
const privacy = `${base}${base.endsWith('/') ? '' : '/'}privacy/`;
---

<section class="card feedback" id="feedback" tabindex="-1" aria-labelledby="t-feedback">
  <h2 id="t-feedback">Обсудить проект</h2>
  <form method="post" action={action} novalidate data-direct={direct}>
    <div class="project-context" hidden>
      <div><p>Ориентир — <strong data-project-context></strong></p><p class="project-ask" data-project-ask hidden></p></div>
      <button type="button" data-clear-project aria-label="Убрать выбранный проект">Убрать <span aria-hidden="true">×</span></button>
    </div>
    <!-- Пустое поле — самое трудное место формы. Готовая первая строка по ситуации (think-different, итерация 16).
         Без JavaScript не показываем: кнопки работают только со скриптом. -->
    <div class="starters" data-starters hidden>
      <p id="fb-starters">Не знаете, с чего начать? Выберите ситуацию — первая строка появится сама.</p>
      <div class="starters-row" role="group" aria-labelledby="fb-starters">
        {ENTRY_POINTS.map((e) => <button type="button" data-start={e.id}>{e.label}</button>)}
      </div>
    </div>
    <div class="ui-field">
    <label class="ui-field-label" for="fb-message">Ваш проект или вопрос</label>
    <textarea
      class="ui-input"
      id="fb-message"
      name="message"
      required
      maxlength="3000"
      aria-describedby="fb-message-hint fb-message-error"
      placeholder="Что хотите сделать и какая помощь нужна?"></textarea>
    <p class="ui-field-hint" id="fb-message-hint">До 3 000 символов. Можно начать с нескольких предложений. <span id="fb-length">Осталось 3 000.</span></p>
    <p class="ui-field-error" id="fb-message-error" role="alert" hidden></p>
    </div>
    <div class="ui-field">
    <label class="ui-field-label" for="fb-contact">Как с вами связаться</label>
    <input
      class="ui-input"
      id="fb-contact"
      name="contact"
      type="text"
      maxlength="200"
      aria-describedby="fb-contact-hint"
      placeholder="Telegram, телефон или почта"
    />
    <p class="ui-field-hint" id="fb-contact-hint">Необязательно. Оставьте контакт, если хотите получить ответ.</p>
    </div>
    <!-- Ловушка для ботов: человек это поле не видит -->
    <div class="trap" aria-hidden="true">
      <input name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <!-- Согласие по 152-ФЗ — отдельной галочкой, по умолчанию не отмечена -->
    <label class="agree">
      <input type="checkbox" name="consent" value="1" required aria-describedby="fb-consent-error" />
      <span>Согласен на <a href={consent} target="_blank">обработку персональных данных<span class="visually-hidden">, откроется в новой вкладке</span></a> по <a href={privacy} target="_blank">политике конфиденциальности<span class="visually-hidden">, откроется в новой вкладке</span></a></span>
    </label>
    <p class="ui-field-error" id="fb-consent-error" role="alert" hidden></p>
    <button class="btn-send" type="submit">
      <span class="label">Отправить</span>
      <!-- Облачко сообщения: значок Telegram — только у кнопок, которые ведут в Telegram -->
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M5 3.5h14A2.5 2.5 0 0 1 21.5 6v9a2.5 2.5 0 0 1-2.5 2.5h-7.2l-4.6 3.6c-.7.5-1.7 0-1.7-.9v-2.7H5A2.5 2.5 0 0 1 2.5 15V6A2.5 2.5 0 0 1 5 3.5Zm2.5 5a1 1 0 0 0 0 2h9a1 1 0 1 0 0-2h-9Zm0 4a1 1 0 1 0 0 2h5.5a1 1 0 1 0 0-2H7.5Z"></path></svg>
    </button>
    <p class="status" role="status" aria-live="polite" hidden></p>
    <p class="status status-error" role="alert" hidden>
      Не получилось отправить. Напишите нам в Telegram: <a href={LINKS.direct} target="_blank" rel="noopener">{direct}<span class="visually-hidden">, откроется в новой вкладке</span></a>
    </p>
  </form>
</section>

<script>
  import {projectInquiry, startInquiry, stageInquiry, topicInquiry} from '../lib/project-inquiry';
  const form = document.querySelector<HTMLFormElement>('#feedback form');
  if (form) {
    const message = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const agree = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector('.label')!;
    const ok = form.querySelector<HTMLElement>('.status:not(.status-error)')!;
    const fail = form.querySelector<HTMLElement>('.status-error')!;
    const messageError=form.querySelector<HTMLElement>('#fb-message-error')!;
    const consentError=form.querySelector<HTMLElement>('#fb-consent-error')!;
    const length=form.querySelector<HTMLElement>('#fb-length')!;
    const updateLength=()=>{length.textContent=`Осталось ${(message.maxLength-message.value.length).toLocaleString('ru-RU')}.`;};
    message.addEventListener('input',updateLength);
    form.addEventListener('reset',()=>requestAnimationFrame(updateLength));
    updateLength();
    const context=form.querySelector<HTMLElement>('.project-context')!;
    const contextName=context.querySelector<HTMLElement>('[data-project-context]')!;
    // Подсказка к ситуации: что рассказать, чтобы ответ был по делу (think-different, итерация 9)
    const contextAsk=context.querySelector<HTMLElement>('[data-project-ask]')!;
    const showAsk=(item:{ask?:string}|null)=>{contextAsk.textContent=item?.ask?`Для точного ответа напишите: ${item.ask}.`:'';contextAsk.hidden=!item?.ask;};
    // Ориентир заявки: проект из галереи (?project=) или ситуация из «С чего начнём?» (?start=)
    let selectedProject:{name:string;message:string;ask?:string}|null=null;
    const prefixOf=(item:{message:string})=>`${item.message}\n\n`;
    const clearProject=()=>{
      if(selectedProject&&message.value.startsWith(prefixOf(selectedProject)))message.value=message.value.slice(prefixOf(selectedProject).length);
      selectedProject=null;
      context.hidden=true;
      updateLength();
    };
    const applyInquiry=(item:{name:string;message:string;ask?:string}|null)=>{
      if(!item)return;
      // Прежний автотекст заменяем новым; набранное человеком не трогаем
      if(selectedProject&&message.value.startsWith(prefixOf(selectedProject)))message.value=message.value.slice(prefixOf(selectedProject).length);
      const own=message.value;
      message.value=own.trim()?`${prefixOf(item)}${own}`:prefixOf(item);
      selectedProject=item;
      contextName.textContent=item.name;
      showAsk(item);
      context.hidden=false;
      updateLength();
    };
    const params=new URLSearchParams(location.search);
    let initial=projectInquiry(params.get('project'))??startInquiry(params.get('start'))??stageInquiry(params.get('stage'))??topicInquiry(params.get('topic'));
    // Со сравнения платформ: отмеченное там дописываем к теме (Comparison.astro кладёт его в память вкладки, итерация 26)
    try{
      const saved=JSON.parse(sessionStorage.getItem('emilius-inquiry-note')??'null');
      sessionStorage.removeItem('emilius-inquiry-note');
      if(initial&&saved&&saved.topic===params.get('topic')&&typeof saved.note==='string')initial={...initial,message:`${initial.message} ${saved.note.slice(0,500)}`};
    }catch{}
    if(initial){
      // Сохранённый браузером текст важнее автозаполнения
      if(message.value.trim()){selectedProject=initial;contextName.textContent=initial.name;showAsk(initial);context.hidden=false;}
      else applyInquiry(initial);
    }
    window.addEventListener('emilius:inquiry',(event)=>{
      const detail=(event as CustomEvent<{start?:string}>).detail;
      applyInquiry(startInquiry(detail?.start??null));
    });
    context.querySelector('[data-clear-project]')!.addEventListener('click',()=>{
      clearProject();
      const current = new URL(location.href);
      current.searchParams.delete('project');
      current.searchParams.delete('start');
      current.searchParams.delete('stage');
      current.searchParams.delete('topic');
      history.replaceState(history.state, '', current);
      message.focus({preventScroll:true});
    });
    form.addEventListener('reset',()=>{selectedProject=null;context.hidden=true;});
    // Готовые первые строки видны, пока у заявки нет ориентира
    const starters=form.querySelector<HTMLElement>('[data-starters]')!;
    const syncStarters=()=>{starters.hidden=!context.hidden;};
    new MutationObserver(syncStarters).observe(context,{attributes:true,attributeFilter:['hidden']});
    syncStarters();
    starters.addEventListener('click',(event)=>{
      const id=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-start]')?.dataset.start;
      if(!id)return;
      applyInquiry(startInquiry(id));
      (window as any).emiGoal?.('form-starter',{start:id});
      message.focus();
      message.setSelectionRange(message.value.length,message.value.length);
    });
    const fieldError=(field:HTMLInputElement|HTMLTextAreaElement,el:HTMLElement,text='')=>{
      field.setAttribute('aria-invalid',String(Boolean(text)));
      el.textContent=text;
      el.hidden=!text;
    };
    message.addEventListener('input',()=>{if(message.value.trim())fieldError(message,messageError);});
    agree.addEventListener('change',()=>{if(agree.checked)fieldError(agree,consentError);});

    const show = (el: HTMLElement | null, text?: string) => {
      ok.hidden = fail.hidden = true;
      if (!el) return;
      if (text) el.textContent = text;
      el.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if(button.disabled)return;
      show(null);
      fieldError(message,messageError);
      fieldError(agree,consentError);
      // Все ошибки показываем сразу, фокус — на первое поле с ошибкой: одна попытка вместо двух
      const emptyMessage=!message.value.trim();
      if (emptyMessage) fieldError(message,messageError,'Напишите, с какой задачей нужна помощь.');
      if (!agree.checked) fieldError(agree,consentError,'Чтобы отправить сообщение, отметьте согласие на обработку данных.');
      if (emptyMessage || !agree.checked) {
        (emptyMessage ? message : agree).focus();
        return;
      }
      const contextualMessage=selectedProject && !context.hidden && !message.value.includes(selectedProject.message)
        ? `${selectedProject.message}\n\n${message.value}` : message.value;
      if(contextualMessage.length>message.maxLength){
        fieldError(message,messageError,'Сократите сообщение: вместе с названием проекта — не больше 3 000 символов.');
        message.focus();
        return;
      }
      button.disabled = true;
      label.textContent = 'Отправляем…';
      show(null);
      form.setAttribute('aria-busy','true');
      const controller=new AbortController();
      const timeout=window.setTimeout(()=>controller.abort(),15000);
      try {
        const payload=new FormData(form);
        payload.set('message',contextualMessage);
        const res = await fetch(form.action, {
          method: 'POST',
          body: payload,
          headers: { Accept: 'application/json' },
          signal:controller.signal,
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
        // Человек должен знать, куда придёт ответ. Без контакта ответить нельзя — говорим об этом прямо.
        const contact=(form.querySelector<HTMLInputElement>('#fb-contact')?.value||'').trim();
        form.reset();
        show(ok, contact
          ? `Спасибо! Сообщение у нас. Ответим сюда: ${contact}.`
          : `Спасибо! Сообщение у нас. Контакт вы не оставили — если ждёте ответа, напишите нам в Telegram: ${form.dataset.direct}.`);
        // Цели Метрики (JavaScript-события): заявка с главной ушла / не ушла. Без счётчика emiGoal нет.
        (window as any).emiGoal?.('feedback-sent');
      } catch {
        (window as any).emiGoal?.('feedback-fail');
        // Текст не стираем — его можно скопировать и отправить в Telegram.
        show(fail);
      } finally {
        clearTimeout(timeout);
        form.removeAttribute('aria-busy');
        button.disabled = false;
        label.textContent = 'Отправить';
      }
    });
  }
</script>

<style>
  .feedback {
    grid-column: 1 / -1; /* во всю ширину сетки первого экрана */
    width: 100%;
    max-width: var(--col-center);
    margin-inline: auto;
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 24px;
  }
  h2 {
    font-size: 28px;
    line-height: 1.15;
    text-align: center;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .project-context{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;background:var(--well);border-radius:var(--radius-sm);font-size:14px}
  .project-context[hidden]{display:none}
  .starters[hidden]{display:none}
  .starters p{margin:0 0 8px;font-size:14px;color:var(--ink-2);line-height:1.45}
  .starters-row{display:flex;flex-wrap:wrap;gap:8px}
  .starters button{min-height:44px;padding:0 14px;border:1px solid var(--hair);border-radius:var(--radius-pill);background:none;color:var(--ink);font:inherit;font-size:14px;cursor:pointer;transition:background-color var(--hover),transform var(--press)}
  .starters button:active{transform:scale(var(--press-scale))}
  @media (hover: hover) and (pointer: fine){.starters button:hover{background:var(--well)}}
  @media (max-width:600px){.starters-row{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-inline:-4px;padding:2px 4px}.starters-row::-webkit-scrollbar{display:none}.starters button{flex:none}}
  .project-context p{margin:0}.project-ask{margin-top:4px!important;color:var(--ink-2);line-height:1.45}
  .project-context button{display:inline-flex;align-items:center;gap:8px;min-height:44px;border:0;background:none;color:var(--teal-text);font:inherit;cursor:pointer;flex-shrink:0}
  /* Поля, подписи и подсказки — общие классы .ui-field*, .ui-input (layout.css); здесь только высота полей этой формы */
  textarea.ui-input { height: 136px; }
  .agree [aria-invalid='true'] { outline: 2px solid var(--ink); outline-offset: 2px; }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .agree {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
    cursor: pointer;
  }
  .agree input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--teal-btn);
    cursor: pointer;
  }
  /* Вторичная кнопка, как «Написать»: залитая на странице одна — «В канал» */
  .btn-send {
    align-self: center;
    width: min(100%, 240px);
    height: 54px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-btn);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 16px 14px;
    cursor: pointer;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover), opacity var(--hover), transform var(--press);
  }
  /* Нажатие: кнопка чуть проседает, как остальные кнопки сайта */
  .btn-send:active:not(:disabled) { transform: scale(var(--press-scale)); }
  .btn-send svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: var(--ink);
    transition: fill var(--hover);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn-send:hover {
      background: var(--teal-btn);
      border-color: var(--teal-btn);
      color: #fff;
    }
    .btn-send:hover svg {
      fill: #000;
    }
  }
  .btn-send:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .status {
    font-size: 15px;
    text-align: center;
    color: var(--ink-2);
  }
</style>
