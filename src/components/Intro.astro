---
// Заставка при первом заходе. Движение знака повторяет эталонное видео кадр в кадр
// (замеры по 60 к/с — в константах T ниже):
//   нажатие → знак за 1–2 кадра наклоняется (~45°), надписи пропадают мгновенно;
//   1,8 с знак медленно выпрямляется до ~31°;
//   затем знак резко встаёт на место чуть выше обычного, надписи возвращаются, ~2 с он оседает.
// Звук — public/brand/intro.mp3 (разрешение владельца от 25.09.2026).
// Сначала вопрос «Удобно сейчас со звуком?» — «Да» / «Нет»; не нажали за T.wait — без звука.
// Знак плоский, как в PNG владельца (объём и блик убраны 21.10.2026 — «криво» на тонких линиях).
// После выбора знак сразу появляется в движении (без паузы), надпись встаёт вместе с ним в конце.
// Esc или прокрутка — пропустить заставку. Один раз за визит; при «уменьшить движение» — нет.
// ?intro — показать снова.
// Выбрали «Да» — после заставки тихо (20%) и по кругу играет мелодия public/brand/music.mp3
// (файл владельца, 22.10.2026); кнопка в углу выключает и включает её.
const base = import.meta.env.BASE_URL;
const root = `${base}${base.endsWith('/') ? '' : '/'}`;
const mark = `${root}brand/logo.png`; // знак-молния — PNG владельца
const sound = `${root}brand/intro.mp3`;
const music = `${root}brand/music.mp3`;
---

<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Эмилиус Эдженси" data-sound={sound} data-music={music} hidden>
  <!-- Знак появляется только после выбора звука -->
  <div class="logo" id="introLogo" hidden>
  <div class="stage">
    <div class="lift" id="introLift">
      <div class="mark3d" id="introMark" style={`--mark:url(${mark})`}>
        <img class="layer front" src={mark} alt="" />
      </div>
    </div>
    <span class="shadow" id="introShadow"></span>
  </div>

  <p class="wordmark" data-intro-text>Эмилиус Эдженси</p>
  </div>

  <!-- Вопрос о звуке. На «Нет» тает кольцо — если ничего не нажать, старт без звука -->
  <div class="choice" id="introChoice" role="group" aria-labelledby="introAsk">
    <p class="ask" id="introAsk">Удобно сейчас со звуком?</p>
    <div class="picks">
    <button class="pick pick-sound" id="introSound" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 19V5L7.5 9.5H4Z"></path><path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12"></path></svg>
      Да
    </button>
    <button class="pick pick-quiet" id="introQuiet" type="button">
      <svg class="ring" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="ring-track" cx="12" cy="12" r="9"></circle>
        <circle class="ring-left" id="introRing" cx="12" cy="12" r="9" pathLength="100"></circle>
      </svg>
      Нет
    </button>
    </div>
  </div>
</div>

<!-- Фоновая музыка: кнопка появляется, только если выбрали звук -->
<button class="music-toggle" id="musicToggle" type="button" aria-pressed="true" aria-label="Выключить музыку" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9 17.5V6.2l10-2.2v11.3"></path>
    <circle cx="6.5" cy="17.5" r="2.5"></circle>
    <circle cx="16.5" cy="15.3" r="2.5"></circle>
    <path class="mute-line" d="M4 4l16 16"></path>
  </svg>
</button>

<!-- Показываем заставку сразу, до отрисовки сайта, чтобы он не мелькнул перед ней -->
<script is:inline>
  (function () {
    var seen = false;
    try { seen = sessionStorage.getItem('emilius-intro-seen') === '1'; } catch (e) {}
    var forced = /[?&]intro\b/.test(location.search);
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (forced || (!seen && !reduce)) {
      document.getElementById('intro').hidden = false;
      document.documentElement.classList.add('intro-open');
    }
  })();
</script>

<script>
  // Тайминги, мс от нажатия. Всё, что подгоняется под видео, — здесь.
  const T = {
    tilt: 50, // наклон: 1–2 кадра
    hold: 1800, // сколько знак остаётся наклонённым
    soundAt: 170, // звук: в видео слышен через 0,38 с, в файле 0,21 с тишины в начале
    settle: 2000, // оседание после возврата
    close: 2700, // когда показать сайт
    fade: 600,
    wait: 5000, // кольцо на «Нет»: сколько ждём выбора
  };
  // Наклон, градусы: сразу 45°, к концу удержания — 31° (высота знака 71% → 86% от обычной)
  const TILT_FROM = -45;
  const TILT_TO = -31;

  const intro = document.getElementById('intro');
  const lift = document.getElementById('introLift');
  const mark = document.getElementById('introMark');
  const shadow = document.getElementById('introShadow');
  const logo = document.getElementById('introLogo');
  const choice = document.getElementById('introChoice');
  const withSound = document.getElementById('introSound');
  const quiet = document.getElementById('introQuiet');
  const ring = document.getElementById('introRing');

  if (intro && lift && mark && shadow && logo && choice && withSound && quiet && ring && !intro.hidden) {
    const texts = [...intro.querySelectorAll<HTMLElement>('[data-intro-text]')];
    try {
      sessionStorage.setItem('emilius-intro-seen', '1');
    } catch {
      /* приватный режим — не страшно */
    }
    // Фокус — на саму заставку, не на «Да»: рамка фокуса не перетягивает внимание с вопроса.
    // С клавиатуры кнопки — по Tab.
    intro.tabIndex = -1;
    intro.focus({ preventScroll: true });

    // Звук: файл качаем сразу, AudioContext создаём по нажатию — раньше браузер не даст играть
    let ctx: AudioContext | null = null;
    let buffer: Promise<AudioBuffer | null> | null = null;
    const raw = fetch(intro.dataset.sound!).then((r) => r.arrayBuffer()).catch(() => null);
    // Вызывать прямо в обработчике нажатия: так браузер разрешает звук, который сыграет позже
    const unlock = () => {
      try {
        ctx ??= new AudioContext();
        if (ctx.state === 'suspended') void ctx.resume();
        buffer ??= raw.then((b) => (b && ctx ? ctx.decodeAudioData(b) : null)).catch(() => null);
      } catch {
        /* без звука — анимация всё равно идёт */
      }
    };
    const playSound = () => {
      try {
        if (!ctx || !buffer) return;
        const at = ctx.currentTime + T.soundAt / 1000;
        void buffer.then((buf) => {
          if (!buf || !ctx) return;
          const src = ctx.createBufferSource();
          src.buffer = buf;
          src.connect(ctx.destination);
          src.start(Math.max(at, ctx.currentTime));
        });
      } catch {
        /* без звука — анимация всё равно идёт */
      }
    };

    // Фоновая мелодия: громкость через Web Audio — на iPhone громкость <audio> не меняется.
    // Запускаем в обработчике нажатия (иначе браузер не даст играть) с нулевой громкостью,
    // а слышна она становится, когда заставка закрылась, — не накладывается на звук заставки.
    const MUSIC_VOLUME = 0.2;
    const toggle = document.getElementById('musicToggle') as HTMLButtonElement | null;
    let music: HTMLAudioElement | null = null;
    let gain: GainNode | null = null;
    let musicOn = false;
    const fadeTo = (v: number, sec: number) => {
      if (gain && ctx) {
        gain.gain.cancelScheduledValues(ctx.currentTime);
        gain.gain.setValueAtTime(gain.gain.value, ctx.currentTime);
        gain.gain.linearRampToValueAtTime(v, ctx.currentTime + sec);
      } else if (music) {
        music.volume = v;
      }
    };
    const startMusic = () => {
      try {
        music = new Audio(intro.dataset.music!);
        music.loop = true;
        if (ctx) {
          gain = ctx.createGain();
          gain.gain.value = 0;
          ctx.createMediaElementSource(music).connect(gain).connect(ctx.destination);
        } else {
          music.volume = 0;
        }
        void music.play().catch(() => (music = null));
        musicOn = true;
      } catch {
        music = null;
      }
    };
    const setToggle = () => {
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(musicOn));
      toggle.setAttribute('aria-label', musicOn ? 'Выключить музыку' : 'Включить музыку');
      toggle.classList.toggle('is-muted', !musicOn);
    };
    const musicUp = () => {
      if (!music || !toggle) return;
      fadeTo(MUSIC_VOLUME, 1.5);
      toggle.hidden = false;
      setToggle();
      toggle.addEventListener('click', () => {
        if (!music) return;
        musicOn = !musicOn;
        if (musicOn) {
          if (ctx?.state === 'suspended') void ctx.resume();
          void music.play();
          fadeTo(MUSIC_VOLUME, 0.6);
        } else {
          fadeTo(0, 0.3);
          window.setTimeout(() => !musicOn && music?.pause(), 320);
        }
        setToggle();
      });
      // Вкладку свернули — пауза; вернулись — играет дальше, если её не выключали
      document.addEventListener('visibilitychange', () => {
        if (!music || !musicOn) return;
        if (document.hidden) music.pause();
        else void music.play();
      });
    };

    const running: Animation[] = [];
    const run = (el: Element, frames: Keyframe[], opts: KeyframeAnimationOptions) => {
      const a = el.animate(frames, { fill: 'forwards', ...opts });
      running.push(a);
      return a;
    };
    const timers: number[] = [];
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const reset = () => {
      running.splice(0).forEach((a) => a.cancel());
      timers.splice(0).forEach((t) => window.clearTimeout(t));
    };
    const showTexts = (on: boolean) => texts.forEach((el) => el.classList.toggle('is-off', !on));

    const press = (sound: boolean) => {
      reset();
      if (sound) playSound();
      showTexts(false);
      const hold = T.hold;

      // Наклон: мгновенно до 45°, дальше медленно выпрямляется (в видео — почти линейно после 0,4 с)
      run(
        mark,
        [
          { transform: 'rotateX(0deg)' },
          { transform: `rotateX(${TILT_FROM}deg)`, offset: T.tilt / hold, easing: 'linear' },
          { transform: `rotateX(${TILT_FROM + 1}deg)`, offset: 400 / hold, easing: 'linear' },
          { transform: `rotateX(${TILT_TO}deg)` },
        ],
        { duration: hold, easing: 'linear' },
      );
      run(
        shadow,
        [
          { transform: 'scale(1, 1)', opacity: 0.7 },
          { transform: 'translateY(-190%) scale(1.05, 0.8)', opacity: 0.9, offset: T.tilt / hold },
          { transform: 'translateY(-130%) scale(1.02, 0.9)', opacity: 0.85 },
        ],
        { duration: hold, easing: 'linear' },
      );

      // Возврат: резко на место, чуть выше обычного, надписи сразу видны, затем оседание
      later(hold, () => {
        reset();
        showTexts(true);
        run(lift, [{ transform: 'translateY(-6%) scale(1.02)' }, { transform: 'translateY(0) scale(1)' }], {
          duration: T.settle,
          easing: 'cubic-bezier(.15,.6,.3,1)',
        });
        later(T.close - hold, () => close(T.fade));
      });
    };

    let done = false;
    const close = (duration: number) => {
      if (done) return;
      done = true;
      removeEventListener('wheel', skip);
      removeEventListener('touchmove', skip);
      removeEventListener('keydown', onKey);
      musicUp();
      intro.animate([{ opacity: 1 }, { opacity: 0 }], { duration, easing: 'ease-out', fill: 'forwards' }).onfinish = () => {
        reset();
        intro.remove();
        document.documentElement.classList.remove('intro-open');
      };
    };

    // Кольцо тает, пока ждём выбора; растаяло — старт без звука
    const countdown = ring.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: 100 }], {
      duration: T.wait,
      delay: 400, // сначала кнопки появляются
      easing: 'linear',
      fill: 'forwards',
    });
    let pressed = false;
    const start = (sound: boolean) => {
      if (done || pressed) return;
      pressed = true;
      countdown.cancel();
      if (sound) {
        unlock();
        startMusic();
      }
      choice.hidden = true;
      logo.hidden = false;
      press(sound); // без паузы: знак появляется уже наклонённым
    };
    countdown.onfinish = () => start(false);
    // Пропустить без звука: Esc или попытка прокрутить
    const skip = () => {
      countdown.cancel();
      close(300);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') skip();
    };

    withSound.addEventListener('click', () => start(true));
    quiet.addEventListener('click', () => start(false));
    addEventListener('keydown', onKey);
    addEventListener('wheel', skip, { passive: true });
    addEventListener('touchmove', skip, { passive: true });
  }
</script>

<style>
  /* Кнопка музыки: в левом нижнем углу, как остальные плавающие элементы — карточка с тенью */
  .music-toggle {
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 50;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--card);
    box-shadow: var(--shadow-pop);
    color: var(--teal-text);
    cursor: pointer;
    transition: color var(--hover);
  }
  .music-toggle[hidden] {
    display: none;
  }
  .music-toggle svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .music-toggle .mute-line {
    opacity: 0;
    transition: opacity var(--hover);
  }
  .music-toggle.is-muted {
    color: var(--ink-3);
  }
  .music-toggle.is-muted .mute-line {
    opacity: 1;
  }
  .music-toggle:focus-visible {
    outline: 2px dashed var(--teal);
    outline-offset: 3px;
  }

  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 24px;
    background:
      linear-gradient(var(--veil-a), var(--veil-b)),
      conic-gradient(from 200deg at 50% 40%, var(--ray-1), var(--ray-2), var(--ray-3), var(--ray-4), var(--ray-1));
    background-color: var(--page);
  }
  .intro[hidden] {
    display: none;
  }
  :global(html.intro-open) {
    overflow: hidden;
  }

  /* Надписи пропадают и возвращаются мгновенно, как в видео */
  .is-off {
    visibility: hidden;
  }

  .stage {
    position: relative;
    width: clamp(120px, 20vw, 170px);
    aspect-ratio: 1;
    perspective: 700px;
    animation: fade 0.2s ease-out both; /* проявляется уже в наклоне */
  }
  .lift,
  .mark3d {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .mark3d {
    transform-origin: 50% 8%; /* наклон вокруг верхнего края: верх на месте, низ уходит вглубь */
    will-change: transform;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* знак вытянут по вертикали — без contain его растягивало в квадрат, и блик (маска) не совпадал */
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }
  .front {
    transform: translateZ(0);
  }
  .shadow {
    position: absolute;
    left: 16%;
    right: 16%;
    bottom: -12%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 30, 30, 0.3), transparent);
    filter: blur(4px);
    opacity: 0.7;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .logo[hidden],
  .choice[hidden] {
    display: none;
  }

  /* Надпись под знаком — как «pen.dev» в эталоне: крупно, жирно, чёрным */
  .wordmark {
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    text-align: center;
  }

  /* Выбор звука: кнопки как на сайте — залитая и с рамкой */
  /* Первый акцент — вопрос, второй — кнопки (правка владельца 22.10.2026) */
  .choice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-inline: 16px;
        animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
  }
  .intro:focus {
    outline: none;
  }
  .ask {
    font-size: clamp(32px, 4.6vw, 52px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-align: center;
    text-wrap: balance;
    max-width: 16ch;
  }
  .picks {
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  /* Кнопки — второй акцент: обе контурные, ниже и тоньше; «Да» выделена только цветом */
  .pick {
    height: 44px;
    min-width: 104px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 16px 18px;
    border-radius: var(--radius-btn);
    font: 500 15px var(--font);
    cursor: pointer;
    transition: background-color var(--hover), color var(--hover), border-color var(--hover);
  }
  .pick svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .pick-sound {
    background: transparent;
    color: var(--teal-text);
    border: 1.5px solid var(--teal);
    font-weight: 600;
  }
  .pick-sound:hover {
    background: var(--teal-btn);
    border-color: var(--teal-btn);
    color: var(--on-teal);
  }
  .pick-sound svg {
    fill: currentColor;
  }
  .pick-sound .wave {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .pick-quiet {
    background: transparent;
    color: var(--ink-2);
    border: 1.5px solid var(--hair);
  }
  .pick-quiet:hover {
    background: var(--teal-btn);
    border-color: var(--teal-btn);
    color: #fff;
  }
  /* Таймер: кольцо тает по часовой стрелке от верха */
  .ring {
    transform: rotate(-90deg);
  }
  .ring circle {
    fill: none;
    stroke-width: 3;
  }
  .ring-track {
    stroke: var(--hair);
  }
  .ring-left {
    stroke: var(--teal);
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    stroke-linecap: round;
  }
  .pick-quiet:hover .ring-track {
    stroke: rgba(255, 255, 255, 0.35);
  }
  .pick-quiet:hover .ring-left {
    stroke: #fff;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
