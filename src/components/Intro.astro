---
// Заставка при первом заходе: пауза с приветствием, затем сама играет анимация знака
// (объём, блик, наклон на ударе) и растворяется в сайт. Клик или клавиша — пропустить.
// Звук играет, только если браузер разрешил его без клика (обычно нет) — тогда анимация тихая.
// Показывается один раз за визит; при «уменьшить движение» не показывается.
const base = import.meta.env.BASE_URL;
const mark = `${base}${base.endsWith('/') ? '' : '/'}brand/mark.svg`;
const LAYERS = 9; // слои толщины знака
---

<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Добро пожаловать в Эмилиус Эдженси" hidden>
  <div class="stage">
    <div class="mark3d" id="introMark" style={`--mark:url(${mark})`}>
      {Array.from({ length: LAYERS }, (_, i) => (
        <img class="layer edge" src={mark} alt="" style={`--i:${LAYERS - i}`} />
      ))}
      <img class="layer front" src={mark} alt="" />
      <span class="glint" id="introGlint"></span>
    </div>
    <span class="shadow" id="introShadow"></span>
  </div>
  <div class="welcome">
    <p class="hello">Добро пожаловать</p>
    <p class="wordmark">Эмилиус Эдженси</p>
  </div>
</div>

<!-- Показываем заставку сразу, до отрисовки сайта, чтобы он не мелькнул перед ней -->
<script is:inline>
  (function () {
    var seen = false;
    try { seen = sessionStorage.getItem('emilius-intro-seen') === '1'; } catch (e) {}
    var forced = /[?&]intro\b/.test(location.search);
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (forced || (!seen && !reduce)) {
      document.getElementById('intro').hidden = false;
      document.documentElement.classList.add('intro-open');
    }
  })();
</script>

<script>
  import { playSting, IMPACT_AT } from '../lib/sting';

  const intro = document.getElementById('intro');
  const mark = document.getElementById('introMark');
  const glint = document.getElementById('introGlint');
  const shadow = document.getElementById('introShadow');

  const PAUSE = 1100; // пауза с приветствием перед анимацией, мс

  if (intro && mark && glint && shadow && !intro.hidden) {
    try {
      sessionStorage.setItem('emilius-intro-seen', '1');
    } catch {
      /* приватный режим — не страшно */
    }

    const ease = 'cubic-bezier(.45,0,.2,1)';
    const timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    // Блик: маска стоит на месте (форма знака), движется только светлая полоса внутри
    const sweep = (duration: number) =>
      glint.animate(
        [
          { transform: 'translateX(-160%) skewX(-18deg)', opacity: 0 },
          { opacity: 1, offset: 0.35 },
          { transform: 'translateX(160%) skewX(-18deg)', opacity: 0 },
        ],
        { duration, easing: 'ease-in-out', pseudoElement: '::before' },
      );

    let closed = false;
    const close = (duration: number) => {
      if (closed) return;
      closed = true;
      timers.forEach(clearTimeout);
      intro.animate([{ opacity: 1 }, { opacity: 0 }], { duration, easing: 'ease-out', fill: 'forwards' }).onfinish = () => {
        intro.remove();
        document.documentElement.classList.remove('intro-open');
      };
    };

    // Всё начинается, только когда вкладку видно: в фоновой вкладке браузер замораживает
    // анимации, и человек, переключившись, увидел бы сразу растворение без знака
    const begin = () => {
      // Пауза: знак стоит с лёгким наклоном и едва покачивается, пока появляется приветствие
      const idle = mark.animate(
        [{ transform: 'rotateX(8deg) rotateY(-10deg)' }, { transform: 'rotateX(2deg) rotateY(8deg)' }],
        { duration: PAUSE + 200, easing: 'ease-in-out', fill: 'forwards' },
      );
      later(() => sweep(1000), 250);

      // Анимация: нарастание → наклон вперёд на ударе → возвращение → растворение
      later(() => {
        playSting(); // сыграет, только если браузер разрешил звук
        const from = getComputedStyle(mark).transform;
        idle.cancel();
        const hit = IMPACT_AT * 1000;
        mark.animate([{ transform: from }, { transform: 'rotateX(-14deg) rotateY(0deg) scale(0.97)' }], {
          duration: hit,
          easing: 'cubic-bezier(.6,0,.9,.4)',
          fill: 'forwards',
        });
        later(() => {
          mark.animate(
            [
              { transform: 'rotateX(-14deg) scale(0.97)' },
              { transform: 'rotateX(38deg) scale(1.04)', offset: 0.22 },
              { transform: 'rotateX(0deg) scale(1)' },
            ],
            { duration: 1100, easing: ease, fill: 'forwards' },
          );
          shadow.animate(
            [{ transform: 'scaleX(0.8)', opacity: 0.5 }, { transform: 'scaleX(1.15)', opacity: 0.9, offset: 0.22 }, { transform: 'scaleX(1)', opacity: 0.7 }],
            { duration: 1100, easing: ease, fill: 'forwards' },
          );
          sweep(700);
          later(() => close(650), 850);
        }, hit);
      }, PAUSE);
    };

    if (document.visibilityState === 'visible') begin();
    else {
      intro.classList.add('is-waiting');
      document.addEventListener('visibilitychange', function onVisible() {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVisible);
        intro.classList.remove('is-waiting');
        begin();
      });
    }

    // Пропустить: клик, касание или любая клавиша
    intro.addEventListener('click', () => close(300));
    window.addEventListener('keydown', () => close(300), { once: true });
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 34px;
    background:
      linear-gradient(var(--veil-a), var(--veil-b)),
      conic-gradient(from 200deg at 50% 40%, var(--ray-1), var(--ray-2), var(--ray-3), var(--ray-4), var(--ray-1));
    background-color: var(--page);
    cursor: pointer;
  }
  .intro[hidden] {
    display: none;
  }
  :global(html.intro-open) {
    overflow: hidden;
  }

  .stage {
    position: relative;
    width: clamp(130px, 22vw, 190px);
    aspect-ratio: 1;
    perspective: 900px;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .mark3d {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    user-select: none;
    pointer-events: none;
  }
  /* Толщина знака: копии уходят вглубь и темнеют, как грань металла */
  .edge {
    transform: translateZ(calc(var(--i) * -1.4px));
    filter: brightness(0.62) saturate(1.25);
  }
  .front {
    transform: translateZ(0);
  }
  /* Блик: светлая полоса, обрезанная по форме знака */
  .glint {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: translateZ(0.5px);
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
    pointer-events: none;
  }
  .glint::before {
    content: '';
    position: absolute;
    inset: -10% 35%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
    transform: translateX(-160%);
    opacity: 0;
  }
  .shadow {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -14%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 40, 40, 0.28), transparent);
    filter: blur(4px);
    opacity: 0.7;
  }

  /* Приветствие проявляется снизу вслед за знаком */
  .welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .hello {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 600;
    color: var(--ink);
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
  }
  .wordmark {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: 0.02em;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }
  .is-waiting .stage,
  .is-waiting .hello,
  .is-waiting .wordmark {
    animation-play-state: paused;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
