---
// Услуги — сгруппированный список, как в настройках iPhone: иконка, название, подпись, стрелка.
// Стоит под колесом продукта (решение владельца 23.10.2026).
import { SERVICE_ROWS } from '../data/services-list';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
---

<section class="card services" aria-labelledby="t-services">
  <h2 class="card-title" id="t-services">Готовые решения</h2>
  <ul class="rows">
    {SERVICE_ROWS.map((s) => (
      <li>
        <a class="row" href={href(s.href)}>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.1L20 8H6.2"></path><circle cx="9.5" cy="19.5" r="1.3"></circle><circle cx="17" cy="19.5" r="1.3"></circle></svg>
          </span>
          <span class="txt">
            <span class="title">{s.title}</span>
            <span class="note">{s.note}</span>
          </span>
          <span class="chev" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .services {
    padding: 14px 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Разделитель между строками начинается после иконки — как в настройках iPhone */
  .rows li + li .row::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 56px;
    border-top: 1px solid var(--hair);
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 10px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--hover);
  }
  .row:hover {
    background: var(--well);
  }
  .row:focus-visible {
    outline: 2px dashed var(--teal);
    outline-offset: 2px;
  }
  .ico {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: var(--teal-btn);
    color: var(--on-teal);
  }
  .ico svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .txt {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
  }
  .note {
    font-size: 14px;
    color: var(--ink-2);
  }
  /* Стрелка-шеврон справа; при наведении чуть сдвигается */
  .chev {
    flex: none;
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-top: 2px solid var(--ink-3);
    border-right: 2px solid var(--ink-3);
    transform: rotate(45deg);
    transition: transform var(--hover), border-color var(--hover);
  }
  .row:hover .chev {
    border-color: var(--teal);
    transform: translateX(2px) rotate(45deg);
  }
</style>
