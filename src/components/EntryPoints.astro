---
// «С чего начнём?» — вход в круг по ситуации клиента (ветка claude/think-different, 14.11.2026).
// Клиент выбирает, что у него происходит; блок показывает, с какого дня итерации начнём,
// какой будет его круг, первые шаги и результат. Выбор — обычные радиокнопки: панели
// переключаются чистым CSS (:has), без JavaScript тоже работает. Линейка итерации одна на блок —
// при смене ситуации загораются дни нужного этапа (смена цвета 0,2 с, как везде).
// Кнопка «Обсудить такой старт» ведёт в форму с готовой первой строкой (?start=<id>#feedback);
// со скриптом — без перезагрузки, событием emilius:inquiry (его слушает Feedback.astro).
import IterationRuler from './IterationRuler.astro';
import { SECTORS, LINKS } from '../data/site';
import { ENTRY_POINTS } from '../data/entry-points';
import { href } from '../lib/urls';

interface Props {
  title?: string;
  level?: 'h2' | 'h3'; // h3 внутри секции главной, h2 на /services/
  compact?: boolean; // рядом с колесом на главной: без линейки (её роль играет колесо), шагов и результата
}
const { title = 'С чего начнём?', level = 'h3', compact = false } = Astro.props;
const Heading = level;
const Sub = level === 'h2' ? 'h3' : 'h4';
const Small = level === 'h2' ? 'h4' : 'h5';
const pad = (n: number) => String(n).padStart(2, '0');
// «Начнём с …» — родительный падеж этапа
const GENITIVE: Record<string, string> = { custdev: 'касдева', design: 'дизайна', dev: 'разработки', marketing: 'маркетинга' };
const DEFAULT = 'sales';
// Telegram открывает чат с готовым черновиком (?text=) — человек правит и отправляет, без формы
const telegram = (text: string) => `${LINKS.direct}?text=${encodeURIComponent(text)}`;
const items = ENTRY_POINTS.map((e) => {
  const i = SECTORS.findIndex((s) => s.id === e.stage);
  const stage = SECTORS[i];
  // Круг клиента: с этапа входа по порядку колеса и снова к нему
  const cycle = [...SECTORS.slice(i), ...SECTORS.slice(0, i), stage];
  return { ...e, from: stage.from, to: stage.to, stageName: stage.name, genitive: GENITIVE[e.stage], cycle };
});
---
<div class:list={["entry", { compact }]} data-entry>
  <div class="entry-head">
    <Heading id="t-entry">{title}</Heading>
    <p>В круг можно войти с любого дня. Выберите, что происходит сейчас, — покажем, с чего начнётся ваша итерация.</p>
  </div>

  <fieldset class="entry-options">
    <legend class="visually-hidden">Что происходит сейчас</legend>
    {items.map((e) => (
      <label class="entry-chip">
        <input type="radio" name="entry" value={e.id} checked={e.id === DEFAULT} aria-controls={`entry-${e.id}`} />
        <span>{e.label}</span>
      </label>
    ))}
  </fieldset>

  <div class="entry-card ui-surface">
    {!compact && <div class="entry-ruler" aria-hidden="true"><IterationRuler /></div>}
    {items.map((e) => (
      <div class="entry-panel" id={`entry-${e.id}`} data-panel={e.id} data-stage={e.stage} role="region" aria-label={`${e.label}: начнём с ${e.genitive}`}>
        <div class="entry-start">
          <p class="entry-day"><span class="ui-stage-dot"></span>Войдём в круг с дня {pad(e.from)}</p>
          <Sub class="entry-title">Начнём с {e.genitive}</Sub>
          <p class="entry-why">{e.why}</p>
          <ol class="entry-cycle" aria-label="Ваш круг">
            {e.cycle.map((s, n) => (
              <li data-stage={s.id} class:list={{ now: n === 0, again: n === e.cycle.length - 1 }}>
                <span class="ui-stage-dot"></span>{n === e.cycle.length - 1 ? `снова ${s.name}` : s.name}
              </li>
            ))}
          </ol>
        </div>
        <div class="entry-plan">
          {!compact && <>
          <div>
            <Small class="entry-sub">Первые шаги</Small>
            <ul>{e.steps.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div>
            <Small class="entry-sub">Что получите</Small>
            <ul>{e.result.map((t) => <li>{t}</li>)}</ul>
          </div>
          </>}
          <div class="ui-actions entry-actions">
            <a class="ui-button" href={href(`?start=${e.id}#feedback`)} data-entry-cta={e.id}>Обсудить такой старт <span aria-hidden="true">→</span></a>
            <a class="ui-link" href={telegram(e.message)} target="_blank" rel="noopener" data-goal-place="entry">Написать в Telegram <span class="ui-arrow" aria-hidden="true">↗</span><span class="visually-hidden">, откроется в новой вкладке, текст уже набран</span></a>
            <a class="ui-link" href={href(`services/${e.stage}/`)} data-stage-link={e.stage}>Об этапе «{e.stageName}» <span class="ui-arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <p class="entry-other">Нет вашей ситуации? <a class="ui-link" href={href('#feedback')}>Опишите задачу своими словами <span class="ui-arrow" aria-hidden="true">→</span></a></p>
</div>

<script>
  // Ссылка ?start=<id> (её можно переслать) сразу открывает эту ситуацию
  const startId = new URLSearchParams(location.search).get('start');
  const startInput = startId ? document.querySelector<HTMLInputElement>(`[data-entry] input[name="entry"][value="${CSS.escape(startId)}"]`) : null;
  if (startInput) startInput.checked = true;

  // Выбор самим человеком поворачивает колесо продукта к этапу входа (если колесо на странице)
  document.querySelectorAll<HTMLInputElement>('[data-entry] input[name="entry"]').forEach((input) => {
    input.addEventListener('change', () => {
      const stage = input.closest('[data-entry]')?.querySelector<HTMLElement>(`[data-panel="${input.value}"]`)?.dataset.stage;
      if (stage) window.dispatchEvent(new CustomEvent('emilius:wheel-stage', { detail: { stage } }));
    });
  });

  // Без перезагрузки: форма на этой же странице получает ситуацию событием, страница плавно уходит к форме.
  document.querySelectorAll<HTMLAnchorElement>('[data-entry-cta]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const form = document.getElementById('feedback');
      if (!form || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const id = link.dataset.entryCta!;
      const url = new URL(location.href);
      url.searchParams.delete('project');
      url.searchParams.set('start', id);
      url.hash = 'feedback';
      history.replaceState(history.state, '', url);
      window.dispatchEvent(new CustomEvent('emilius:inquiry', { detail: { start: id } }));
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      form.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      // С мышью — сразу в поле; на телефоне клавиатура не выскакивает сама
      if (matchMedia('(pointer: fine)').matches) form.querySelector<HTMLTextAreaElement>('textarea')?.focus({ preventScroll: true });
      (window as any).emiGoal?.('entry-cta');
    });
  });
</script>

<style>
  .entry { margin-top: 44px; }
  .entry-head :is(h2, h3) { scroll-margin-top: 24px; }
  .entry-head :is(h2, h3) { font-size: 30px; line-height: 1.15; font-weight: 600; letter-spacing: var(--tracking-tight); margin: 0 0 10px; }
  .entry-head p { font-size: 17px; line-height: 1.5; color: var(--ink-2); max-width: 62ch; margin: 0; }

  .entry-options { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 16px; padding: 0; border: 0; min-width: 0; }
  .entry-chip { position: relative; }
  .entry-chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .entry-chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px;
    border-radius: var(--radius-pill); background: var(--card); box-shadow: 0 0 0 1px var(--hair);
    font-size: 15px; color: var(--ink);
    transition: background-color var(--hover), color var(--hover), box-shadow var(--hover), transform var(--press);
  }
  .entry-chip input:active + span { transform: scale(var(--press-scale)); }
  .entry-chip input:checked + span { background: var(--ink); color: var(--page); box-shadow: 0 0 0 1px var(--ink); font-weight: 600; }
  .entry-chip input:focus-visible + span { outline: var(--focus-ring, 2px solid var(--teal)); outline-offset: var(--focus-offset, 2px); }
  @media (hover: hover) and (pointer: fine) { .entry-chip input:not(:checked):hover + span { box-shadow: 0 0 0 1px var(--ink-3); } }
  .entry-chip { -webkit-tap-highlight-color: transparent; }
  @media (forced-colors: active) { .entry-chip input:checked + span { outline: 2px solid Highlight; outline-offset: -2px; } }

  .entry-card { padding: 28px 32px 32px; }
  .entry-ruler { margin-bottom: 26px; }
  /* Одна линейка на блок: загораются 13 дней этапа выбранной ситуации */
  .entry:has(input[value='sales']:checked, input[value='idea']:checked) .entry-ruler :global(i[data-stage='custdev']),
  .entry:has(input[value='redesign']:checked) .entry-ruler :global(i[data-stage='design']),
  .entry:has(input[value='feature']:checked) .entry-ruler :global(i[data-stage='dev']),
  .entry:has(input[value='traffic']:checked) .entry-ruler :global(i[data-stage='marketing']) { background: var(--stage-ink); width: 2px; height: 11px; }
  .entry-ruler :global(i.first) { height: 14px !important; }

  .entry-panel { display: none; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; }
  .entry:has(input[value='sales']:checked) [data-panel='sales'],
  .entry:has(input[value='redesign']:checked) [data-panel='redesign'],
  .entry:has(input[value='feature']:checked) [data-panel='feature'],
  .entry:has(input[value='traffic']:checked) [data-panel='traffic'],
  .entry:has(input[value='idea']:checked) [data-panel='idea'] { display: grid; animation: ui-fade-in var(--fade-in); }

  .entry-day { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-2); font-variant-numeric: tabular-nums; margin: 0 0 10px; }
  .entry-title { font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: var(--tracking-tight); margin: 0 0 14px; }
  .entry-why { font-size: 17px; line-height: 1.5; color: var(--ink-2); max-width: 46ch; margin: 0 0 22px; }
  .entry-cycle { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 4px; font-size: 14px; color: var(--ink-3); }
  .entry-cycle li { display: inline-flex; align-items: center; gap: 6px; }
  .entry-cycle li:not(:last-child)::after { content: '→'; margin-left: 4px; color: var(--ink-3); font-weight: 400; } /* стрелка в конце строки, а не в начале следующей */
  .entry-cycle li.now { color: var(--ink); font-weight: 600; }
  .entry-cycle li.again { color: var(--ink-3); }

  .entry-plan { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 28px; align-content: start; }
  .entry-sub { font-size: 13px; font-weight: 600; color: var(--ink-3); margin: 0 0 10px; }
  .entry-plan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .entry-plan li { position: relative; padding-left: 18px; font-size: 16px; line-height: 1.45; }
  .entry-plan li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--stage-ink); }
  .entry-actions { grid-column: 1 / -1; margin-top: 8px; }
  .entry-other { margin: 18px 0 0; font-size: 15px; color: var(--ink-3); display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }

  /* Рядом с колесом: одна колонка, без карточки — карточка уже вокруг колеса */
  .entry.compact { margin-top: 0; }
  .entry.compact .entry-head p { font-size: 15px; }
  .entry.compact .entry-options { margin: 16px 0 14px; gap: 6px; }
  .entry.compact .entry-chip span { min-height: 40px; padding: 6px 12px; font-size: 14px; }
  .entry.compact .entry-card { padding: 0; background: none; box-shadow: none; border-radius: 0; }
  .entry.compact .entry-panel { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .entry.compact .entry-title { font-size: 26px; }
  .entry.compact .entry-why { font-size: 15px; margin-bottom: 14px; }
  .entry.compact .entry-plan { grid-template-columns: minmax(0, 1fr); }
  .entry.compact .entry-actions { margin-top: 0; gap: 10px 24px; }
  .entry.compact .entry-other { font-size: 14px; }
  @media (prefers-reduced-motion: reduce) {
    .entry-panel { animation: none !important; }
  }
  @media (max-width: 1000px) {
    .entry-panel { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 760px) {
    .entry { margin-top: 32px; }
    .entry-head :is(h2, h3) { font-size: 25px; }
    .entry-head p { font-size: 16px; }
    /* На телефоне ситуации — лента, которую листают вбок: экран не забивается пятью рядами таблеток */
    .entry-options { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--layout-gutter)); padding-inline: var(--layout-gutter); scroll-padding-inline: var(--layout-gutter); scrollbar-width: none; scroll-snap-type: x proximity; }
    .entry-options::-webkit-scrollbar { display: none; }
    .entry-chip { flex: none; scroll-snap-align: start; }
    .entry-chip span { white-space: nowrap; }
    .entry-card { padding: 22px 20px 24px; }
    .entry-ruler { margin-bottom: 20px; }
    .entry-title { font-size: 28px; }
    .entry-why { font-size: 16px; }
    .entry-plan { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .entry-actions { flex-direction: column; align-items: stretch; }
  }
</style>
