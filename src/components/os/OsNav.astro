---
// Навигация эксперимента /os/: страницы раздела и выход на нынешний сайт
interface Props {
  current: 'overview' | 'insales' | 'team';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const items = [
  { id: 'overview', label: 'Обзор', to: 'os/' },
  { id: 'insales', label: 'InSales', to: 'os/insales/' },
  { id: 'team', label: 'Команда', to: 'os/team/' },
];
---

<nav class="os-nav" aria-label="Раздел эксперимента">
  <ul>
    {items.map((i) => (
      <li><a href={href(i.to)} aria-current={i.id === current ? 'page' : undefined}>{i.label}</a></li>
    ))}
  </ul>
  <a class="back" href={href('')}>Нынешний сайт ↗</a>
</nav>

<style>
  .os-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 4px;
    display: flex;
    gap: 4px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: var(--shadow-card);
  }
  li a {
    display: block;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition: background-color var(--hover), color var(--hover);
  }
  li a:hover {
    color: var(--ink);
  }
  li a[aria-current='page'] {
    background: var(--teal-btn);
    color: var(--on-teal);
  }
  .back {
    font-size: 14px;
    color: var(--teal-text);
  }
</style>
