---
import { PROJECTS } from '../data/projects';
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
---

<section class="card col-card projects-card" aria-labelledby="t-projects">
  <h2 class="card-title" id="t-projects">Проекты</h2>
  <ul class="projects">
    {PROJECTS.map((p) => (
      <li class="proj">
        <button class="proj-btn" type="button" aria-expanded="false" aria-controls={`case-${p.id}`}>
          <img class:list={[{ mono: p.logoMono }]} src={href(p.logo)} alt="" width="34" height="34" loading="lazy" />
          <span class="visually-hidden">Кейс: {p.name}</span>
        </button>
        <div class="case" id={`case-${p.id}`}>
          <img class="shot" src={href(p.shot)} alt={`Первый экран сайта ${p.domain}`} width="640" height="400" loading="lazy" decoding="async" />
          <p>{p.about}</p>
          <p>{p.did}</p>
          <a href={p.url} target="_blank" rel="noopener">{p.domain} ↗</a>
        </div>
      </li>
    ))}
  </ul>
</section>

<script>
  // Кейс открывается наведением или фокусом, Esc его закрывает — до тех пор, пока курсор и фокус
  // не уйдут с логотипа (WCAG 1.4.13). aria-expanded говорит экранному диктору, открыт ли кейс.
  const projs = [...document.querySelectorAll<HTMLElement>('.proj')].flatMap((proj) => {
    const card = proj.querySelector<HTMLElement>('.case');
    const btn = proj.querySelector<HTMLButtonElement>('.proj-btn');
    return card && btn ? [{ proj, card, btn }] : [];
  });
  projs.forEach(({ proj, card, btn }) => {
    // Кейс — над логотипом; если сверху не помещается, — туда, где места больше
    const place = () => {
      const r = proj.getBoundingClientRect();
      const need = card.offsetHeight + 12;
      const above = r.top;
      const below = innerHeight - r.bottom;
      // сверху — если помещается; иначе туда, где места больше
      proj.classList.toggle('is-down', above < need && below > above);
    };
    // :focus-within меняется уже после focusout — смотрим состояние в следующем такте
    const sync = () =>
      window.setTimeout(() => {
        const on = proj.matches(':hover') || proj.matches(':focus-within');
        if (!on) proj.classList.remove('is-dismissed');
        btn.setAttribute('aria-expanded', String(on && !proj.classList.contains('is-dismissed')));
      });
    proj.addEventListener('pointerenter', () => (place(), sync()));
    proj.addEventListener('focusin', () => (place(), sync()));
    proj.addEventListener('pointerleave', sync);
    proj.addEventListener('focusout', sync);
  });
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    projs.forEach(({ proj, btn }) => {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      // фокус на ссылке внутри кейса — возвращаем его на логотип, иначе он пропадёт вместе с кейсом
      if (proj.contains(document.activeElement) && document.activeElement !== btn) btn.focus();
      proj.classList.add('is-dismissed');
      btn.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  /* Узкие телефоны: пять кружков логотипов помещаются в строку целиком */
  @media (max-width: 360px) {
    .proj-btn.proj-btn {
      width: 44px;
      height: 44px;
    }
    .proj-btn.proj-btn img {
      width: 28px;
      height: 28px;
    }
  }

  .col-card {
    padding: 14px 14px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .projects {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: center;
  }
  /* Компьютер: карточка растянута на высоту колеса — логотипы делят её поровну */
  @media (min-width: 861px) {
    .projects {
      flex: 1;
      justify-content: space-evenly;
    }
  }
  .proj {
    position: relative;
  }
  .proj-btn {
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--proj-bg);
    box-shadow: var(--shadow-icon);
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
  }
  /* Тёмная тема: кружки тёмные, чёрно-белые логотипы становятся светлыми */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .proj-btn img.mono {
      filter: invert(1);
    }
  }
  :global(:root[data-theme='dark']) .proj-btn img.mono {
    filter: invert(1);
  }
  .proj-btn img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    border-radius: 50%;
  }
  /* Кейс открывается над логотипом (справа его съедал край экрана — решение владельца 23.10.2026);
     если сверху не хватает места, скрипт ставит .is-down — тогда под логотипом */
  .case {
    position: absolute;
    left: -60px;
    bottom: calc(100% + 10px);
    width: 260px;
    z-index: 5;
    background: var(--card);
    color: var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-pop);
    padding: 14px 16px;
    font-size: 15px;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    /* Кейс плавно въезжает сверху (правка владельца 22.10.2026) */
    transform: translateY(-12px);
    transition: opacity 0.25s ease, transform 0.25s ease-out, visibility 0.25s;
  }
  .proj.is-down .case {
    bottom: auto;
    top: calc(100% + 10px);
  }
  .proj:hover .case,
  .proj:focus-within .case {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Закрыт по Esc — не открывается, пока курсор и фокус не уйдут с логотипа. Скрывается сразу,
     без затухания: иначе Tab успевает попасть на ссылку в гаснущем кейсе и фокус теряется */
  .proj.is-dismissed .case {
    opacity: 0;
    visibility: hidden;
    transition: none;
  }
  .case .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    background: var(--well);
    border: 1px solid var(--hair);
  }
  .case a {
    font-weight: 600;
    text-underline-offset: 3px;
  }
  @media (max-width: 1040px) {
    .case {
      left: -48px;
    }
  }
  /* Телефон и планшет: блок во всю ширину, логотипы в строку; кейс открывается НАД строкой
     (снизу его не видно — правка владельца 22.10.2026) по ширине блока — у крайних логотипов
     не уезжает за край экрана */
  @media (max-width: 860px) {
    .projects {
      position: relative;
      width: 100%;
      flex-direction: row;
      justify-content: space-around;
      gap: 8px;
    }
    .proj {
      position: static;
    }
    .case,
    .proj.is-down .case {
      left: 0;
      right: 0;
      top: auto;
      bottom: calc(100% + 8px);
      width: auto;
      max-width: 420px;
      margin-inline: auto;
      transform: translateY(4px);
    }
    .proj:hover .case,
    .proj:focus-within .case {
      transform: none;
    }
  }
</style>
