---
import '../styles/global.css';
// Основные начертания грузим заранее: заголовки (600) и текст (400) не перескакивают со шрифта на шрифт
import glober400 from '../styles/fonts/glober-400.woff2?url';
import glober600 from '../styles/fonts/glober-600.woff2?url';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('og.jpg'), Astro.site);
// Превью на GitHub Pages не должно попадать в поиск (robots.txt в подпапке поисковики не читают).
const preview = process.env.PREVIEW === '1';
// Сборка ветки dev лежит в подпапке /dev — помечаем её, чтобы не путать с рабочим превью.
const devBuild = /\/dev\/?$/.test(base);
// Яндекс Метрика: номер счётчика задаётся при сборке продакшена (YM_ID=…). В превью счётчика нет, чтобы не мешать данные.
const ymId = preview ? 0 : Number(process.env.YM_ID) || 0;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={glober600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={glober400} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Эмилиус Эдженси" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Колесо продукта Эмилиус Эдженси: касдев, дизайн, разработка, маркетинг" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1413" media="(prefers-color-scheme: dark)" />
    {ymId && (
      <script is:inline define:vars={{ ymId }}>
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        ym(ymId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
        // Цели страниц вызывают window.emiGoal — без счётчика это просто отсутствие функции.
        window.emiGoal = (name, params) => ym(ymId, 'reachGoal', name, params);
      </script>
    )}
  </head>
  <body>
    {devBuild && <a class="dev-badge" href="/emilius-site/">черновик · ветка dev</a>}
    <slot />
  </body>
</html>

<style>
  .dev-badge {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 50;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: #1a1a1a;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
