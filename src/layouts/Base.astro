---
import '../styles/global.css';
import WriteButton from '../components/WriteButton.astro';
import SiteNav from '../components/SiteNav.astro';
import CookieNotice from '../components/CookieNotice.astro';
// Основные начертания грузим заранее: заголовки (600) и текст (400) не перескакивают со шрифта на шрифт
import glober400 from '../styles/fonts/glober-400.woff2?url';
import glober600 from '../styles/fonts/glober-600.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean; // эксперименты (раздел /os/) не индексируются и в продакшене
  customNav?: boolean;
  bodyClass?: string;
  // Для статей блога: своя обложка, тип страницы и разметка для поисковиков. По умолчанию — как у всего сайта.
  ogType?: 'website' | 'article';
  ogImage?: string; // путь от корня сайта, например blog/<адрес>/cover-og.jpg
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: object | object[];
}
const { title, description, noindex = false, customNav = false, bodyClass, ogType = 'website', ogImage: ogImagePath, ogImageAlt, publishedTime, modifiedTime, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href(ogImagePath ?? 'og.jpg'), Astro.site);
// Превью на GitHub Pages не должно попадать в поиск (robots.txt в подпапке поисковики не читают).
const preview = process.env.PREVIEW === '1';
// Сборка ветки dev лежит в подпапке /dev — помечаем её, чтобы не путать с рабочим превью.
const devBuild = /\/dev\/?$/.test(base);
const hasSiteNav = !customNav && !/\/(os|meetings)(\/|$)/.test(Astro.url.pathname);
// Яндекс Метрика: номер счётчика задаётся при сборке продакшена (YM_ID=…). В превью счётчика нет, чтобы не мешать данные.
const ymId = preview ? 0 : Number(process.env.YM_ID) || 0;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Тема, выбранная в сравнении, сохраняется при переходах по сайту и применяется до отрисовки.
      try {
        var chosenTheme = localStorage.getItem('emilius-comparison-theme');
        if (chosenTheme === 'light' || chosenTheme === 'dark') document.documentElement.dataset.theme = chosenTheme;
      } catch {}
    </script>
    <title>{title}</title>
    <link rel="preload" href={glober600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={glober400} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {/* Закрытой от индекса странице (404, черновик) каноническая ссылка не нужна: 404 отдаётся по любому неверному адресу */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Эмилиус Эдженси" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? 'Колесо продукта Эмилиус Эдженси: касдев, дизайн, разработка, маркетинг'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Цвет панели браузера — фон страницы (--page в tokens.css); скрипт в конце body следит за выбранной темой -->
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {ymId > 0 && (
      <script is:inline define:vars={{ ymId }}>
        // Код из кабинета Метрики (24.10.2026), номер счётчика подставляется из YM_ID.
        // Считаем только боевой адрес: продакшен-сборку открывают и локально (astro preview), и на техническом
        // адресе Бегета — до 05.11.2026 это давало почти половину просмотров в счётчике (docs/AUDIT-YANDEX-2026-11-05.md).
        if (location.hostname === 'emilius.agency') {
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        ym(ymId, 'init', { webvisor: true, clickmap: true, referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
        // Цели страниц вызывают window.emiGoal — без счётчика это просто отсутствие функции.
        window.emiGoal = (name, params) => ym(ymId, 'reachGoal', name, params);
        }
      </script>
    )}
  </head>
  <body class={bodyClass}>
    {ymId > 0 && <noscript><div><img src={`https://mc.yandex.ru/watch/${ymId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>}
    <!-- С клавиатуры первая остановка — «К содержанию»: мимо шапки сразу к главному блоку страницы. Видна только в фокусе. -->
    <a class="skip" href="#content">К содержанию</a>
    {devBuild && !hasSiteNav && !customNav && <a class="dev-badge" href="/emilius-site/">черновик · ветка dev</a>}
    {hasSiteNav && <SiteNav />}
    <slot />
    <script is:inline>
      // Цель ссылки — первый <main> страницы; id и фокус даём ему здесь, чтобы не размечать каждую страницу
      (function () {
        var m = document.querySelector('main');
        if (m && !document.getElementById('content')) { m.id = 'content'; m.tabIndex = -1; }
      })();
    </script>
    <script is:inline>
      // Панель браузера в цвет страницы и при ручном выборе темы: «Светлая» при тёмной системе — светлая панель.
      // В режиме «Авто» остаются цвета из разметки — браузер сам берёт светлый или тёмный по системе.
      (function () {
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        var sync = function () {
          var manual = document.documentElement.dataset.theme;
          var page = getComputedStyle(document.documentElement).getPropertyValue('--page').trim();
          metas.forEach(function (meta) {
            if (!meta.dataset.auto) meta.dataset.auto = meta.getAttribute('content');
            meta.setAttribute('content', manual && page ? page : meta.dataset.auto);
          });
        };
        sync();
        document.addEventListener('emi:theme', sync);
      })();
    </script>
    <script is:inline>
      // Переход к форме главной с любой страницы («Обсудить задачу», «Хочу похожий», «Помогите выбрать»):
      // человек уже выбрал действие — заставка (Intro.astro) не должна перекрыть форму. Ставим её же отметку
      // «видел в этом визите», как она сама делает для ?project= (think-different, итерация 5).
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element ? e.target.closest('a[href*="#feedback"], a[href*="#t-entry"]') : null;
        if (!a) return;
        try { sessionStorage.setItem('emilius-intro-seen', '1'); } catch (err) {}
      }, true);
    </script>
    <WriteButton />
    {!/\/(os|meetings)(\/|$)/.test(Astro.url.pathname) && <CookieNotice />}
    <script is:inline>
      // Общие цели Метрики (аудит трафика и целей 11.11.2026), одним обработчиком на весь документ:
      // tg-click — любая ссылка на Telegram, с параметрами page и place: data-goal-place ближайшего блока,
      // fab, nav, footer, id раздела или page. compare-to-landing — со страниц сравнений на лендинг inSales.
      // Без счётчика emiGoal нет — ничего не происходит.
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (!a || !window.emiGoal) return;
        var page = location.pathname;
        if (a.href.indexOf('https://t.me/') === 0) {
          var marked = a.closest('[data-goal-place]');
          var section = a.closest('section[id]');
          var place = marked ? marked.getAttribute('data-goal-place') : a.classList.contains('write-fab') ? 'fab' : a.closest('nav') ? 'nav' : a.closest('footer') ? 'footer' : section ? section.id : 'page';
          window.emiGoal('tg-click', { page: page, place: place });
        } else if (/\/compare\//.test(page) && /\/services\/insales-shop\//.test(a.pathname)) {
          window.emiGoal('compare-to-landing', { page: page, to: a.pathname });
        }
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 60;
    padding: 10px 16px;
    border-radius: var(--radius-btn);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow-pop);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - 48px));
    transition: transform var(--hover);
  }
  .skip:focus-visible {
    transform: none;
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  :global(main:focus) {
    outline: none;
  }
  .dev-badge {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 50;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: #1a1a1a;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
