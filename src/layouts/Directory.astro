---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import {href} from '../lib/urls';
import '../styles/architecture.css';
interface Props {title:string;description:string;parents?:{title:string;href:string}[];}
const {title,description,parents=[]}=Astro.props;
const abs=(p:string)=>new URL(href(p),Astro.site).href;
const jsonLd={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Главная',item:abs('')},...parents.map(i=>({name:i.title,item:abs(i.href)})),{name:title,item:new URL(Astro.url.pathname,Astro.site).href}].map((i,index)=>({'@type':'ListItem',position:index+1,...i}))};
---
<Base title={`${title} — Emilius Agency`} description={description} jsonLd={jsonLd}>
  <main class="directory"><Breadcrumbs items={[...parents,{title}]} /><header class="directory-intro"><h1>{title}</h1><p>{description}</p></header><slot /></main>
  <Footer />
</Base>
