---
import { glue } from '../lib/typograph.mjs';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import '../styles/architecture.css';
interface Props {title:string;seoTitle?:string;description:string;parents?:{title:string;href:string}[];ogImage?:string;ogImageAlt?:string;jsonLd?:object|object[];}
const {title,seoTitle,description,parents=[],ogImage,ogImageAlt,jsonLd}=Astro.props;
---
<Base title={`${seoTitle??title} — Эмилиус Эдженси`} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} jsonLd={jsonLd}>
  <main class="directory ui-shell"><header class="directory-intro ui-opening"><Breadcrumbs items={[...parents,{title}]} /><h1 class="ui-h1">{title}</h1><p class="ui-lead">{glue(description)}</p></header><slot /></main>
  <Footer />
</Base>
