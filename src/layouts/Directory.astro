---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import '../styles/architecture.css';
// pageTitle — заголовок вкладки и сниппета, если одного слова раздела мало (think-different, итерация 100)
interface Props {title:string;pageTitle?:string;description:string;parents?:{title:string;href:string}[];ogImage?:string;ogImageAlt?:string;}
const {title,pageTitle,description,parents=[],ogImage,ogImageAlt}=Astro.props;
---
<Base title={`${pageTitle ?? title} — Эмилиус Эдженси`} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <main class="directory ui-shell"><header class="directory-intro ui-opening"><Breadcrumbs items={[...parents,{title}]} /><h1 class="ui-h1">{title}</h1><p class="ui-lead">{description}</p></header><slot /></main>
  <Footer />
</Base>
