---
// Страница приложения Emilius Meetings — «Application home page» на экране согласия Google OAuth.
// Тексты описывают фактическую работу бота (adapters/google.py в meeting_automation). Меняется бот — меняются и они.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Footer from '../../components/Footer.astro';
import MeetingsNav from '../../components/MeetingsNav.astro';
import { MEETINGS, GOOGLE_LINKS } from '../../data/meetings';
import { OPERATOR } from '../../data/legal';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;

const steps = [
  'Участник рабочего Telegram-чата проекта отправляет боту команду и тему встречи.',
  'Бот создаёт видеовстречу в Яндекс Телемосте и Google-документ встречи в папке проекта, а в чат присылает ссылки на звонок и на документ.',
  'Если встреча с записью, к звонку подключается ассистент MyMeet: он записывает разговор и готовит конспект.',
  'Когда конспект готов, бот записывает в тот же документ резюме, решения, задачи, следующие шаги и расшифровку.',
];

const driveUse = [
  'находит целевые папки проектов и заказов, указанные в справочнике проектов агентства, и проверяет, что в них можно создавать файлы;',
  'находит в папке заказа подпапку «Встречи» или создаёт её;',
  'создаёт документ встречи и помечает его служебным номером встречи, чтобы не создать второй такой же;',
  'находит и обновляет документы встреч, которые создал сам: дописывает конспект в отмеченный блок, текст людей вне блока не трогает;',
  'по команде администратора переименовывает документ встречи или переносит его в папку другого проекта.',
];
---

<Base
  title={`${MEETINGS.name} — Telegram-бот для встреч — Эмилиус Эдженси`}
  description={`${MEETINGS.name} — Telegram-бот Эмилиус Эдженси: создаёт встречу в Яндекс Телемосте и Google-документ, записывает в него конспект, решения и задачи MyMeet.`}
>
  <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <MeetingsNav current="app" />

  <main class="page">
    <section class="card intro">
      <div class="app-head">
        <img class="app-icon" src={href('brand/logo-mark.png')} width="512" height="512" alt="Логотип Emilius" />
        <div>
          <p class="eyebrow">Приложение Эмилиус Эдженси</p>
          <h1>{MEETINGS.name}</h1>
        </div>
      </div>
      <p class="lead">
        Telegram-бот агентства для встреч с клиентами и командой. Создаёт встречу в Яндекс Телемосте и Google-документ, а
        после звонка записывает в этот документ конспект, решения и задачи, которые подготовил MyMeet.
      </p>
      <p class="docs">
        <a href={href('meetings/privacy/')}>Политика конфиденциальности</a>
        <a href={href('meetings/terms/')}>Условия использования</a>
      </p>
    </section>

    <section class="card block" aria-labelledby="t-how">
      <h2 id="t-how">Как это работает</h2>
      <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
    </section>

    <section class="card block" aria-labelledby="t-google">
      <h2 id="t-google">Google Диск и Google Документы</h2>
      <p>
        Google-доступ выдан одному техническому Google-аккаунту агентства. Участникам Telegram-чата не нужно входить в Google
        и подключать свои аккаунты. С этим доступом бот:
      </p>
      <ul class="dots">{driveUse.map((s) => <li>{s}</li>)}</ul>
      <p class="note">
        Бот запрашивает полный доступ к Google Диску (<code>{MEETINGS.scope}</code>): документы встреч лежат в уже
        существующих папках проектов, которые создавал не бот. Технически это право шире, чем нужно для перечисленного
        выше. Чем доступ отличается от фактического использования — в
        <a href={href('meetings/privacy/')}>политике конфиденциальности</a>.
      </p>
      <p class="note">
        Использование и передача приложением {MEETINGS.name} в любые другие приложения данных, полученных через API Google,
        соответствуют <a href={GOOGLE_LINKS.userDataPolicy} target="_blank" rel="noopener">Google API Services User Data Policy</a>,
        включая требования Limited Use.
      </p>
    </section>

    <div class="cols">
      <section class="card block" aria-labelledby="t-who">
        <h2 id="t-who">Кто пользуется</h2>
        <p>
          Сотрудники агентства и участники рабочих чатов проектов, которые подключил администратор. В других чатах бот не
          работает.
        </p>
      </section>
      <section class="card block" aria-labelledby="t-help">
        <h2 id="t-help">Поддержка</h2>
        <p>
          Вопросы, сбои, отзыв доступа и удаление данных — <a href={`mailto:${OPERATOR.email}`}>{OPERATOR.email}</a>.
        </p>
        <p class="note">Приложение принадлежит {OPERATOR.short}, ИНН {OPERATOR.inn}.</p>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .page {
    width: 100%;
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .intro {
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .app-head {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .app-icon {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: var(--radius-card);
    background: var(--proj-bg);
    box-shadow: var(--shadow-icon);
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 4px;
    font-size: clamp(34px, 6vw, 52px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .lead {
    font-size: clamp(18px, 2vw, 20px);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .docs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-weight: 600;
  }
  .docs a {
    text-underline-offset: 3px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .block {
    padding: 26px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .block h2 {
    font-size: 22px;
    line-height: 1.15;
  }
  .steps,
  .dots {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .steps {
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 38px;
    min-height: 26px;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -1px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--well);
    color: var(--teal-text);
    font-weight: 700;
    font-size: 14px;
    line-height: 26px;
    text-align: center;
  }
  .dots li {
    position: relative;
    padding-left: 18px;
  }
  .dots li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
  }
  .note {
    color: var(--ink-2);
    font-size: 15px;
  }
  code {
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .page,
    .cols {
      gap: 20px;
    }
    .cols {
      grid-template-columns: 1fr;
    }
    .block {
      padding: 22px 20px 24px;
    }
    .app-icon {
      width: 60px;
      height: 60px;
    }
  }
</style>
