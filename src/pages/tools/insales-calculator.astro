---
import Directory from '../../layouts/Directory.astro';
import {href} from '../../lib/urls';
import {QUICK_QUESTIONS,quickEstimate} from '../../../docs/insales-service/calc/quick.js';
import {parseCatalog} from '../../../docs/insales-service/calc/estimate.js';
import csv from '../../../docs/insales-service/03-catalog.csv?raw';
// Формулу и внутренние нормы используем только при сборке. В браузер уходят публичные результаты.
const catalog=parseCatalog(csv);
const entries=Object.entries(QUICK_QUESTIONS) as [string,[string,[string,string][]]][];
const lookup:Record<string,number>={};
const results:{packageName:string;from:number;to:number;weeks:number[]}[]=[];
const dedup=new Map<string,number>();
function combinations(index:number,answers:Record<string,string>) {
  if(index===entries.length){
    const e=quickEstimate(answers,catalog);
    const result={packageName:e.packageName,from:e.from,to:e.to,weeks:e.weeks};
    const serialized=JSON.stringify(result);
    if(!dedup.has(serialized)){dedup.set(serialized,results.length);results.push(result);}
    lookup[entries.map(([key])=>answers[key]).join('|')]=dedup.get(serialized)!;
    return;
  }
  const [name,[,options]]=entries[index];
  options.forEach(([value])=>combinations(index+1,{...answers,[name]:value}));
}
combinations(0,{});
const defaults=Object.fromEntries(entries.map(([key,[,options]])=>[key,key==='channel'?'social':options[0][0]]));
const initial=results[lookup[entries.map(([key])=>defaults[key]).join('|')]];
const rub=(n:number)=>n.toLocaleString('ru-RU')+' ₽';
---
<Directory title="Калькулятор магазина на InSales" description="Ответьте на семь вопросов — получите ориентир по бюджету и сроку. Тот же расчёт используется в форме услуги. Контакты для расчёта не нужны." parents={[{title:'Инструменты',href:'tools/'}]}>
  <div class="calculator">
  <section class="directory-callout calc-result" id="calc-result" tabindex="-1" aria-labelledby="calc-result-title">
    <h2 id="calc-result-title">Бюджет и срок</h2>
    <div role="status" aria-live="polite" aria-atomic="true"><p>Пакет <strong id="calc-package">«{initial.packageName}»</strong></p><p class="calc-price" id="calc-price">{rub(initial.from)} – {rub(initial.to)}</p><p id="calc-weeks">Ориентир: {initial.weeks.join('–')} нед.</p></div>
    <details class="calc-summary"><summary>Проверить параметры расчёта</summary><dl>{entries.map(([key,[label,options]])=><div><dt>{label}</dt><dd data-answer={key}>{options.find(([value])=>value===defaults[key])?.[1]}</dd></div>)}</dl></details>
    <a id="calc-discuss" class="directory-button" href={href('services/insales-shop/#lead')}>Обсудить расчёт</a><p class="calc-hint">Ответы перенесутся в форму заявки. Контакты вы укажете на следующем шаге.</p><a class="calc-back" href="#public-calculator">Изменить параметры</a>
  </section>
  <form id="public-calculator" aria-label="Параметры магазина">{entries.map(([key,[label,options]])=><div class="calc-field"><label for={`calc-${key}`}>{label}</label><select id={`calc-${key}`} name={key}>{options.map(([value,title])=><option value={value} selected={value===defaults[key]}>{title}</option>)}</select></div>)}<button type="reset">Сбросить ответы</button><a class="calc-return" href="#calc-result">Посмотреть расчёт ↑</a></form>
  <aside class="calc-notes" aria-labelledby="calc-notes-title"><h2 id="calc-notes-title">Об оценке</h2><p>Это предварительная стоимость работ. Тариф платформы, платная тема и платежи внешним сервисам оплачиваются отдельно. SEO, реклама и нестандартные доработки уточняются на диагностике.</p></aside>
  </div>
  <noscript><p>Для пересчёта включите JavaScript. Начальный ориентир рассчитан для магазина до 50 товаров; обсудить состав можно в форме услуги.</p></noscript>
  <div class="directory-tags"><a href={href('services/insales-shop/')}>Что входит в запуск магазина</a><a href={href('compare/')}>Выбрать другую платформу</a><a href={href('resources/')}>Все полезные материалы</a></div>
  <script type="application/json" id="calc-data" set:html={JSON.stringify({lookup,results,keys:entries.map(([key])=>key)})} />
</Directory>
<script>
  const form=document.querySelector<HTMLFormElement>('#public-calculator');
  if(form){
    form.tabIndex=-1;
    document.querySelector('.calc-back')?.addEventListener('click',()=>requestAnimationFrame(()=>form.querySelector('select')?.focus({preventScroll:true})));
    const data=JSON.parse(document.querySelector('#calc-data')!.textContent!);
    const rub=(n:number)=>n.toLocaleString('ru-RU')+'\u00a0₽';
    const update=()=>{
      const answers=new FormData(form);
      form.querySelectorAll('select').forEach(select=>{
        const output=document.querySelector(`[data-answer="${select.name}"]`);
        if(output)output.textContent=select.selectedOptions[0].textContent;
      });
      const result=data.results[data.lookup[data.keys.map((key:string)=>answers.get(key)).join('|')]];
      document.querySelector('#calc-package')!.textContent=`«${result.packageName}»`;
      document.querySelector('#calc-price')!.textContent=`${rub(result.from)} – ${rub(result.to)}`;
      document.querySelector('#calc-weeks')!.textContent=`Ориентир: ${result.weeks.join('–')} нед.`;
      const link=document.querySelector<HTMLAnchorElement>('#calc-discuss')!;
      const url=new URL(link.href);
      data.keys.forEach((key:string)=>url.searchParams.set(`calc_${key}`,String(answers.get(key))));
      link.href=url.href;
    };
    form.addEventListener('submit',event=>event.preventDefault());
    form.addEventListener('change',update);
    form.addEventListener('reset',()=>requestAnimationFrame(update));
    update();
  }
</script>
<style>
  .calc-back{display:inline-flex;align-items:center;min-height:44px;margin-top:8px;font-size:14px;text-underline-offset:4px}
  .calc-result h2{font-size:24px;margin-bottom:14px}
  .calc-result:focus{outline:2px solid var(--teal-text);outline-offset:4px}
  .calc-summary{margin-block:16px;border-bottom:1px solid var(--hair);font-size:14px;text-align:left}
  .calc-summary summary{min-height:48px;padding-block:12px;cursor:pointer;color:var(--teal-text);font-weight:600}
  .calc-summary dl{margin:0 0 16px;display:grid;gap:12px}
  .calc-summary dt{color:var(--ink-2)}
  .calc-summary dd{margin:2px 0 0;font-weight:600}
  #public-calculator button{min-height:44px;text-underline-offset:4px}
  #calc-result,#public-calculator{scroll-margin-top:24px}
</style>
<style>
  :global(.directory:has(.calculator)){max-width:var(--site-width)}
  .calculator{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,var(--col-center)) minmax(0,1fr);gap:24px;align-items:start}
  #public-calculator{grid-column:1;grid-row:1;min-width:0}
  .calc-field{display:grid;gap:8px;margin-bottom:20px}
  .calc-field label{font-size:14px;color:var(--ink-2)}
  select{font:inherit;font-size:16px;color:var(--ink);background:var(--input-bg);border:1px solid var(--input-border);border-radius:var(--radius-sm);padding:12px;width:100%;min-height:48px}
  .calc-result{grid-column:2;grid-row:1;margin:0;position:sticky;top:20px;text-align:center}
  .calc-result .calc-price{font-size:clamp(24px,3vw,38px);color:var(--ink);font-weight:600;line-height:1.25}
  .calc-result .calc-hint{font-size:13px;margin-bottom:0}
  .calc-result .directory-button{width:100%;max-width:300px}
  .calc-notes{grid-column:3;grid-row:1;font-size:14px;line-height:1.55;color:var(--ink-2)}
  .calc-notes h2{font-size:16px;font-weight:600;margin-bottom:12px;color:var(--ink)}
  .calc-return{display:none;align-items:center;min-height:44px;margin-top:12px;text-underline-offset:4px}
  button{font:inherit;padding:8px 0;border:0;background:none;color:var(--teal-text);text-decoration:underline;cursor:pointer}
  @media(max-width:1100px){.calculator{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:28px}.calc-notes{grid-column:1/-1;grid-row:2;max-width:72ch}}
  @media(max-width:700px){.calculator{grid-template-columns:minmax(0,1fr);gap:28px}.calc-result{position:static;grid-column:1;grid-row:1}#public-calculator{grid-column:1;grid-row:2}.calc-notes{grid-column:1;grid-row:3}.calc-return{display:inline-flex}}
</style>
