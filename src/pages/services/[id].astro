---
// Страница направления — на общем каркасе (04.11.2026): первый экран слева, как на главной,
// секции с тонкой линией сверху, белые поверхности без обводки. Кейсы ведут в галерею проектов,
// внешний сайт — отдельной ссылкой. Залитая кнопка на странице одна — «Обсудить задачу».
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { SECTORS, LINKS } from '../../data/site';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';
import { RELATED } from '../../data/navigation';
import LinkList from '../../components/LinkList.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { href } from '../../lib/urls';

export function getStaticPaths() {
  return SECTORS.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const index = SECTORS.findIndex((s) => s.id === id);
const sector = SECTORS[index];
const service = SERVICES[id];
const prev = SECTORS[(index + SECTORS.length - 1) % SECTORS.length];
const next = SECTORS[(index + 1) % SECTORS.length];
const cases = service.cases.map((c) => PROJECTS.find((p) => p.id === c)).filter((p) => !!p);
// Крупные снимки галереи есть не у всех проектов — у остальных первый экран 640×400
const gallery = new Set(['alohagaia', 'wizzu', 'happyanimal']);
const pad = (n: number) => String(n).padStart(2, '0');

// Мини-колесо: четыре дуги на тех же местах, что сектора большого колеса в исходном положении.
// Текущий этап окрашен, остальные нейтральные.
const rad = (d: number) => (d * Math.PI) / 180;
const arc = (i: number) => {
  const s = SECTORS[i];
  const center = 180 - ((s.from + s.to) / 2 - 0.5) * (360 / 52);
  const a0 = center - 41;
  const a1 = center + 41;
  const r = 34;
  return `M${(r * Math.cos(rad(a0))).toFixed(2)} ${(r * Math.sin(rad(a0))).toFixed(2)} A${r} ${r} 0 0 1 ${(r * Math.cos(rad(a1))).toFixed(2)} ${(r * Math.sin(rad(a1))).toFixed(2)}`;
};
---

<Base title={`${service.title} — Эмилиус Эдженси`} description={service.lead}>
  <main class="direction ui-shell">
    <header class="ui-opening direction-opening">
      <Breadcrumbs items={[{ title: 'Услуги', href: 'services/' }, { title: service.title }]} />
      <div class="stage">
        <svg viewBox="-42 -42 84 84" class="mini" aria-hidden="true">
          <defs>
            <linearGradient id="cur" x1="-34" y1="-34" x2="34" y2="34" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color={sector.c1}></stop>
              <stop offset="1" stop-color={sector.c2}></stop>
            </linearGradient>
          </defs>
          {SECTORS.map((s, i) => (
            <path d={arc(i)} fill="none" stroke-width="7" stroke-linecap="round" style={i === index ? 'stroke:url(#cur)' : 'stroke:var(--hair)'}></path>
          ))}
        </svg>
        <p class="ui-eyebrow">Этап {index + 1} из 4 · дни <span class="num">{pad(sector.from)}–{pad(sector.to)}</span></p>
      </div>
      <h1 class="ui-h1">{service.title}</h1>
      <p class="ui-lead">{service.lead}</p>
      <div class="ui-actions">
        <a class="ui-button" href={href('#feedback')}>Обсудить задачу <span aria-hidden="true">→</span></a>
        {service.offer && <a class="ui-link" href={href(service.offer.href)}>{service.offer.title} <span class="ui-arrow" aria-hidden="true">→</span></a>}
      </div>
    </header>

    <section class="ui-section" aria-labelledby="t-scope">
      <div class="ui-section-head"><h2 id="t-scope">Состав работ</h2></div>
      <div class="cols">
        <div class="block ui-surface">
          <h3 id="t-doing">Что делаем</h3>
          <ul aria-labelledby="t-doing">{service.doing.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div class="block ui-surface">
          <h3 id="t-result">Что получаете</h3>
          <ul aria-labelledby="t-result">{service.result.map((d) => <li>{d}</li>)}</ul>
        </div>
      </div>
    </section>

    {service.offer && (
      <section class="ui-section" aria-labelledby="t-offer">
        <a class="offer ui-surface" href={href(service.offer.href)} aria-labelledby="t-offer">
          <div>
            <p class="ui-label">{service.offer.eyebrow}</p>
            <h2 id="t-offer">{service.offer.title}</h2>
            <p>{service.offer.text}</p>
          </div>
          <span class="offer-link">{service.offer.cta} <span aria-hidden="true">→</span></span>
        </a>
      </section>
    )}

    {cases.length > 0 && (
      <section class="ui-section" id="cases" aria-labelledby="t-cases">
        <div class="ui-section-head"><h2 id="t-cases">Проекты</h2><a class="ui-link" href={href('projects/')}>Все проекты <span class="ui-arrow" aria-hidden="true">→</span></a></div>
        <ul class:list={['cases', { single: cases.length === 1 }]} role="list">
          {cases.map((p) => (
            <li>
              <article class="case" aria-labelledby={`case-${p.id}`}>
                <a class="case-image" href={href(`projects/#${p.id}`)} aria-label={`Смотреть проект ${p.name}`}>
                  {gallery.has(p.id) ? (
                    <img
                      src={href(`cases/gallery/${p.id}-800.webp`)}
                      srcset={`${href(`cases/gallery/${p.id}-800.webp`)} 800w, ${href(`cases/gallery/${p.id}-1600.webp`)} 1600w`}
                      sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1238px) calc((100vw - 76px) / 2), 581px"
                      width="800" height="500" loading="lazy" decoding="async" alt={`Главная страница сайта ${p.name}`}
                    />
                  ) : (
                    <img src={href(p.shot)} width="640" height="400" loading="lazy" decoding="async" alt={`Первый экран сайта ${p.name}`} />
                  )}
                </a>
                <div class="case-body">
                  <h3 id={`case-${p.id}`}>{p.name}</h3>
                  <p>{p.about}</p>
                  {cases.length === 1 && <p>{p.did}</p>}
                  <a class="case-site" href={p.url} target="_blank" rel="noopener" aria-label={`${p.site ?? p.domain} — сайт ${p.name}, откроется в новой вкладке`}>{p.site ?? p.domain} <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="ui-section" aria-labelledby="t-related">
      <div class="ui-section-head"><h2 id="t-related">Следующий шаг по вашей задаче</h2></div>
      <div class="related ui-surface"><LinkList items={RELATED[id!]} /></div>
    </section>

    <nav class="cycle ui-section" aria-label="Этапы цикла">
      <a class="step" href={href(`services/${prev.id}/`)}><span class="dir">← до этого</span><span class="name">{prev.name}</span></a>
      <a class="ui-link telegram" href={LINKS.direct} target="_blank" rel="noopener">Обсудить в Telegram <span class="ui-arrow" aria-hidden="true">↗</span></a>
      <a class="step next" href={href(`services/${next.id}/`)}><span class="dir">дальше →</span><span class="name">{next.name}</span></a>
    </nav>
  </main>

  <Footer />
</Base>

<style>
  .stage { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .stage .ui-eyebrow { margin: 0; }
  .mini { width: 40px; height: 40px; flex: none; }
  .direction-opening { padding-top: 16px; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .block { padding: 28px 30px 30px; }
  .block h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: 600; margin: 0 0 16px; }
  .block ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .block li { position: relative; padding-left: 18px; color: var(--ink); line-height: 1.5; }
  .block li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }

  .offer { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding: 30px 32px; color: var(--ink); text-decoration: none; transition: transform 0.16s ease-out; }
  /* Нажатие на карточку — как у такой же карточки на главной: едва заметно проседает */
  .offer:active { transform: scale(0.99); }
  .offer h2 { font-size: 27px; line-height: 1.2; letter-spacing: -.02em; margin: 0 0 12px; }
  .offer p:not(.ui-label) { color: var(--ink-2); max-width: 60ch; }
  .offer-link { flex-shrink: 0; color: var(--teal-text); font-weight: 600; }
  .offer:focus-visible .offer-link { text-decoration: underline; text-underline-offset: 5px; }
  @media (hover: hover) and (pointer: fine) { .offer:hover .offer-link { text-decoration: underline; text-underline-offset: 5px; } }

  .cases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  /* Проект — карточка, как на /projects/ (05.11.2026): подписи не лежат на сером фоне между снимками */
  .case { min-width: 0; padding: 10px 10px 16px; background: var(--card); border: 2px solid var(--card-border); border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .case-image { display: block; border-radius: var(--radius-sm); overflow: hidden; background: var(--well); box-shadow: 0 0 0 1px var(--hair); }
  .case-image img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; }
  .case-body { padding: 16px 14px 0; display: grid; gap: 6px; justify-items: start; }
  .case-body h3 { font-size: var(--fs-h3); font-weight: 600; margin: 0 0 2px; }
  .case-body p { font-size: 15px; line-height: 1.5; color: var(--ink-2); max-width: 52ch; }
  .case-site { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 14px; font-weight: 600; text-underline-offset: 4px; overflow-wrap: anywhere; }
  /* Один проект — снимок слева, текст справа */
  .cases.single { grid-template-columns: 1fr; }
  .cases.single .case { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; align-items: center; }
  .cases.single .case { padding: 10px; }
  .cases.single .case-body { padding: 8px 24px 8px 0; }

  .related { padding: 0 26px; }
  .related :global(.link-list) { --list-inset: 26px; }

  .cycle { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-bottom: 0; }
  .step { display: flex; flex-direction: column; gap: 2px; color: var(--ink); text-decoration: none; min-height: 44px; justify-content: center; }
  .step.next { text-align: right; }
  .dir { font-size: 13px; color: var(--ink-3); }
  .name { font-weight: 600; font-size: 18px; text-transform: capitalize; transition: color var(--hover); }
  .step:focus-visible .name, .step:active .name { color: var(--teal-text); }
  @media (hover: hover) and (pointer: fine) { .step:hover .name { color: var(--teal-text); } }

  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; gap: 20px; }
    .block { padding: 22px 20px 24px; }
    .offer { flex-direction: column; align-items: flex-start; gap: 20px; padding: 24px; }
    .offer h2 { font-size: 24px; }
    .cases, .cases.single .case { grid-template-columns: 1fr; gap: 20px; }
    .case, .cases.single .case { padding: 8px 8px 12px; }
    .case-body, .cases.single .case-body { padding: 12px 10px 0; }
    .cases.single .case { gap: 4px; }
    .related { padding-inline: 18px; }
    .related :global(.link-list) { --list-inset: 18px; }
    .cycle { grid-template-columns: 1fr 1fr; }
    .telegram { grid-column: 1 / -1; grid-row: 2; justify-content: center; }
  }
</style>
