---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Footer from '../../components/Footer.astro';
import { SECTORS, LINKS } from '../../data/site';
import { SERVICES } from '../../data/services';
import { PROJECTS } from '../../data/projects';

export function getStaticPaths() {
  return SECTORS.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const index = SECTORS.findIndex((s) => s.id === id);
const sector = SECTORS[index];
const service = SERVICES[id];
const prev = SECTORS[(index + SECTORS.length - 1) % SECTORS.length];
const next = SECTORS[(index + 1) % SECTORS.length];
const cases = service.cases.map((c) => PROJECTS.find((p) => p.id === c)).filter(Boolean);

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
const pad = (n: number) => String(n).padStart(2, '0');

// Мини-колесо: четыре дуги на тех же местах, что сектора большого колеса в исходном положении.
// Текущий этап окрашен, остальные нейтральные.
const rad = (d: number) => (d * Math.PI) / 180;
const arc = (i: number) => {
  const s = SECTORS[i];
  const center = 180 - ((s.from + s.to) / 2 - 0.5) * (360 / 52);
  const a0 = center - 41;
  const a1 = center + 41;
  const r = 34;
  return `M${(r * Math.cos(rad(a0))).toFixed(2)} ${(r * Math.sin(rad(a0))).toFixed(2)} A${r} ${r} 0 0 1 ${(r * Math.cos(rad(a1))).toFixed(2)} ${(r * Math.sin(rad(a1))).toFixed(2)}`;
};
---

<Base title={`${service.title} — Эмилиус Эдженси`} description={service.lead}>
  <header class="top">
    <a href={base} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <main class="page">
    <section class="card intro">
      <div class="stage">
        <svg viewBox="-42 -42 84 84" class="mini" aria-hidden="true">
          <defs>
            <linearGradient id="cur" x1="-34" y1="-34" x2="34" y2="34" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color={sector.c1}></stop>
              <stop offset="1" stop-color={sector.c2}></stop>
            </linearGradient>
          </defs>
          {SECTORS.map((s, i) => (
            <path d={arc(i)} fill="none" stroke-width="7" stroke-linecap="round" style={i === index ? 'stroke:url(#cur)' : 'stroke:var(--hair)'}></path>
          ))}
        </svg>
        <p class="eyebrow">Этап {index + 1} из 4 · недели <span class="num">{pad(sector.from)}–{pad(sector.to)}</span></p>
      </div>
      <h1>{service.title}</h1>
      <p class="lead">{service.lead}</p>
    </section>

    <div class="cols">
      <section class="card block" aria-labelledby="t-doing">
        <h2 id="t-doing">Что делаем</h2>
        <ul>{service.doing.map((d) => <li>{d}</li>)}</ul>
      </section>
      <section class="card block" aria-labelledby="t-result">
        <h2 id="t-result">Что получаете</h2>
        <ul>{service.result.map((d) => <li>{d}</li>)}</ul>
      </section>
    </div>

    {cases.length > 0 && (
      <section class="card block" aria-labelledby="t-cases">
        <h2 id="t-cases">Проекты</h2>
        <ul class="cases">
          {cases.map((p) => (
            <li>
              <a href={p!.url} target="_blank" rel="noopener" class="case">
                <img src={href(p!.shot)} alt={`Первый экран сайта ${p!.domain}`} width="640" height="400" loading="lazy" decoding="async" />
                <span class="case-text">{p!.about}</span>
                <span class="case-link">{p!.domain} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="cycle" aria-label="Этапы цикла">
      <a class="step" href={href(`services/${prev.id}/`)}><span class="dir">← до этого</span><span class="name">{prev.name}</span></a>
      <a class="cta" href={LINKS.direct} target="_blank" rel="noopener">Обсудить в Telegram</a>
      <a class="step next" href={href(`services/${next.id}/`)}><span class="dir">дальше →</span><span class="name">{next.name}</span></a>
    </nav>
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .page {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro {
    padding: 28px 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stage {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mini {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(30px, 5vw, 38px);
    line-height: 1.15;
  }
  .lead {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 58ch;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .block {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .block h2 {
    font-size: 20px;
    line-height: 1.15;
  }
  .block ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .block li {
    position: relative;
    padding-left: 18px;
  }
  .block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
  }
  .cases {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px !important;
  }
  .cases li {
    padding: 0 !important;
  }
  .cases li::before {
    display: none;
  }
  .case {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .case img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--hair);
    background: var(--well);
  }
  .case-link {
    color: var(--teal-text);
    font-weight: 600;
  }
  .case:hover .case-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cycle {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-top: 4px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: inherit;
    text-decoration: none;
  }
  .step.next {
    text-align: right;
  }
  .dir {
    font-size: 13px;
    color: var(--ink-3);
  }
  .name {
    font-weight: 600;
    font-size: 18px;
    transition: color var(--hover);
  }
  .step:hover .name {
    color: var(--teal-text);
  }
  .cta {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    padding-inline: 22px;
    border-radius: var(--radius-btn);
    background: var(--teal-btn);
    color: #fff;
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: color var(--hover);
  }
  .cta:hover {
    color: var(--on-teal);
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .cycle {
      grid-template-columns: 1fr 1fr;
    }
    .cta {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
    }
  }
</style>
