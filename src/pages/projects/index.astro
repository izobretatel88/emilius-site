---
import Directory from '../../layouts/Directory.astro';
import {PROJECTS} from '../../data/projects';
import {FRESH_SHOP} from '../../data/insales';
import {DIRECTIONS} from '../../data/navigation';
import {SERVICES} from '../../data/services';
import {href} from '../../lib/urls';
const projects=[{id:FRESH_SHOP.id,name:FRESH_SHOP.name,shot:'cases/happyanimal.webp',about:FRESH_SHOP.what,did:FRESH_SHOP.done.join('. '),url:FRESH_SHOP.url,domain:FRESH_SHOP.domain},...PROJECTS];
const dirs=(id:string)=>DIRECTIONS.filter(d=>SERVICES[d.id].cases.includes(id) || (id==='happyanimal' && ['dev','marketing'].includes(d.id)));
const filters=DIRECTIONS.filter(d=>projects.some(p=>dirs(p.id).some(x=>x.id===d.id)));
---
<Directory title="Проекты" description="Интернет-магазины, интерфейсы и развитие сайтов. В каждом проекте — конкретная работа команды и направление, с которым она связана.">
  <div class="project-filter" hidden><label for="project-direction">Показать направление</label><select id="project-direction"><option value="">Все проекты</option>{filters.map(d=><option value={d.id}>{d.title}</option>)}</select><p id="project-count" role="status">Все проекты: {projects.length}</p></div>
  <div class="project-list">{projects.map(p=><article class="project" id={p.id} data-directions={dirs(p.id).map(d=>d.id).join(' ')}>
    <img src={href(p.shot)} alt={`Первый экран сайта ${p.name}`} width="640" height="400" loading="lazy" decoding="async" />
    <div><h2>{p.name}</h2><p class="project-label">О проекте</p><p>{p.about}</p><p class="project-label">Что сделали</p><p>{p.did}</p><a class="project-site" href={p.url} target="_blank" rel="noopener" aria-label={`Открыть сайт ${p.domain} в новой вкладке`}>Открыть {p.domain} ↗</a><nav class="directory-tags" aria-label={`Направления проекта ${p.name}`}>{dirs(p.id).map(d=><a href={href(d.href)}>{d.title}</a>)}{p.id==='happyanimal' && <a href={href('services/insales-shop/')}>Магазин на InSales</a>}</nav></div>
  </article>)}</div>
  <section class="directory-callout"><h2>Обсудим ваш продукт?</h2><p>Расскажите, что хотите запустить или улучшить.</p><a class="directory-button" href={href('#feedback')}>Обсудить проект</a></section>
</Directory>
<script>
  const filter=document.querySelector<HTMLSelectElement>('#project-direction');
  if(filter){
    document.querySelector<HTMLElement>('.project-filter')!.hidden=false;
    const rows=[...document.querySelectorAll<HTMLElement>('.project')];
    const apply=()=>{
      let shown=0;
      rows.forEach(row=>{row.hidden=!!filter.value&&!row.dataset.directions?.split(' ').includes(filter.value);if(!row.hidden)shown++;});
      document.querySelector('#project-count')!.textContent=`Показано ${shown} из ${rows.length} проектов`;
    };
    filter.addEventListener('change',apply);
    // Прямая ссылка на проект должна оставлять его видимым.
    const reveal=()=>{if(rows.some(row=>`#${row.id}`===location.hash&&row.hidden)){filter.value='';apply();}};
    window.addEventListener('hashchange',reveal);
    apply();reveal();
  }
</script>
<style>
  .project-filter{display:flex;align-items:center;flex-wrap:wrap;gap:10px 16px;margin-bottom:28px;font-size:14px}
  .project-filter[hidden],.project[hidden]{display:none}
  .project-filter select{font:inherit;min-height:44px;padding:8px 12px;background:var(--card);color:var(--ink);border:1px solid var(--input-border);border-radius:var(--radius-sm)}
  #project-count{color:var(--ink-2)}
  @media(max-width:600px){.project-filter select{font-size:16px}}
  .project .project-label{font-size:13px;font-weight:700;color:var(--ink);margin:18px 0 0}
  .project .project-label+p{margin-top:4px}
  .project-site{display:inline-flex;align-items:center;min-height:44px;text-underline-offset:4px;overflow-wrap:anywhere}
</style>
<style>.project{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;padding:30px 0;border-bottom:1px solid var(--hair)}.project:first-child{padding-top:0}.project img{width:100%;height:auto;display:block;border-radius:var(--radius-sm)}.project h2{font-size:28px;margin-bottom:12px}.project p{color:var(--ink-2);margin:10px 0;font-size:15px;max-width:65ch}.project-list{display:grid;gap:10px}@media(max-width:650px){.project{grid-template-columns:1fr;gap:20px}.project h2{font-size:25px}}</style>
