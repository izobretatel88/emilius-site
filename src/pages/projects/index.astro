---
/* Галерея работ: сайт клиента — главный экспонат, наша роль — короткая подпись.
   Сохраняем Glober, токены и общую навигацию. Первый проект — крупно, остальные
   по два на широком экране. На телефоне один столбец. Превью открывается крупно;
   внешний сайт — отдельная ссылка. Только подтверждённые роли и результаты. */
import Directory from '../../layouts/Directory.astro';
import {PROJECTS} from '../../data/projects';
import {FRESH_SHOP} from '../../data/insales';
import {href} from '../../lib/urls';

const captions:Record<string,{kind:string;role:string;updated?:boolean}> = {
  happyanimal:{kind:'Зоомагазин и груминг',role:'Магазин на InSales · местное SEO',updated:true},
  alohagaia:{kind:'Ювелирные украшения',role:'Фронтенд · интеграции · собственные модули',updated:true},
  duman:{kind:'Одежда, созданная в Сибири',role:'Фронтенд на InSales'},
  wizzu:{kind:'Доставка продуктов',role:'Сайт-витрина · интеграции',updated:true},
  geekboards:{kind:'Механические клавиатуры и аксессуары',role:'Развитие магазина · фронтенд'},
  navalishenskoe:{kind:'Отдых в Сочи',role:'Развитие сайта · SEO'},
};
const projects=[
  {id:FRESH_SHOP.id,name:FRESH_SHOP.name,shot:'cases/happyanimal.webp',url:FRESH_SHOP.url,domain:FRESH_SHOP.domain},
  ...['alohagaia','duman','wizzu','geekboards','navalishenskoe'].map(id=>PROJECTS.find(p=>p.id===id)!),
].map(p=>{
  const meta=captions[p.id];
  return {...p,...meta,
    image:meta.updated?`cases/gallery/${p.id}-1600.webp`:p.shot,
    small:meta.updated?`cases/gallery/${p.id}-800.webp`:undefined,
    width:meta.updated?1600:640,height:meta.updated?1000:400,
  };
});
// Только проверенные снимки этого проекта. В mobile/wizzu.webp показан другой
// магазин сети («Вкусдом»), поэтому не выдаём его за мобильный LimeMart.
const phoneHeights:Record<string,number>={happyanimal:1069,alohagaia:1068,duman:1071,geekboards:1069};
const media=Object.fromEntries(projects.map(p=>[p.id,{
  name:p.name,
  inquiry:href(`?project=${p.id}#feedback`),
  screens:[
    {device:'desktop',label:'Главная',src:href(p.image),width:p.width,height:p.height},
    ...(phoneHeights[p.id]?[{device:'phone',label:p.id==='geekboards'?'Главная':'Каталог',src:href(`cases/mobile/${p.id}.webp`),width:520,height:phoneHeights[p.id]}]:[]),
  ],
}]));
---
<Directory title="Проекты" description="Магазины и сайты, над которыми мы работали. Фронтенд, интеграции и развитие.">
  <div class="gallery-intro"><span>Избранные работы · {projects.length} проектов</span><a href={href('#feedback')}>Обсудить ваш проект</a></div>
  <div class="project-gallery">
    {projects.map((p,index)=><article class:list={['project',{'project-featured':index===0}]} id={p.id} aria-labelledby={`title-${p.id}`}>
      <a class="project-preview" href={href(p.image)} data-project-preview={p.id} aria-label={`Смотреть крупнее: ${p.name}`}>
        <img src={href(p.image)} srcset={p.small?`${href(p.small)} 800w, ${href(p.image)} 1600w`:undefined} sizes={index===0?'(max-width: 1120px) calc(100vw - 40px), 1080px':'(max-width: 700px) calc(100vw - 24px), (max-width: 1120px) calc((100vw - 72px) / 2), 524px'} alt={`Скриншот сайта ${p.name}`} width={p.width} height={p.height} loading={index===0?'eager':'lazy'} decoding="async" />
        <span class="preview-action" aria-hidden="true">Смотреть крупнее</span>
      </a>
      <div class="project-caption">
        <div><p class="project-kind">{p.kind}</p><h2 id={`title-${p.id}`}>{p.name}</h2><p class="project-role">{p.role}</p></div>
        <a class="project-site" href={p.url} target="_blank" rel="noopener" aria-label={`${p.id==='wizzu'?'limemart.wizzu.ru':p.domain} — сайт ${p.name}, откроется в новой вкладке`}>{p.id==='wizzu'?'limemart.wizzu.ru':p.domain} <span aria-hidden="true">↗</span></a>
      </div>
      <a class="project-inquiry" href={href(`?project=${p.id}#feedback`)} aria-label={`${p.id==='navalishenskoe'?'Хочу похожий сайт':'Хочу похожий магазин'} — ${p.name}`}>{p.id==='navalishenskoe'?'Хочу похожий сайт':'Хочу похожий магазин'}</a>
      {p.id==='happyanimal' && <a class="project-result" href={href('services/insales-shop/#case-happyanimal')}><span><strong>5 из 5</strong> локальных запросов — в топ-5 Яндекса<span class="result-date">Москва · 01.10.2026 · Топвизор</span></span></a>}
    </article>)}
    <section class="gallery-contact" aria-labelledby="t-project-contact"><p>Следующий проект</p><h2 id="t-project-contact">Покажем здесь<br />и ваш сайт?</h2><a class="directory-button" href={href('#feedback')}>Обсудить проект</a><span class="contact-note">Расскажите, что хотите запустить или улучшить.</span></section>
  </div>
  <dialog class="project-viewer" aria-labelledby="viewer-title">
    <div class="viewer-toolbar"><h2 id="viewer-title"></h2><button type="button" data-close-viewer aria-label="Закрыть просмотр">Закрыть <span aria-hidden="true">×</span></button></div>
    <div class="viewer-controls">
      <div class="viewer-devices" role="group" aria-label="Вид сайта"><button type="button" data-device="desktop" aria-pressed="true">Компьютер</button><button type="button" data-device="phone" aria-pressed="false">Телефон</button></div>
      <div class="viewer-screens" role="group" aria-label="Экраны сайта"></div>
      <div class="viewer-zoom" role="group" aria-label="Масштаб снимка"><button type="button" data-scale="fit" aria-pressed="true" aria-controls="viewer-canvas">Вписать</button><button type="button" data-scale="actual" aria-pressed="false" aria-controls="viewer-canvas">100%</button></div>
      <a class="viewer-inquiry" href={href('#feedback')}>Хочу похожий магазин</a>
    </div>
    <div class="viewer-status" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="viewer-error" role="alert" hidden>Снимок не загрузился. <button type="button" data-retry-viewer>Повторить</button></div>
    <div class="viewer-image" id="viewer-canvas" role="region" aria-label="Скриншот проекта. Область прокрутки" tabindex="0" aria-busy="false"><img src={href(projects[0].image)} alt="Скриншот сайта Happy Animal" width="1600" height="1000" loading="lazy" /></div>
    <div class="viewer-paging" hidden><button type="button" data-prev-screen aria-label="Предыдущий экран">← Назад</button><button type="button" data-next-screen aria-label="Следующий экран">Дальше →</button></div>
  </dialog>
  <script type="application/json" id="project-media" set:html={JSON.stringify(media)} />
</Directory>
<script>
  import {setupProjectViewer} from '../../lib/project-viewer';
  setupProjectViewer();
</script>
<style>
  :global(.directory:has(.project-gallery) .directory-intro){margin-bottom:22px;max-width:740px}
  :global(.directory:has(.project-gallery) .directory-intro h1){font-size:clamp(36px,5vw,56px)}
  :global(.directory:has(.project-gallery) .directory-intro p){max-width:54ch}
  .gallery-intro{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 24px;margin-bottom:16px;font-size:14px;color:var(--ink-2)}
  .gallery-intro a{display:inline-flex;align-items:center;gap:16px;min-height:44px;text-underline-offset:4px;font-weight:600}
  .project-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px 32px}
  .project{min-width:0;scroll-margin-top:24px}
  .project-featured{grid-column:1/-1}
  .project-preview{position:relative;display:block;overflow:hidden;border-radius:var(--radius-card);background:var(--well);text-decoration:none;cursor:zoom-in;box-shadow:var(--shadow-card)}
  .project-preview img{display:block;width:100%;height:auto;aspect-ratio:8/5;object-fit:cover;object-position:top;transition:filter var(--hover)}
  .preview-action{position:absolute;right:14px;bottom:14px;display:flex;align-items:center;gap:20px;background:var(--card);color:var(--ink);padding:10px 14px;border-radius:var(--radius-btn);box-shadow:var(--shadow-card);font-size:13px;font-weight:600;transition:background-color var(--hover),color var(--hover)}
  .project-preview:hover .preview-action,.project-preview:focus-visible .preview-action{background:var(--teal-btn);color:var(--on-teal)}
  .project-caption{display:flex;align-items:start;justify-content:space-between;gap:12px 24px;margin-top:20px}
  .project-kind{font-size:13px;color:var(--ink-2);margin-bottom:5px}
  .project h2{font-size:28px;line-height:1.15;margin:0}
  .project-featured h2{font-size:34px}
  .project-role{font-size:14px;line-height:1.5;color:var(--ink-2);margin-top:8px}
  .project-site{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:14px;font-weight:600;text-underline-offset:4px;overflow-wrap:anywhere;flex-shrink:0}
  .project-inquiry{display:inline-flex;align-items:center;gap:16px;min-height:44px;margin-top:8px;font-size:14px;font-weight:600;text-underline-offset:4px}
  .project-result{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:18px;margin-top:18px;border-top:1px solid var(--hair);color:var(--ink);text-decoration:none;font-size:16px;min-height:64px}
  .project-result strong{color:var(--teal-text)}
  .project-result:hover strong{text-decoration:underline;text-underline-offset:4px}
  .result-date{display:block;margin-top:4px;color:var(--ink-3);font-size:12px}
  .gallery-contact{display:flex;flex-direction:column;align-items:start;justify-content:center;min-height:320px;padding:36px;background:var(--card);border-radius:var(--radius-card);box-shadow:var(--shadow-card)}
  .gallery-contact>p{font-size:14px;color:var(--ink-2);margin-bottom:16px}
  .gallery-contact h2{font-size:clamp(30px,3vw,40px);line-height:1.15;margin:0 0 28px}
  .gallery-contact a{gap:28px}
  .contact-note{font-size:14px;color:var(--ink-2);line-height:1.5;margin-top:16px;max-width:30ch}
  .project-viewer{width:min(1440px,calc(100% - 40px));max-width:none;max-height:calc(100svh - 40px);padding:0;border:0;border-radius:var(--radius-card);background:var(--card);color:var(--ink);box-shadow:var(--shadow-pop)}
  .project-viewer::backdrop{background:var(--viewer-backdrop)}
  :global(html:has(.project-viewer[open])){overflow:hidden}
  .viewer-toolbar{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;background:var(--card);border-bottom:1px solid var(--hair)}
  .viewer-toolbar h2{font-size:20px;line-height:1.2}
  .viewer-toolbar button{display:inline-flex;align-items:center;gap:16px;min-height:44px;padding:0 12px;font:inherit;font-size:14px;cursor:pointer;background:var(--well);color:var(--ink);border:0;border-radius:var(--radius-sm)}
  .viewer-toolbar button span{font-size:24px}
  .viewer-image{overflow:auto}
  .viewer-image img{display:block;width:100%;max-width:var(--screen-width,100%);height:auto;margin-inline:auto}
  .viewer-image[data-scale='actual'] img{width:var(--screen-width);max-width:none}
  .viewer-image img[hidden]{display:none}
  .viewer-image[aria-busy='true'] img{visibility:hidden}
  .viewer-image:focus-visible{outline-offset:-3px}
  .viewer-controls{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding:12px 20px;border-bottom:1px solid var(--hair)}
  .viewer-devices,.viewer-screens,.viewer-zoom{display:flex;flex-wrap:wrap;gap:4px}
  .viewer-devices[hidden],.viewer-screens[hidden],.viewer-zoom[hidden]{display:none}
  .viewer-controls :global(button),.viewer-paging button,.viewer-error button{font:inherit;font-size:14px;min-height:44px;padding:8px 14px;border:0;border-radius:var(--radius-sm);background:var(--well);color:var(--ink);cursor:pointer}
  .viewer-controls :global(button[aria-pressed='true']){background:var(--teal-btn);color:var(--on-teal)}
  .viewer-controls button[hidden],.viewer-paging[hidden],.viewer-error[hidden]{display:none}
  .viewer-inquiry{display:inline-flex;align-items:center;min-height:44px;margin-left:auto;font-size:14px;font-weight:600;text-underline-offset:4px}
  .viewer-status{font-size:13px;min-height:36px;padding:8px 20px;color:var(--ink-2)}
  .viewer-error{padding:8px 20px;color:var(--ink);font-size:14px}
  .viewer-paging{display:flex;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--hair)}
  .viewer-paging button:disabled{color:var(--ink-3);cursor:default}
  .viewer-image[data-device='phone']{padding:20px;background:var(--well)}
  .viewer-image[data-device='phone'] img{width:min(100%,390px);height:auto;margin-inline:auto;max-width:100%}
  @media(max-width:1000px){.project-caption{flex-direction:column;gap:2px}.project-site{min-height:44px}.project-featured .project-caption{flex-direction:row}}
  @media(max-width:700px){
    .project-gallery{grid-template-columns:1fr;gap:36px}
    .project-featured{grid-column:auto}
    .project-caption,.project-featured .project-caption{flex-direction:column;margin-top:16px}
    .project h2,.project-featured h2{font-size:26px}
    .project-role{margin-top:6px}
    .project-result{font-size:15px}
    .gallery-intro{margin-bottom:14px}
    .gallery-contact{padding:28px;min-height:290px}
    .preview-action{right:10px;bottom:10px;padding:8px 12px;font-size:12px;gap:12px}
    .project-viewer{width:calc(100% - 16px);max-height:calc(100svh - 16px);border-radius:var(--radius-sm)}
    .viewer-toolbar{padding:8px 12px}
    .viewer-toolbar h2{font-size:18px}
    .viewer-controls{padding:8px 12px;gap:8px 12px}
    .viewer-inquiry{margin-left:0}
  }
  @media(prefers-reduced-motion:reduce){.project-preview img,.preview-action{transition:none}}
</style>
