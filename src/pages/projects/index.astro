---
/* Галерея работ: сайт клиента — главный экспонат, наша роль — короткая подпись.
   Сохраняем Glober, токены и общую навигацию. Первый проект — крупно, остальные
   по два на широком экране. На телефоне один столбец. Превью открывается крупно;
   внешний сайт — отдельная ссылка. Только подтверждённые роли и результаты. */
import Directory from '../../layouts/Directory.astro';
import {PROJECTS} from '../../data/projects';
import {FRESH_SHOP,TEMPLATE_SHOPS,MORE_SHOPS} from '../../data/insales';
import {href} from '../../lib/urls';
import {SECTORS} from '../../data/site';
import {SERVICES} from '../../data/services';

// Метка этапа: проект показан как кейс направления (SERVICES[...].cases) — значит, работа шла на этом этапе итерации.
// Берём только эту связь из данных; у проектов без неё метки нет. Дни этапа на колесе (27–39 и т. п.) здесь
// не показываем (12.11.2026, владелец): в карточке они читаются как сроки конкретного проекта.
const stagesOf=(id:string)=>SECTORS.filter(s=>SERVICES[s.id].cases.includes(id)).map(s=>({id:s.id,title:SERVICES[s.id].title}));

const captions:Record<string,{kind:string;role:string;updated?:boolean}> = {
  happyanimal:{kind:'Зоомагазин и груминг',role:'Магазин на inSales · местное SEO',updated:true},
  alohagaia:{kind:'Ювелирные украшения',role:'Фронтенд · интеграции · собственные модули',updated:true},
  duman:{kind:'Одежда, созданная в Сибири',role:'Фронтенд на inSales'},
  wizzu:{kind:'Доставка продуктов',role:'Сайт-витрина · интеграции',updated:true},
  geekboards:{kind:'Механические клавиатуры и аксессуары',role:'Развитие магазина · фронтенд',updated:true},
  navalishenskoe:{kind:'Отдых в Сочи',role:'Развитие сайта · SEO',updated:true},
  // Роли — из карточки партнёра inSales (стенд /extra/insales-stend/, 13.11.2026)
  zalina:{kind:'Авторская одежда',role:'Фронтенд по готовому дизайну · доработки',updated:true},
  mnogoles:{kind:'Пиломатериалы от производителя',role:'Магазин с нуля · калькуляторы',updated:true},
  almatennis:{kind:'Теннисный магазин в Москве',role:'Магазин на готовой теме inSales',updated:true},
  'ss-sk':{kind:'Системы безопасности в Сочи',role:'Магазин на готовой теме inSales',updated:true},
  nsorganic:{kind:'Грибы и травы',role:'Магазин на готовой теме inSales',updated:true},
};
// Магазины из карточки партнёра inSales: ссылки и названия — из данных лендинга, без повтора
const shop=(name:string)=>MORE_SHOPS.find(x=>x.name===name)!;
const template=(id:string)=>{const x=TEMPLATE_SHOPS.find(t=>t.id===id)!;return {id,name:x.name,shot:`cases/${id}.webp`,url:x.url,domain:x.domain};};
const projects=[
  PROJECTS.find(p=>p.id==='alohagaia')!,
  {id:FRESH_SHOP.id,name:FRESH_SHOP.name,shot:'cases/happyanimal.webp',url:FRESH_SHOP.url,domain:FRESH_SHOP.domain},
  ...['duman','wizzu','geekboards'].map(id=>PROJECTS.find(p=>p.id===id)!),
  {id:'zalina',name:shop('Zalina Verkhovskaya').name,shot:'cases/gallery/zalina-800.webp',url:shop('Zalina Verkhovskaya').url,domain:shop('Zalina Verkhovskaya').domain},
  {id:'mnogoles',name:shop('Многолес').name,shot:'cases/gallery/mnogoles-800.webp',url:shop('Многолес').url,domain:shop('Многолес').domain},
  ...['almatennis','ss-sk','nsorganic'].map(template),
  PROJECTS.find(p=>p.id==='navalishenskoe')!,
].map(p=>{
  const meta=captions[p.id];
  return {...p,...meta,
    image:meta.updated?`cases/gallery/${p.id}-1600.webp`:p.shot,
    small:meta.updated?`cases/gallery/${p.id}-800.webp`:undefined,
    width:meta.updated?1600:640,height:meta.updated?1000:400,
  };
});
// Только проверенные снимки этого проекта. В mobile/wizzu.webp показан другой
// магазин сети («Вкусдом»), поэтому не выдаём его за мобильный LimeMart.
const phoneHeights:Record<string,number>={happyanimal:1069,alohagaia:1068,duman:1071,geekboards:1069,zalina:1071,almatennis:1069,nsorganic:1069};
const media=Object.fromEntries(projects.map(p=>[p.id,{
  name:p.name,
  inquiry:href(`?project=${p.id}#feedback`),
  screens:[
    {device:'desktop',label:'Главная',src:href(p.image),width:p.width,height:p.height},
    ...(phoneHeights[p.id]?[{device:'phone',label:['geekboards','zalina','almatennis'].includes(p.id)?'Главная':'Каталог',src:href(`cases/mobile/${p.id}.webp`),width:520,height:phoneHeights[p.id]}]:[]),
  ],
}]));
---
<Directory title="Проекты" description="Магазины и сайты, над которыми мы работали. Фронтенд, интеграции и развитие.">
  <div class="gallery-intro"><span>Избранные работы · {projects.length} проектов</span><a href={href('#feedback')}>Обсудить ваш проект</a></div>
  <div class="project-gallery">
    {projects.map((p,index)=><article class:list={['project',{'project-featured':index===0}]} id={p.id} aria-labelledby={`title-${p.id}`}>
      <a class="project-preview" href={href(p.image)} data-project-preview={p.id} aria-label={`Смотреть крупнее: ${p.name}`}>
        <img src={href(p.image)} srcset={p.small?`${href(p.small)} 800w, ${href(p.image)} 1600w`:undefined} sizes={index===0?'(max-width: 1238px) calc(100vw - 48px), 1190px':'(max-width: 700px) calc(100vw - 24px), (max-width: 1238px) calc((100vw - 80px) / 2), 579px'} alt={`Скриншот сайта ${p.name}`} width={p.width} height={p.height} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':undefined} decoding={index===0?undefined:'async'} />
        <span class="preview-action" aria-hidden="true">Смотреть крупнее</span>
      </a>
      <div class="project-caption">
        <div><p class="project-kind">{p.kind}</p><h2 id={`title-${p.id}`}>{p.name}</h2><p class="project-role">{p.role.replaceAll(' · ','\u00a0· ')}</p>{stagesOf(p.id).map(s=><a class="ui-stage-tag project-stage" href={href(`services/${s.id}/`)} data-stage={s.id}><i class="ui-stage-dot" aria-hidden="true"></i><span>{s.title}</span></a>)}</div>
        <a class="project-site" href={p.url} target="_blank" rel="noopener" aria-label={`${p.site ?? p.domain} — сайт ${p.name}, откроется в новой вкладке`}>{p.site ?? p.domain}</a>
      </div>
      {p.id==='wizzu' && <p class="project-result"><span><strong>2000+</strong> заказов в месяц — стартап вырос с нуля</span></p>}
      {p.id==='happyanimal' && <a class="project-result" href={href('services/insales-shop/#case-happyanimal')}><span><strong>5 из 5</strong> локальных запросов — в топ-5 Яндекса<span class="result-date">Москва · 01.10.2026 · Топвизор</span><span class="visually-hidden">. Разбор кейса на странице «Магазин на шаблоне inSales»</span></span><span class="result-arrow" aria-hidden="true">→</span></a>}
      <a class="project-inquiry" href={href(`?project=${p.id}#feedback`)} aria-label={`${p.id==='navalishenskoe'?'Хочу похожий сайт':'Хочу похожий магазин'} — ${p.name}`}>{p.id==='navalishenskoe'?'Хочу похожий сайт':'Хочу похожий магазин'}</a>
    </article>)}
    <section class="gallery-contact" aria-labelledby="t-project-contact"><p>Следующий проект</p><h2 id="t-project-contact">Покажем здесь<br />и ваш сайт?</h2><p class="contact-note">Расскажите, что хотите запустить или улучшить.</p><a class="directory-button" href={href('#feedback')}>Обсудить проект</a></section>
  </div>
  <dialog class="project-viewer" aria-labelledby="viewer-title">
    <div class="viewer-toolbar"><h2 id="viewer-title"></h2><button type="button" data-close-viewer aria-label="Закрыть просмотр">Закрыть <span aria-hidden="true">×</span></button></div>
    <div class="viewer-controls">
      <div class="viewer-devices" role="group" aria-label="Вид сайта"><button type="button" data-device="desktop" aria-pressed="true">Компьютер</button><button type="button" data-device="phone" aria-pressed="false">Телефон</button></div>
      <div class="viewer-screens" role="group" aria-label="Экраны сайта"></div>
      <div class="viewer-zoom" role="group" aria-label="Масштаб снимка"><button type="button" data-scale="fit" aria-pressed="true" aria-controls="viewer-canvas">По ширине</button><button type="button" data-scale="actual" aria-pressed="false" aria-controls="viewer-canvas">100%</button></div>
      <a class="viewer-inquiry" href={href('#feedback')}>Хочу похожий магазин</a>
    </div>
    <div class="viewer-status" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="viewer-error" role="alert" hidden>Снимок не загрузился. <button type="button" data-retry-viewer>Повторить</button></div>
    <div class="viewer-image" id="viewer-canvas" role="region" aria-label="Скриншот проекта. Область прокрутки" tabindex="-1" aria-busy="false"><img src={href(projects[0].image)} alt={`Скриншот сайта ${projects[0].name}`} width={projects[0].width} height={projects[0].height} loading="lazy" /></div>
    <div class="viewer-paging" hidden><button type="button" data-prev-screen aria-label="Предыдущий экран">← Назад</button><button type="button" data-next-screen aria-label="Следующий экран">Дальше →</button></div>
  </dialog>
  <script type="application/json" id="project-media" set:html={JSON.stringify(media)} />
</Directory>
<script>
  import {setupProjectViewer} from '../../lib/project-viewer';
  setupProjectViewer();
</script>
<style>
  .gallery-intro{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 24px;margin-bottom:24px;padding-top:12px;border-top:1px solid var(--hair);font-size:var(--fs-ui);color:var(--ink-2)}
  .gallery-intro a{display:inline-flex;align-items:center;gap:16px;min-height:44px;text-underline-offset:4px;font-weight:600}
  .project-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
  /* Каждый проект — белая карточка на сером фоне (05.11.2026, по замечанию владельца): проекты не сливаются */
  .project{min-width:0;scroll-margin-top:24px;display:flex;flex-direction:column;padding:10px 10px 22px;background:var(--card);border:2px solid var(--card-border);border-radius:var(--radius-card);box-shadow:var(--shadow-card)}
  .project>:not(.project-preview){margin-inline:16px}
  /* Доказательство (результат) — до действия; «Хочу похожий…» прижата к низу карточки, в ряду стоит на одной линии */
  .project>.project-inquiry{align-self:start;margin-top:auto}
  .project-caption,.project-result{margin-bottom:8px}
  .project-featured{grid-column:1/-1}
  .project-preview{position:relative;display:block;overflow:hidden;border-radius:var(--radius-sm);background:var(--well);text-decoration:none;cursor:zoom-in;box-shadow:0 0 0 1px var(--hair);transition:transform var(--press)}
  /* Нажатие на превью: большая плитка едва проседает, как карточки «Полезного» и услуг */
  .project-preview:active{transform:scale(var(--press-scale-card))}
  /* У этих элементов своё нажатие (проседание или заливка) — серый прямоугольник касания браузера поверх него лишний */
  .project-preview,a.project-result,.project-inquiry,.viewer-toolbar button,.viewer-controls :global(button),.viewer-paging button,.viewer-error button{-webkit-tap-highlight-color:transparent}
  .project-preview img{display:block;width:100%;height:auto;aspect-ratio:8/5;object-fit:cover;object-position:top;filter:var(--img-dim);transition:filter var(--hover)}
  .preview-action{position:absolute;right:14px;bottom:14px;display:flex;align-items:center;gap:20px;background:var(--card);color:var(--ink);padding:10px 14px;border-radius:var(--radius-btn);box-shadow:var(--shadow-card);font-size:var(--fs-small);font-weight:600;transition:background-color var(--hover),color var(--hover)}
  .project-preview:focus-visible .preview-action {background:var(--teal-btn);color:var(--on-teal)}
  @media (hover: hover) and (pointer: fine) { .project-preview:hover .preview-action {background:var(--teal-btn);color:var(--on-teal)} .project-preview:hover img {filter:none} }
  .project-preview:focus-visible img {filter:none}
  .project-preview:active .preview-action {background:var(--teal-btn);color:var(--on-teal)}
  .project-caption{display:flex;flex-wrap:wrap;align-items:start;justify-content:space-between;gap:12px 24px;margin-top:20px}
  .project-caption>div{min-width:0;flex:1 1 220px}
  .project-kind{font-size:var(--fs-small);color:var(--ink-2);margin-bottom:5px}
  .project h2{font-size:28px;line-height:1.15;letter-spacing:-.02em;margin:0}
  .project-featured h2{font-size:var(--fs-h2);letter-spacing:var(--tracking-tight)}
  /* Что мы сделали — главное в подписи: основной кегль и полный цвет текста, а не серая сноска */
  .project-role{font-size:var(--fs-body);line-height:1.5;color:var(--ink);margin-top:8px}
  /* Метка этапа — общий класс .ui-stage-tag (layout.css): точка цвета этапа и направление, без дней колеса */
  .project-stage{margin-top:2px}
  .project-site{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:var(--fs-ui);font-weight:600;text-underline-offset:4px;overflow-wrap:anywhere;max-width:100%;flex-shrink:1}
  .project-inquiry{display:inline-flex;align-items:center;gap:16px;min-height:44px;font-size:var(--fs-ui);font-weight:600;text-underline-offset:4px}
  p.project-result{margin-bottom:0}
  .project-result{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:18px;margin-top:18px;border-top:1px solid var(--hair);color:var(--ink);text-decoration:none;font-size:var(--fs-body);min-height:64px}
  /* Бирюзовый — цвет ссылок: цифра красится только там, где строка ведёт на кейс */
  .project-result strong{color:var(--ink)}
  a.project-result strong{color:var(--teal-text)}
  @media (hover: hover) and (pointer: fine) { a.project-result:hover strong {text-decoration:underline;text-underline-offset:4px} }
  /* Строка ведёт на разбор кейса: стрелка справа и сдвиг на 3 px при наведении, фокусе и касании — как в списках-ссылках сайта */
  .result-arrow{flex-shrink:0;color:var(--teal-text);font-size:24px;transition:transform var(--hover)}
  a.project-result:focus-visible .result-arrow,a.project-result:active .result-arrow{transform:translateX(3px)}
  @media (hover: hover) and (pointer: fine) { a.project-result:hover .result-arrow {transform:translateX(3px)} }
  .result-date{display:block;margin-top:4px;color:var(--ink-3);font-size:var(--fs-small)}
  .gallery-contact{display:flex;flex-direction:column;align-items:start;justify-content:center;min-height:320px;padding:36px;background:var(--card);border-radius:var(--radius-card);box-shadow:var(--shadow-card)}
  /* Нечётное число карточек после крупной: приглашение остаётся без пары — растягиваем на ряд, без пустой половины */
  .gallery-contact:nth-child(even){grid-column:1/-1;min-height:0}
  .gallery-contact>p{font-size:var(--fs-ui);color:var(--ink-2);margin-bottom:16px}
  .gallery-contact h2{font-size:var(--fs-h2);line-height:1.15;letter-spacing:var(--tracking-tight);margin:0 0 12px}
  .gallery-contact a{gap:28px}
  /* Пояснение сразу под заголовком, кнопка — последней: сначала зачем, потом действие */
  .gallery-contact>.contact-note{font-size:var(--fs-body);color:var(--ink-2);line-height:1.5;margin:0 0 28px;max-width:30ch}
  .project-viewer{width:min(1440px,calc(100% - 40px));max-width:none;height:calc(100svh - 40px);max-height:calc(100svh - 40px);padding:0;border:0;border-radius:var(--radius-card);background:var(--card);color:var(--ink);box-shadow:var(--shadow-pop)}
  /* Окно постоянной высоты во весь экран: при смене «Компьютер / Телефон» и экранов не прыгает, серое поле снимка занимает остаток */
  .project-viewer[open]{display:flex;flex-direction:column}
  .project-viewer[open]>*{flex-shrink:0}
  .project-viewer[open]>.viewer-image{flex-grow:1}
  /* Снимок не загрузился — всё поле отдаём сообщению, оно встаёт по центру; пустая область снимка не растёт под ним */
  .project-viewer[open]>.viewer-error:not([hidden]){flex-grow:1}
  .project-viewer[open]>.viewer-image:has(img[hidden]){flex-grow:0}
  .project-viewer::backdrop{background:var(--viewer-backdrop)}
  /* Окно и затемнение проявляются за 0.2 с, без сдвига и масштаба: модальное окно стоит по центру */
  .project-viewer[open],.project-viewer[open]::backdrop{animation:ui-fade-in var(--fade-in)}
  :global(html:has(.project-viewer[open])){overflow:hidden}
  .viewer-toolbar{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;background:var(--card);border-bottom:1px solid var(--hair)}
  .viewer-toolbar h2{font-size:20px;line-height:1.2;min-width:0;overflow-wrap:anywhere}
  .viewer-toolbar button{display:inline-flex;align-items:center;gap:16px;min-height:44px;padding:0 12px;font:inherit;font-size:var(--fs-ui);cursor:pointer;background:var(--well);color:var(--ink);border:0;border-radius:var(--radius-sm);flex-shrink:0}
  .viewer-toolbar button span{font-size:24px}
  .viewer-image{overflow:auto}
  .viewer-image img{display:block;width:100%;max-width:var(--screen-width,100%);height:auto;margin-inline:auto}
  .viewer-image[data-scale='actual'] img{width:var(--screen-width);max-width:none}
  .viewer-image img[hidden]{display:none}
  .viewer-image[aria-busy='true'] img{visibility:hidden}
  /* Снимок проявляется после загрузки и при смене «Компьютер / Телефон» — тем же движением, что само окно, без рывка */
  .viewer-image[aria-busy='false'] img{animation:ui-fade-in var(--fade-in)}
  .viewer-image:focus-visible{outline-offset:-3px}
  .viewer-controls{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding:12px 20px;border-bottom:1px solid var(--hair)}
  .viewer-devices,.viewer-screens,.viewer-zoom{display:flex;flex-wrap:wrap;gap:4px}
  .viewer-devices[hidden],.viewer-screens[hidden],.viewer-zoom[hidden]{display:none}
  .viewer-controls :global(button),.viewer-paging button,.viewer-error button{font:inherit;font-size:var(--fs-ui);min-height:44px;padding:8px 14px;border:0;border-radius:var(--radius-sm);background:var(--well);color:var(--ink);cursor:pointer}
  .viewer-controls :global(button[aria-pressed='true']){background:var(--teal-btn);color:var(--on-teal)}
  /* На сером поле ошибки кнопка — белая плитка, иначе сливается с фоном */
  .viewer-error button{background:var(--card)}
  .viewer-controls button[hidden],.viewer-paging[hidden],.viewer-error[hidden]{display:none}
  .viewer-inquiry{display:inline-flex;align-items:center;min-height:44px;margin-left:auto;font-size:var(--fs-ui);font-weight:600;text-underline-offset:4px}
  /* Переключателей нет (один вид, снимок помещается) — ссылка не висит одна у правого края пустой полосы, а встаёт в начало, под название */
  .viewer-controls:not(:has(>[role='group']:not([hidden]))) .viewer-inquiry{margin-left:0}
  .viewer-status{font-size:var(--fs-small);min-height:36px;padding:8px 20px;color:var(--ink-2)}
  /* Ошибка загрузки — на месте снимка: площадка с сообщением по центру, окно не схлопывается в полосу */
  .viewer-error{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;min-height:min(50svh,360px);padding:24px 20px;background:var(--well);color:var(--ink);font-size:var(--fs-body);text-align:center}
  /* Снимка нет — пустая область под ним не держит отступы и серый фон телефона */
  .viewer-image:has(img[hidden]){padding:0}
  .viewer-paging{display:flex;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--hair)}
  .viewer-paging button:disabled{color:var(--ink-3);cursor:default}
  /* Кнопки просмотра: смена цвета 0.2 с и короткий отклик на нажатие */
  .viewer-toolbar button,.viewer-controls :global(button),.viewer-paging button,.viewer-error button{transition:background-color var(--hover),color var(--hover),transform var(--press)}
  /* Наведение мышью: серая кнопка темнеет до линии разделителя, выбранная — до тёмного бирюзового, как на лендинге inSales */
  @media (hover: hover) and (pointer: fine) {
    .viewer-toolbar button:hover,.viewer-controls :global(button:hover:not([aria-pressed='true'])),.viewer-paging button:hover:not(:disabled),.viewer-error button:hover{background:var(--hair)}
    .viewer-controls :global(button[aria-pressed='true']:hover){background:var(--teal-btn-hover)}
  }
