---
import Base from '../../layouts/Base.astro';
import Wheel from '../../components/Wheel.astro';
import Contact from '../../components/Contact.astro';
import Feedback from '../../components/Feedback.astro';
import Footer from '../../components/Footer.astro';
import { SECTORS } from '../../data/site';
import { PROJECTS } from '../../data/projects';
import { SERVICE_ROWS } from '../../data/services-list';
import { href } from '../../lib/urls';
const clients = ['alohagaia', 'wizzu', 'duman', 'geekboards'].map(id => PROJECTS.find(p => p.id === id)!);
const selected = [PROJECTS.find(p => p.id === 'alohagaia')!, PROJECTS.find(p => p.id === 'wizzu')!];
---
<Base title="Эмилиус Эдженси — экспериментальная главная" description="Помогаем великолепным людям создавать великолепные продукты. Касдев, дизайн, разработка и маркетинг — в одном цикле." noindex customNav bodyClass="taste-home">
  <header class="masthead">
    <nav class="product-nav" aria-label="Основная навигация">
      <a class="wordmark" href={href()} aria-label="Эмилиус Эдженси — текущая главная">
        <span>Эмилиус</span><img src={href('brand/logo-81.png')} width="54" height="81" alt="" /><span>Эдженси</span>
      </a>
      <div class="nav-links"><a href="#t-wheel">Метод</a><a href="#services">Услуги</a><a href="#projects">Проекты</a></div>
      <a class="action nav-action" href="#feedback">Обсудить проект</a>
      <details class="taste-menu">
        <summary aria-label="Меню">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="menu-icon" d="M4 7h16M4 12h16M4 17h16" />
            <path class="close-icon" d="m6 6 12 12M18 6 6 18" />
          </svg>
        </summary>
        <div class="menu-links"><a href="#t-wheel">Метод</a><a href="#services">Услуги</a><a href="#projects">Проекты</a><a href="#feedback">Обсудить проект</a><a href={href()}>Текущая главная</a></div>
      </details>
    </nav>
  </header>
  <main class="product-home" id="content" tabindex="-1">
    <section class="opening" aria-labelledby="mission-title">
      <p class="disciplines">Дизайн · Разработка · Маркетинг</p>
      <h1 id="mission-title">Помогаем великолепным людям<span> создавать великолепные продукты.</span></h1>
      <div class="opening-actions"><a class="action" href="#feedback">Обсудить проект <span aria-hidden="true">→</span></a><a class="text-action" href="#projects">Смотреть проекты</a></div>
    </section>
    <section class="product-demo" aria-labelledby="t-wheel" data-hide-write-button>
      <div class="demo-top"><h2 id="t-wheel" tabindex="-1">Делаем по кругу</h2><span>52 дня · 4 этапа</span></div>
      <div class="demo-body">
        <div class="wheel-area"><Wheel /></div>
        <noscript>
          <p class="wheel-fallback">Для запуска колеса нужен JavaScript. О каждом этапе можно прочитать по ссылкам.</p>
        </noscript>
        <div class="method">
          <h3>Одна команда. <span>Весь цикл продукта.</span></h3>
          <ol class="stages" role="list">
            {SECTORS.map(stage => (
              <li>
                <a href={href(`services/${stage.id}/`)} aria-label={`${stage.name}, дни ${stage.from}–${stage.to}`}>
                  <span class="day-range">{String(stage.from).padStart(2, '0')}–{stage.to}</span>
                  <span class="stage-name">{stage.name}</span>
                  <span class="row-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <p class="demo-note">
        <span class="demo-caption">Модель итерации — от вопроса до следующего шага.</span>
        <span class="demo-gesture">Поверните колесо мышью или пальцем, чтобы перейти к другому дню.</span>
      </p>
    </section>
    <ul class="client-strip" aria-label="Некоторые из наших проектов" role="list">
      {clients.map(project => (
        <li>
          <a href={href(`projects/#${project.id}`)}>
            <img class:list={{ mono: project.logoMono }} src={href(project.logo)} alt="" width="150" height="40" />
            <span>{project.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <section class="service-section" id="services" tabindex="-1" aria-labelledby="t-services">
      <div class="section-heading"><h2 id="t-services">От задачи к решению.</h2><a class="text-action" href={href('services/')}>Все услуги <span aria-hidden="true">→</span></a></div>
      {SERVICE_ROWS.map(service => (
        <a
          class="service-feature"
          href={href(service.href)}
          aria-labelledby={`offer-${service.id}`}
          aria-describedby={`offer-terms-${service.id}`}
        >
          <div>
            <p class="section-label">Готовое решение</p>
            <h3 id={`offer-${service.id}`}>{service.title}</h3>
            <p>Запустим магазин на вашем домене. Добавим товары, настроим оплату и доставку, проверим тестовый заказ.</p>
          </div>
          <div class="service-next">
            <span id={`offer-terms-${service.id}`}>{service.note}</span>
            <span class="service-link">Посмотреть услугу <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
      <div class="direction-links">{SECTORS.map(s => <a href={href(`services/${s.id}/`)}><strong>{s.name}</strong><span>{s.text}</span><span class="row-arrow" aria-hidden="true">→</span></a>)}</div>
    </section>
    <section class="project-section" id="projects" tabindex="-1" aria-labelledby="t-projects">
      <div class="section-heading"><h2 id="t-projects">Продукты, которые работают.</h2><a class="text-action" href={href('projects/')}>Все проекты <span aria-hidden="true">→</span></a></div>
      <div class="project-grid">
        {selected.map(project => (
          <article class="selected-project">
            <a class="project-image" href={href(`projects/#${project.id}`)} aria-label={`Смотреть проект ${project.name}`}>
              <img
                src={href(`cases/gallery/${project.id}-800.webp`)}
                srcset={`${href(`cases/gallery/${project.id}-800.webp`)} 800w, ${href(`cases/gallery/${project.id}-1600.webp`)} 1600w`}
                sizes="(max-width: 400px) calc(100vw - 24px), (max-width: 760px) calc(100vw - 40px), (max-width: 1238px) calc((100vw - 76px) / 2), 581px"
                width="800"
                height="500"
                loading="lazy"
                alt={`Главная страница магазина ${project.name}`}
              />
              <span class="view-project">Смотреть проект <span aria-hidden="true">→</span></span>
            </a>
            <div class="project-description">
              <h3>{project.name}</h3>
              {project.id === 'wizzu' ? (
                <p><strong class="project-result">С 0 до 2 000+ заказов в месяц.</strong> Сайт-витрина и интеграции для сервиса доставки.</p>
              ) : (
                <p>Фронтенд, интеграции с InSales и собственные модули для ювелирного бренда.</p>
              )}
              <a class="project-inquiry text-action" href={`?project=${project.id}#feedback`} aria-label={`Хочу похожий магазин — ${project.name}`}>
                Хочу похожий магазин <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="contact-section" aria-labelledby="t-next">
      <div class="section-heading">
        <div>
          <p class="section-label">Следующий шаг</p>
          <h2 id="t-next">Что создадим вместе?</h2>
        </div>
      </div>
      <div class="contact-layout"><Contact /><Feedback /></div>
    </section>
  </main>
  <div class="product-footer">
    <p class="experiment-note">
      <span>Экспериментальная главная</span>
      <a href={href()}>Текущая главная <span aria-hidden="true">→</span></a>
    </p>
    <Footer localHomeLinks />
  </div>
</Base>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.taste-menu');
  if (menu) {
    const summary = menu.querySelector('summary')!;
    const close = () => { menu.open = false; };
    menu.addEventListener('keydown', event => { if (event.key === 'Escape' && menu.open) { event.preventDefault(); close(); summary.focus(); } });
    for (const link of menu.querySelectorAll('a')) link.addEventListener('click', close);
    document.addEventListener('pointerdown', event => { if (menu.open && event.target instanceof Node && !menu.contains(event.target)) close(); });
    document.addEventListener('focusin', event => { if (menu.open && event.target instanceof Node && !menu.closest('nav')!.contains(event.target)) close(); });
    const mobileLayout = matchMedia('(max-width: 760px)');
    mobileLayout.addEventListener('change', ({ matches }) => {
      if (matches) return;
      const focusWasInMenu = menu.contains(document.activeElement);
      close();
      if (focusWasInMenu) document.querySelector<HTMLAnchorElement>('.product-nav .wordmark')?.focus();
    });
  }
</script>
<style>
  :global(body.taste-home){padding:0 24px 88px;gap:0;background:var(--page)}
  :global(body.taste-home::before){display:none}
  .masthead{border-bottom:1px solid var(--hair)}
  .product-nav,.product-home,.product-footer{width:100%;max-width:var(--taste-width);margin-inline:auto}
  .product-nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;z-index:12}
  a{text-decoration:none;color:var(--ink)}
  a:hover{color:var(--teal-text)}
  .wordmark{display:inline-flex;align-items:center;gap:8px;font-size:21px;font-weight:700;white-space:nowrap;min-height:44px}
  .wordmark img{width:18px;height:27px;object-fit:contain}
  .nav-links{display:flex;gap:28px;font-size:15px}
  .nav-links a{display:flex;align-items:center;min-height:44px}
  .action{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:50px;padding:12px 24px;border-radius:var(--radius-btn);background:var(--teal-btn);color:var(--on-teal);font-weight:600;transition:background-color var(--hover)}
  .action:hover{background:var(--teal-btn-hover);color:var(--on-teal)}
  .nav-action{font-size:14px;min-height:44px;padding:10px 20px}
  .taste-menu{display:none}
  .opening{padding:44px 0 26px}
  .disciplines{font-size:15px;color:var(--ink-2);margin-bottom:18px}
  h1{font-size:clamp(36px,4.1vw,60px);line-height:1.1;font-weight:600;letter-spacing:-.035em;text-wrap:pretty}
  h1 span{display:block;color:var(--ink-2)}
  .opening-actions{display:flex;align-items:center;gap:32px;margin-top:26px}
  .text-action{display:inline-flex;align-items:center;gap:12px;font-size:15px;font-weight:600;min-height:44px}
  .text-action:hover{text-decoration:underline;text-underline-offset:5px}
  .product-demo{border:1px solid var(--hair);border-radius:var(--radius-card);background:var(--card);padding:0 28px}
  .demo-top{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:62px;border-bottom:1px solid var(--hair)}
  .demo-top h2{font-size:20px;scroll-margin-block-start:44px}
  .demo-top>span{font-size:14px;color:var(--ink-2)}
  .demo-body{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:42px;align-items:center}
  .wheel-fallback { padding-block: 20px; color: var(--ink-2); }
  @media (scripting: none) { .wheel-area { display: none; } }
  .wheel-area{min-width:0;padding:0 14px 44px;position:relative}
  .wheel-area :global(.wheel-stage){--wb:min(100%,460px)}
  .wheel-area :global(.wheel-info){position:absolute;left:0;right:0;bottom:2px;margin:0;min-height:40px;font-size:13px}
  .wheel-area :global(.wheel-launch){border-color:var(--taste-clear);box-shadow:var(--taste-shadow)}
  .wheel-area :global(.launch-text){font-size:22px;font-weight:600}
  .wheel-area :global(.launch-cta){height:44px;border-width:1px;border-color:var(--ink-3);color:var(--ink);font-size:15px}
  .wheel-area :global(.wheel-launch:hover .launch-cta),.wheel-area :global(.wheel-launch:focus-visible .launch-cta){color:var(--on-teal);border-color:var(--teal-btn)}
  .method{padding-right:20px}
  .method h3{font-size:30px;line-height:1.15;font-weight:600;letter-spacing:-.025em;margin:0 0 26px}
  .method h3 span{display:block}
  .stages{list-style:none;padding:0;margin:0}
  .stages a{display:grid;grid-template-columns:78px 1fr 20px;align-items:center;gap:12px;min-height:60px;border-bottom:1px solid var(--hair)}
  .stages li:last-child a{border:0}
  .day-range{font-size:14px;font-variant-numeric:tabular-nums;color:var(--ink-3)}
  .stage-name{font-size:18px;text-transform:capitalize}
  .row-arrow{color:var(--teal-text)}
  .stages a:hover .stage-name,
  .stages a:focus-visible .stage-name {
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  :global(.product-demo:has(.wheel-stage:not(.is-idle) .sector-label[data-sector="0"]:is(.has-active .is-active, .wheel-box:not(.has-active) .is-now))) .stages li:nth-child(1) .stage-name,
  :global(.product-demo:has(.wheel-stage:not(.is-idle) .sector-label[data-sector="1"]:is(.has-active .is-active, .wheel-box:not(.has-active) .is-now))) .stages li:nth-child(2) .stage-name,
  :global(.product-demo:has(.wheel-stage:not(.is-idle) .sector-label[data-sector="2"]:is(.has-active .is-active, .wheel-box:not(.has-active) .is-now))) .stages li:nth-child(3) .stage-name,
  :global(.product-demo:has(.wheel-stage:not(.is-idle) .sector-label[data-sector="3"]:is(.has-active .is-active, .wheel-box:not(.has-active) .is-now))) .stages li:nth-child(4) .stage-name {
    color: var(--teal-text);
    font-weight: 700;
  }
  .demo-note{border-top:1px solid var(--hair);padding:16px 0;font-size:13px;color:var(--ink-3)}
  .demo-gesture { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.taste-home .product-demo:has(.wheel-stage:not(.is-idle))) .demo-caption { display: none; }
    :global(.taste-home .product-demo:has(.wheel-stage:not(.is-idle))) .demo-gesture { display: inline; }
  }
  .client-strip{list-style:none;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;gap:40px;padding:28px 90px 36px}
  .client-strip a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink-2);
    font-size: 13px;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .client-strip a:hover span,
  .client-strip a:focus-visible span {
    color: var(--teal-text);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .client-strip img{object-fit:contain;width:150px;max-width:100%;height:36px;filter:grayscale(1);opacity:.65}
  .client-strip a:hover img{opacity:1}
  .service-section,.project-section,.contact-section{border-top:1px solid var(--hair);padding:44px 0 48px;scroll-margin-top:24px}
  .section-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:28px}
  .section-heading h2{font-size:36px;line-height:1.15;letter-spacing:-.025em;text-wrap:pretty}
  .section-label{font-size:13px;color:var(--ink-3);margin-bottom:12px}
  .service-feature{display:flex;justify-content:space-between;gap:40px;background:var(--card);border-radius:var(--radius-card);padding:30px 32px;box-shadow:var(--shadow-card)}
  .service-feature h3{font-size:27px;line-height:1.2;font-weight:600;letter-spacing:-.02em;margin:0 0 12px}
  .service-feature p:not(.section-label){font-size:16px;color:var(--ink-2);max-width:54ch}
  .service-next{display:flex;flex-direction:column;justify-content:center;gap:16px;flex-shrink:0;font-size:14px;color:var(--ink-2)}
  .service-link{color:var(--teal-text);font-size:16px;font-weight:600}
  .service-feature:hover .service-link,
  .service-feature:focus-visible .service-link{text-decoration:underline;text-underline-offset:5px}
  .direction-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;margin-top:28px}
  .direction-links a{display:grid;grid-template-columns:1fr auto;gap:8px;align-content:start;padding:12px 0;min-width:0}
  .direction-links strong{font-size:18px;font-weight:600;text-transform:capitalize}
  .direction-links a>span:not(.row-arrow){font-size:14px;line-height:1.5;color:var(--ink-2);grid-column:1;grid-row:2}
  .direction-links .row-arrow{grid-column:2;grid-row:1}
  .project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
  .project-image{position:relative;display:block;border-radius:var(--radius-card);overflow:hidden;background:var(--card)}
  .project-image img{display:block;width:100%;height:auto;aspect-ratio:8/5;object-fit:cover}
  .view-project{position:absolute;right:14px;bottom:14px;display:inline-flex;gap:16px;background:var(--card);color:var(--ink);padding:10px 14px;font-size:13px;border-radius:var(--radius-sm);box-shadow:var(--shadow-card)}
  .project-image:hover .view-project{color:var(--teal-text)}
  .project-description{padding:18px 2px 0}
  .project-result { color: var(--ink); font-weight: 700; }
  .project-inquiry { margin-top: 8px; color: var(--teal-text); }
  .project-description h3{font-size:22px;font-weight:600;margin:0 0 8px}
  .project-description p{font-size:15px;line-height:1.5;color:var(--ink-2);max-width:52ch}
  .contact-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:28px;align-items:stretch}
  .contact-layout :global(.feedback){grid-column:auto;width:100%;max-width:none;margin:0;padding:28px}
  .contact-layout :global(.stack) {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-layout :global(.col-card){padding:24px}
  .contact-layout :global(.card-title){font-size:20px}
  .product-footer{padding-top:12px}
  .experiment-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .experiment-note a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--teal-text);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .product-footer :global(.footer-links){max-width:none;margin-top:20px}
  @media(prefers-color-scheme:dark){:global(:root:not([data-theme='light'])) .client-strip img.mono{filter:grayscale(1) invert(1)}}
  :global(:root[data-theme='dark']) .client-strip img.mono{filter:grayscale(1) invert(1)}
  /* WebKit при почти нулевой длительности задерживает наследуемый цвет вне экрана. */
  @media(prefers-reduced-motion:reduce){
    :global(*),:global(*::before),:global(*::after){transition:none !important}
  }
  @media(max-width:1000px){
    .product-nav { gap: 16px; }
    .nav-links { gap: 20px; }
    h1{font-size:clamp(36px,4.3vw,48px)}
    .demo-body{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:20px}
    .method h3{font-size:26px}.method{padding-right:0}
    .client-strip{padding-inline:32px;gap:28px}
    .direction-links{grid-template-columns:repeat(2,minmax(0,1fr))}
    .service-feature{gap:24px}.service-next{flex-shrink:1;min-width:200px}
  }
  @media(max-width:760px){
    :global(body.taste-home){padding-inline:20px}
    .product-nav{height:68px;gap:16px}.wordmark{font-size:18px;gap:6px}.wordmark img{width:16px;height:24px}
    .nav-links,.nav-action{display:none}
    .taste-menu{display:block}.taste-menu summary{display:flex;align-items:center;justify-content:center;width:44px;height:44px;list-style:none;cursor:pointer;border-radius:var(--radius-btn);color:var(--ink)}
    .taste-menu summary::-webkit-details-marker{display:none}.taste-menu svg{width:24px;height:24px;stroke:currentColor;stroke-width:1.5;fill:none}
    .close-icon, .taste-menu[open] .menu-icon { display: none; }
    .taste-menu[open] .close-icon { display: initial; }
    .menu-links {
      position: absolute;
      top: calc(100% + 8px);
      inset-inline: 0;
      display: grid;
      max-height: calc(100dvh - 88px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 12px 20px;
      background: var(--card);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-pop);
    }
    :global(body.taste-home:has(.taste-menu[open]) .write-fab) { visibility: hidden; }
    .menu-links a{min-height:48px;display:flex;align-items:center;border-bottom:1px solid var(--hair)}.menu-links a:last-child{border:0}
    .opening{padding:36px 0 28px}.disciplines{font-size:13px;margin-bottom:16px}
    h1{font-size:clamp(32px,5.4vw,42px);line-height:1.1;letter-spacing:-.025em}h1 span{display:inline}
    .opening-actions{gap:20px;margin-top:24px;flex-wrap:wrap}.opening-actions .action{min-height:48px;font-size:15px;padding-inline:18px}.opening-actions .text-action{font-size:14px}
    .product-demo{padding:0 18px}.demo-top{min-height:60px}.demo-top h2{font-size:18px}.demo-top>span{font-size:12px}
    .demo-body{grid-template-columns:minmax(0,1fr);gap:0}
    .wheel-area{padding-inline:14px;margin-inline:-18px}
    .method{padding:20px 0 16px;border-top:1px solid var(--hair)}.method h3{font-size:25px;margin-bottom:16px}.method h3 span{display:inline}
