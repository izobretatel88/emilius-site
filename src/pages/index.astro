---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Wheel from '../components/Wheel.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { MISSION_LINES } from '../data/site';
---

<Base
  title="Эмилиус Эдженси – дизайн и реализация продуктов"
  description="Знаем, как надо! Дизайн, разработка, интернет-маркетинг для создания вдохновляющего опыта 💎"
>
  <header class="hero">
    <Logo />
    <div class="mission">
      <p class="eyebrow">Наша миссия</p>
      <h1><span class="line">{MISSION_LINES[0]}</span> <span class="line">{MISSION_LINES[1]}</span></h1>
    </div>
  </header>

  <main class="bento">
    <Projects />
    <section class="card wheel-card" aria-labelledby="t-wheel">
      <h2 class="card-title" id="t-wheel">Делаем по кругу</h2>
      <Wheel />
    </section>
    <Contact />
  </main>

  <Footer />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .mission {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mission h1 {
    font-size: clamp(22px, 3.4vw, 38px);
    line-height: 1.15;
    margin-inline: auto;
  }
  /* Две строки на широком экране; на узком строки переносятся сами */
  .mission h1 .line {
    display: block;
  }
  @media (max-width: 640px) {
    .mission h1 {
      max-width: 22ch;
      text-wrap: balance;
    }
    .mission h1 .line {
      display: inline;
    }
  }

  .bento {
    display: grid;
    grid-template-columns: var(--col-side) minmax(0, var(--col-center)) var(--col-side);
    justify-content: center;
    align-items: start;
    gap: var(--col-gap);
  }
  .wheel-card {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 1040px) {
    .bento {
      grid-template-columns: 150px minmax(0, 1fr) 190px;
      gap: 18px;
    }
  }
  @media (max-width: 860px) {
    .bento {
      grid-template-columns: minmax(96px, 1fr) minmax(0, 2fr);
    }
    .wheel-card {
      grid-column: 1 / -1;
      order: -1;
    }
  }
</style>
