---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Wheel from '../components/Wheel.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Feedback from '../components/Feedback.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { MISSION_LINES } from '../data/site';

// Миссия: на компьютере перенос после «создавать», на телефоне — после «людям»,
// чтобы шрифт был крупнее (самая длинная строка короче)
const [head, verb] = [MISSION_LINES[0].replace(/\s+\S+$/, ''), MISSION_LINES[0].split(' ').at(-1)];
---

<Base
  title="Эмилиус Эдженси – дизайн и реализация продуктов"
  description="Знаем, как надо! Дизайн, разработка, интернет-маркетинг для создания вдохновляющего опыта 💎"
>
  <Intro />
  <header class="hero">
    <Logo />
    <div class="mission">
      <p class="eyebrow">Наша миссия</p>
      <h1><span class="m-a">{head}</span> <span class="m-b">{verb}</span> <span class="m-c">{MISSION_LINES[1]}</span></h1>
    </div>
  </header>

  <main class="bento">
    <Projects />
    <section class="card wheel-card" aria-labelledby="t-wheel">
      <h2 class="card-title" id="t-wheel">Делаем по кругу</h2>
      <Wheel />
    </section>
    <!-- Услуги — под колесом продукта: центральная колонка на компьютере, следом за колесом на телефоне -->
    <div class="services-slot"><Services /></div>
    <Contact />
    <Feedback />
  </main>

  <Footer />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    margin-bottom: 12px;
  }
  .mission {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* Eyebrow — тихая подпись, главное — сама миссия (правки владельца 22.10.2026) */
  .eyebrow {
    color: var(--teal-text);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mission h1 {
    font-size: clamp(26px, 4.2vw, 48px);
    font-weight: 600;
    line-height: 1.12;
    margin-inline: auto;
  }
  /* Всегда две строки. Компьютер: перенос после «создавать».
     Телефон: после «людям» — строки короче, шрифт крупнее; ширина строки не выходит за экран. */
  .mission h1 .m-c {
    display: block;
  }
  @media (max-width: 640px) {
    .eyebrow {
      font-size: 12px;
    }
    .mission h1 {
      font-size: clamp(15px, 5.4vw, 30px);
    }
    .mission h1 .m-a {
      display: block;
      white-space: nowrap;
    }
    .mission h1 .m-c {
      display: inline;
    }
    .mission h1 .m-b,
    .mission h1 .m-c {
      white-space: nowrap;
    }
  }

  .bento {
    display: grid;
    grid-template-columns: var(--col-side) minmax(0, var(--col-center)) var(--col-side);
    justify-content: center;
    align-items: start;
    gap: var(--col-gap);
  }
  /* Компьютер: «Проекты» слева и «Связь» + «Эми» справа — ровно на высоту колеса, низ трёх карточек
     на одной линии (дизайн-система §5.1). Услуги — под колесом, боковые колонки их не ждут. */
  .services-slot {
    grid-column: 2;
    grid-row: 2;
  }
  .wheel-card {
    grid-column: 2;
    grid-row: 1;
  }
  .bento > :global(.projects-card) {
    grid-column: 1;
    grid-row: 1;
    align-self: stretch;
  }
  .bento > :global(.stack) {
    grid-column: 3;
    grid-row: 1;
    align-self: stretch;
  }
  .wheel-card {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 1040px) {
    .bento {
      grid-template-columns: 150px minmax(0, 1fr) 190px;
      gap: 24px;
    }
  }
  /* Телефон и планшет: колесо, под ним «Проекты» во всю ширину,
     «Связь» и «Спросить Эми» — двумя блоками рядом одной высоты (правки владельца 22.10.2026) */
  @media (max-width: 860px) {
    .bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 20px;
    }
    .wheel-card,
    .services-slot,
    .bento > :global(.projects-card),
    .bento > :global(.stack) {
      grid-row: auto;
    }
    .wheel-card {
      grid-column: 1 / -1;
      order: -1;
    }
    .bento > :global(.projects-card) {
      grid-column: 1 / -1;
    }
    .services-slot {
      grid-column: 1 / -1;
      order: -1;
    }
  }
</style>
