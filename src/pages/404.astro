---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { LINKS } from '../data/site';

const home = import.meta.env.BASE_URL;
---

<Base title="Страница не найдена — Эмилиус Эдженси" description="Такой страницы нет. Вернитесь на главную или напишите нам в Telegram.">
  <header class="top">
    <a href={home} class="logo-link" aria-label="Эмилиус Эдженси — на главную"><Logo /></a>
  </header>

  <main class="card lost">
    <p class="eyebrow">Ошибка 404</p>
    <h1>Этой страницы нет в&nbsp;нашем цикле</h1>
    <p class="text">Возможно, ссылка устарела или страница ещё в&nbsp;разработке. Вернитесь к&nbsp;колесу — там всё по&nbsp;порядку.</p>
    <div class="actions">
      <a class="btn btn-primary" href={home}>На главную</a>
      <a class="btn btn-secondary" href={LINKS.direct} target="_blank" rel="noopener">Написать в Telegram</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .top {
    display: flex;
    justify-content: center;
  }
  .logo-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }
  .lost {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: 36px 28px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.15;
  }
  .text {
    color: var(--ink-2);
    max-width: 40ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
  .btn {
    min-height: 54px;
    border-radius: var(--radius-btn);
    display: inline-flex;
    align-items: center;
    padding-inline: 22px;
    font-weight: 600;
    font-size: 17px;
    text-decoration: none;
    transition: background-color var(--hover), color var(--hover);
  }
  .btn-primary {
    background: var(--teal);
    color: #fff;
  }
  .btn-primary:hover {
    color: var(--on-teal);
  }
  .btn-secondary {
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--teal);
  }
  .btn-secondary:hover {
    background: var(--teal);
    color: #fff;
  }
</style>
