---
// 404 на общем каркасе (04.11.2026): первый экран слева, как на остальных страницах,
// ниже — прямой путь к основным разделам после устаревшей или неполной ссылки.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import LinkList from '../components/LinkList.astro';
import { LINKS } from '../data/site';
import { SERVICE_ROWS } from '../data/services-list';
import { href } from '../lib/urls';

const paths = [
  ...SERVICE_ROWS.map((r) => ({ title: r.title, description: r.note, href: r.href })),
  { title: 'Все услуги', description: 'Касдев, дизайн, разработка и маркетинг', href: 'services/' },
  { title: 'Проекты', description: 'Примеры работы команды', href: 'projects/' },
  { title: 'Полезное', description: 'Сравнения платформ и калькулятор', href: 'resources/' },
];
---

<Base title="Страница не найдена — Эмилиус Эдженси" description="Такой страницы нет. Вернитесь на главную или напишите нам в Telegram.">
  <main class="lost ui-shell">
    <header class="ui-opening">
      <p class="ui-eyebrow">Ошибка 404</p>
      <h1 class="ui-h1">Страница не найдена</h1>
      <p class="ui-lead">Проверьте адрес или выберите нужный раздел ниже. Можно вернуться на главную или написать нам.</p>
      <div class="ui-actions">
        <a class="ui-button" href={href()}>На главную</a>
        <a class="ui-link" href={LINKS.direct} target="_blank" rel="noopener">Написать в Telegram <span class="ui-arrow" aria-hidden="true">↗</span></a>
      </div>
    </header>
    <nav class="ui-section" aria-labelledby="t-paths">
      <div class="ui-section-head"><h2 id="t-paths">Или сразу туда, куда шли</h2></div>
      <div class="paths ui-surface"><LinkList items={paths} /></div>
    </nav>
  </main>

  <Footer />
</Base>

<style>
  .lost .ui-opening { padding-top: 16px; }
  .paths { padding: 0 26px; }
  @media (max-width: 600px) {
    .paths { padding-inline: 18px; }
  }
</style>
