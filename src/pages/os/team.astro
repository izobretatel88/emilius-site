---
// Эксперимент /os/: команда как накопленный опыт. Профили — демо: роли без имён, цифры условные.
// Публичные профили с именами — после согласия сотрудников (docs/concept/emilius-os-v0.1.md).
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import OsNav from '../../components/os/OsNav.astro';
import Footer from '../../components/Footer.astro';
import { TEAM, activity, recentTasks, fmt } from '../../data/os';
import '../../styles/os.css';

const total = TEAM.reduce((a, p) => ({ hours: a.hours + p.hours, tasks: a.tasks + p.tasks }), { hours: 0, tasks: 0 });
---

<Base title="Команда — опыт Эмилиус Эдженси" description="Команда как накопленный опыт: полезные часы, направления, задачи." noindex>
  <header class="os-top">
    <Logo />
    <OsNav current="team" />
  </header>

  <main class="os">
    <section class="hero" aria-labelledby="h-team">
      <p class="eyebrow">Команда</p>
      <h1 id="h-team">Опыт, который можно посчитать.</h1>
      <p class="lead">Не «три года в профессии», а полезные часы, принятые задачи и направления — по учёту работы.</p>
      <p class="demo-line"><span class="demo">демо</span> Роли без имён, цифры условные: публичные профили — после согласия сотрудников.</p>
      <dl class="sum">
        <div><dt>специалиста</dt><dd>{TEAM.length}</dd></div>
        <div><dt>полезных часов</dt><dd>{fmt(total.hours)}</dd></div>
        <div><dt>задач</dt><dd>{fmt(total.tasks)}</dd></div>
      </dl>
    </section>

    {TEAM.map((p) => (
      <section class="card profile" id={p.id} aria-labelledby={`h-${p.id}`}>
        <div class="p-head">
          <div class="avatar" aria-hidden="true">{p.role[0]}</div>
          <div>
            <h2 id={`h-${p.id}`}>{p.role}</h2>
            <p class="since">в команде с {p.since}</p>
          </div>
        </div>

        <div class="p-grid">
          <div class="exp">
            <p class="big"><b>{fmt(p.hours)}</b> полезных часов</p>
            <p class="sub">{p.tasks} задач · {p.projects} проектов</p>
            <div class="split" role="img" aria-label={p.split.map(([n, v]) => `${n} ${v}%`).join(', ')}>
              {p.split.map(([n, v], i) => <span style={`flex:${v};--i:${i}`}></span>)}
            </div>
            <ul class="legend">
              {p.split.map(([n, v], i) => <li><i style={`--i:${i}`}></i>{n} <b>{v}%</b></li>)}
            </ul>
            <p class="stack">{p.stack.join(' · ')}</p>
          </div>

          <div class="tasks">
            <h3>Последние задачи</h3>
            <ul>
              {recentTasks(p).map((t) => (
                <li>
                  <span class="t-title">{t.title}</span>
                  <span class="t-meta">{t.module} · {t.project}</span>
                  <span class="t-h">{fmt(t.hours)} ч</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="year">
          <h3>Вклад за 52 недели</h3>
          <div class="graph" role="img" aria-label="Активность по неделям за год (демо)">
            {activity(p.seed).map((lvl) => <span data-l={lvl}></span>)}
          </div>
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal-text);
  }
  .hero h1 {
    font-size: clamp(40px, 7vw, 84px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  .demo-line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--ink-3);
  }
  .sum {
    display: flex;
    gap: clamp(24px, 6vw, 72px);
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .sum div {
    display: flex;
    flex-direction: column-reverse;
  }
  .sum dd {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    line-height: 1;
    color: var(--teal-text);
    font-variant-numeric: tabular-nums;
  }
  .sum dt {
    font-size: 15px;
    color: var(--ink-3);
    margin-top: 6px;
  }
  .profile {
    padding: clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 28px;
    scroll-margin-top: 24px;
  }
  .p-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .avatar {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--well);
    color: var(--teal-text);
    font-size: 28px;
    font-weight: 700;
  }
  .profile h2 {
    font-size: clamp(24px, 3vw, 34px);
  }
  .since {
    font-size: 14px;
    color: var(--ink-3);
  }
  .p-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(20px, 4vw, 48px);
  }
  .exp {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .big {
    font-size: 15px;
    color: var(--ink-2);
  }
  .big b {
    display: block;
    font-size: clamp(48px, 7vw, 80px);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .sub,
  .stack {
    font-size: 15px;
    color: var(--ink-3);
  }
  .split {
    display: flex;
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    gap: 2px;
    margin-top: 6px;
  }
  .split span,
  .legend i {
    background: var(--teal);
    opacity: calc(1 - var(--i) * 0.22);
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .tasks h3,
  .year h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .tasks ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tasks li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    padding: 11px 0;
    border-top: 1px solid var(--hair);
  }
  .t-title {
    font-weight: 600;
  }
  .t-meta {
    grid-row: 2;
    font-size: 13px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .t-h {
    grid-row: 1 / span 2;
    align-self: center;
    font-weight: 700;
    color: var(--teal-text);
    font-variant-numeric: tabular-nums;
  }
  .graph {
    display: grid;
    grid-template-columns: repeat(52, 1fr);
    gap: 3px;
  }
  .graph span {
    aspect-ratio: 1 / 2.4;
    border-radius: 2px;
    background: var(--teal);
    opacity: 0.1;
  }
  .graph span[data-l='1'] {
    opacity: 0.3;
  }
  .graph span[data-l='2'] {
    opacity: 0.5;
  }
  .graph span[data-l='3'] {
    opacity: 0.75;
  }
  .graph span[data-l='4'] {
    opacity: 1;
  }
  @media (max-width: 760px) {
    .p-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .graph {
      grid-template-columns: repeat(26, 1fr);
    }
    .graph span {
      aspect-ratio: 1;
    }
  }
</style>
